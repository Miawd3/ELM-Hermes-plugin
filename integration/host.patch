+"""Versioned, read-only canonical memory ownership for authenticated plugin RPC handlers.
+
+This API is available during a session-bound RPC or a core-bound read-only local turn,
+not arbitrary plugin background work. request_memory_owner requires the latter.
+The returned snapshot alone MUST NOT authorize a later write. Use the bounded publication
+fence only within an authenticated control RPC; external side effects are not rollbackable.
+"""
+
+
+def memory_owner(*, version=1, alias=None):
+    """Return validated local ownership using host-bound authority, never caller identity.
+
+    ``alias`` may select only a member of the current canonical conversation's validated
+    lineage. Other surfaces and unadopted history fail closed. Projects are not inferred.
+    """
+    import os
+    from hermes_cli.plugin_isolation import HOST_PROCESS_ENV
+    if os.environ.get(HOST_PROCESS_ENV) == '1':
+        from hermes_cli.plugin_memory_host import hosted_memory_owner
+        return hosted_memory_owner(version=version, alias=alias)
+    from gateway.session_memory_context import current_memory_owner
+    return current_memory_owner(version=version, alias=alias)
+
+
+def publish_memory(expected, publish):
+    """Invoke a bounded synchronous callback once under native SQLite writer exclusion.
+
+    Requires a current authenticated control RPC and a fresh ownership snapshot.
+    The callback must not await, delegate, call the host recursively, or perform slow
+    network operations. Its external side effects cannot be rolled back; an uncertain
+    outcome MUST NOT be retried blindly. See the experimental contract documentation.
+    """
+    import os
+    from hermes_cli.plugin_isolation import HOST_PROCESS_ENV
+    if os.environ.get(HOST_PROCESS_ENV) == '1':
+        from hermes_cli.plugin_host_wire import PluginHostUnsupported
+        raise PluginHostUnsupported('Memory publication requires in-process execution; hosted callbacks are not transported')
+    from gateway.session_memory_context import publish_current_memory
+    return publish_current_memory(expected, publish)
+
+
+def memory_capabilities():
+    """Declare only this experimental host contract, not whole-plugin compatibility."""
+    import os
+    from hermes_cli.plugin_isolation import HOST_PROCESS_ENV
+    return {'version': 1, 'local_read_rpc': True,
+            'request_recall': os.environ.get(HOST_PROCESS_ENV) != '1',
+            'local_turn_capture': os.environ.get(HOST_PROCESS_ENV) != '1',
+            'publication': os.environ.get(HOST_PROCESS_ENV) != '1',
+            'project_binding': os.environ.get(HOST_PROCESS_ENV) != '1',
+            'record_read': os.environ.get(HOST_PROCESS_ENV) != '1'}
+
+
+def bind_memory_project(expected, project_id):
+    """Explicitly select an exact native project ID, or None to unbind, with snapshot CAS.
+
+    In-process authenticated control RPC only. Requires an explicit selection flow,
+    never an inferred cwd/active-project choice. No cross-principal sharing is granted.
+    """
+    import os
+    from hermes_cli.plugin_isolation import HOST_PROCESS_ENV
+    if os.environ.get(HOST_PROCESS_ENV) == '1':
+        from hermes_cli.plugin_host_wire import PluginHostUnsupported
+        raise PluginHostUnsupported('Project binding requires in-process execution')
+    from gateway.session_memory_context import bind_current_project
+    return bind_current_project(expected, project_id)
+
+
+def read_memory(expected, read):
+    """Buffer a synchronous read under current host ownership/catalog checks.
+
+    In-process only. The callback must not mutate stores or re-enter host writer APIs.
+    Host ownership is not record consent: the plugin must enforce scope/approval itself.
+    Results are withheld if final host/context checks fail. No callback retries.
+    """
+    import os
+    from hermes_cli.plugin_isolation import HOST_PROCESS_ENV
+    if os.environ.get(HOST_PROCESS_ENV) == '1':
+        from hermes_cli.plugin_host_wire import PluginHostUnsupported
+        raise PluginHostUnsupported('Memory record read callbacks require in-process execution')
+    from gateway.session_memory_context import read_current_memory
+    return read_current_memory(expected, read)
+
+
+def request_memory_owner(*, version=1, alias=None):
+    """Read owner only during a core-bound claimed local turn, never from caller hints."""
+    import os
+    from hermes_cli.plugin_isolation import HOST_PROCESS_ENV
+    if os.environ.get(HOST_PROCESS_ENV) == '1':
+        from hermes_state_runtime import RuntimeStoreError
+        raise RuntimeStoreError('memory_context_unavailable')
+    from gateway.session_memory_turn import request_memory_owner as resolve
+    return resolve(version=version, alias=alias)
+
+
+def capture_turn_memory(expected, publish):
+    """Capture-only publication during core finalization; unavailable in RPC/background work."""
+    from gateway.session_memory_turn import capture_turn_memory as capture
+    return capture(expected, publish)
+
+
+def capture_admission_watermark():
+    """For a capture-consent write already inside authenticated control publication."""
+    from gateway.session_memory_turn import capture_admission_watermark as watermark
+    return watermark()
+
+
+def capture_turn_provenance():
+    """Core-bound finalized admission and redacted-content digests, not caller claims."""
+    from gateway.session_memory_turn import capture_turn_provenance as provenance
+    return provenance()
diff --git a/hermes_cli/plugin_memory_host.py b/hermes_cli/plugin_memory_host.py
new file mode 100644
index 00000000..bfc9298f
--- /dev/null
+++ b/hermes_cli/plugin_memory_host.py
@@ -0,0 +1,58 @@
+"""Read-only memory ownership bridge for the isolated plugin process.
+
+Only an in-flight authenticated parent RPC grants a context. Child-provided session,
+profile and principal fields are never accepted. Publication callbacks cannot cross
+this process boundary safely and are deliberately unsupported. The per-profile child
+is trusted code, not an adversarial sandbox: plugins sharing that interpreter can
+inspect one another and the wire. Origin/load checks prevent accidental stale or
+cross-plugin attribution, not malicious shared-process introspection.
+"""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import asdict
+from pathlib import Path
+
+from hermes_state_runtime import RuntimeStoreError
+
+_forwarder = None
+_call = ContextVar("host_memory_call", default=None)
+
+
+@contextmanager
+def bind_host_memory_call(host, plugin, load, generation):
+    token = _call.set((host, plugin, load, generation))
+    try:
+        yield
+    finally:
+        _call.reset(token)
+
+
+def hosted_memory_owner(*, version=1, alias=None):
+    if _forwarder is None:
+        raise RuntimeStoreError('memory_context_unavailable')
+    from gateway.session_memory_owner import MemoryOwner
+    result = _forwarder(version=version, alias=alias)
+    result['aliases'] = tuple(result['aliases'])
+    return MemoryOwner(**result)
+
+
+def serve_memory_owner(host, params, origin, generation):
+    """Parent-only resolution in the origin's inherited authenticated ContextVars."""
+    channel = host._channel
+    plugin = params.get('plugin')
+    if (_call.get() != (host, plugin, params.get('load'), generation)
+            or generation != host._generation or channel is None or channel.context_of(origin) is None
+            or plugin not in host._contexts or params.get('load') != host._loads.get(plugin)):
+        raise RuntimeStoreError('memory_context_unavailable')
+    if set(params) - {'plugin', 'load', 'version', 'alias'}:
+        raise RuntimeStoreError('invalid_params')
+    from hermes_constants import get_hermes_home
+    if Path(get_hermes_home()).resolve() != Path(host._home).resolve():
+        raise RuntimeStoreError('profile_mismatch')
+    from gateway.session_memory_context import current_memory_owner
+    result = current_memory_owner(version=params.get('version', 1), alias=params.get('alias'))
+    # Unload or completion can race the read. Never return a snapshot after that grant expires.
+    if (generation != host._generation or channel.context_of(origin) is None
+            or params.get('load') != host._loads.get(plugin) or plugin not in host._contexts):
+        raise RuntimeStoreError('memory_context_unavailable')
+    return asdict(result)
