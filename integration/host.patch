diff --git a/hermes_cli/plugin_llm_credentials.py b/hermes_cli/plugin_llm_credentials.py
new file mode 100644
index 00000000..2389833a
--- /dev/null
+++ b/hermes_cli/plugin_llm_credentials.py
@@ -0,0 +1,184 @@
+"""Dedicated recipient-bound SYNTHETIC credential qualification only.
+
+No production credential storage, environment lookup, provider pools or key copy.
+"""
+from dataclasses import asdict
+import hashlib
+import json
+import re
+import threading
+
+from hermes_cli.plugin_llm_pinned import Recipient, PinnedDispatchError, _native_owner
+from hermes_cli.plugin_llm_transport import _LoopbackTransport, _destination
+
+
+def _owner_digest(owner):
+    return hashlib.sha256(json.dumps(asdict(owner),sort_keys=True,separators=(',',':')).encode()).hexdigest()
+
+
+def _synthetic(secret):
+    if type(secret) is not str or not secret.startswith('synthetic-') or not 10<=len(secret)<=256 or any(ord(c)<33 or ord(c)>126 for c in secret):
+        raise PinnedDispatchError('synthetic_credential_required')
+    return secret
+
+
+class _SyntheticCredentialResolver:
+    """Private local-test configuration; not a public secret manager."""
+    def __init__(self):
+        self._slots={}
+        self._lock=threading.RLock()
+
+    def __repr__(self):
+        return '<synthetic credential resolver; values redacted>'
+
+    def install(self,slot_id,owner,endpoint,model,secret):
+        if type(slot_id) is not str or re.fullmatch(r'[a-zA-Z0-9_-]{1,64}',slot_id) is None or type(model) is not str or not 1<=len(model)<=128:
+            raise PinnedDispatchError('invalid_credential_route')
+        _destination(endpoint,loopback=True)
+        value=_synthetic(secret)
+        owner_hash=_owner_digest(owner)
+        with self._lock:
+            if slot_id in self._slots or len(self._slots)>=16:
+                raise PinnedDispatchError('credential_slot_conflict')
+            self._slots[slot_id]=dict(owner_sha256=owner_hash,endpoint=endpoint,model=model,version=1,active=True,secret=value)
+            return self._public(slot_id)
+
+    def rotate(self,slot_id,secret):
+        value=_synthetic(secret)
+        with self._lock:
+            slot=self._slots.get(slot_id)
+            if slot is None:
+                raise PinnedDispatchError('credential_route_unavailable')
+            slot.update(secret=value,version=slot['version']+1,active=True)
+            return self._public(slot_id)
+
+    def revoke(self,slot_id):
+        with self._lock:
+            slot=self._slots.get(slot_id)
+            if slot is None:
+                raise PinnedDispatchError('credential_route_unavailable')
+            slot.update(secret=None,version=slot['version']+1,active=False)
+
+    def _public(self,slot_id):
+        slot=self._slots[slot_id]
+        value={k:slot[k] for k in ('owner_sha256','endpoint','model','version','active')}
+        value['slot_id']=slot_id
+        value['route_sha256']=hashlib.sha256(json.dumps(value,sort_keys=True,separators=(',',':')).encode()).hexdigest()
+        return value
+
+    def _route(self,slot_id,owner):
+        with self._lock:
+            slot=self._slots.get(slot_id)
+            if slot is None or not slot['active'] or slot['owner_sha256']!=_owner_digest(owner):
+                raise PinnedDispatchError('credential_route_unavailable')
+            return self._public(slot_id)
+
+    def _secret(self,route,owner,wire):
+        with self._lock:
+            current=self._route(route['slot_id'],owner)
+            if current!=route or wire.model!=route['model'] or wire.recipient.endpoint!=route['endpoint']:
+                raise PinnedDispatchError('credential_route_changed')
+            return self._slots[route['slot_id']]['secret']
+
+
+class _CredentialLoopbackTransport(_LoopbackTransport):
+    """Private test-only authentication, never accepted as production HTTPS."""
+    def __init__(self,resolver,slot_id,owner):
+        if type(resolver) is not _SyntheticCredentialResolver:
+            raise PinnedDispatchError('synthetic_resolver_required')
+        route=resolver._route(slot_id,owner)
+        super().__init__(route['endpoint'])
+        self._resolver=resolver
+        self._route=route
+        self.recipient=Recipient(provider='synthetic-slot-loopback',endpoint=route['endpoint'],
+            credential_mode='synthetic-dedicated-slot',credential_slot=slot_id,
+            credential_version=route['version'],route_sha256=route['route_sha256'])
+
+    def __repr__(self):
+        return '<synthetic recipient-bound transport; credential redacted>'
+
+    def _before_connect(self,wire):
+        self._resolver._secret(self._route,_native_owner(),wire)
+
+    def _headers(self,wire):
+        # Recheck after socket connection, just before header construction. A
+        # later rotation cannot retract an already-admitted header/request.
+        secret=self._resolver._secret(self._route,_native_owner(),wire)
+        return super()._headers(wire)|{'Authorization':'Bearer '+secret}
+
+
+def parse_chat_completion(response,*,expected_model,max_output_tokens=512):
+    """Bounded strict single-choice text response; no logs or raw-output storage."""
+    def pairs(items):
+        out={}
+        for key,value in items:
+            if key in out:
+                raise ValueError('duplicate field')
+            out[key]=value
+        return out
+    try:
+        if type(max_output_tokens) is not int or not 1<=max_output_tokens<=512:
+            raise ValueError('output limit')
+        if type(expected_model) is not str or not 1<=len(expected_model)<=128:
+            raise ValueError('expected model')
+        if type(response) is not bytes or len(response)>8192:
+            raise ValueError('response bound')
+        value=json.loads(response.decode('utf-8'),object_pairs_hook=pairs,parse_constant=lambda _: (_ for _ in ()).throw(ValueError('nonfinite')))
+        required={'id','object','model','choices'}
+        if type(value) is not dict or not required<=set(value) or not set(value)<=required|{'created','usage','system_fingerprint','service_tier','metadata','moderation'}:
+            raise ValueError('envelope fields')
+        if type(value['id']) is not str or not 1<=len(value['id'])<=256 or value['object']!='chat.completion' or value['model']!=expected_model:
+            raise ValueError('response identity')
+        if 'created' in value and (type(value['created']) is not int or value['created']<0):
+            raise ValueError('response time')
+        if 'system_fingerprint' in value and value['system_fingerprint'] is not None and (type(value['system_fingerprint']) is not str or len(value['system_fingerprint'])>256):
+            raise ValueError('fingerprint')
+        if value.get('metadata') not in (None,{}) or value.get('moderation') is not None:
+            raise ValueError('unrequested metadata or moderation')
+        if 'service_tier' in value and value['service_tier'] not in (None,'auto','default','flex','scale','priority','fast'):
+            raise ValueError('service tier')
+        if 'usage' in value:
+            usage=value['usage']
+            core={'prompt_tokens','completion_tokens','total_tokens'}
+            optional={'prompt_tokens_details','completion_tokens_details','prompt_cache_hit_tokens','prompt_cache_miss_tokens'}
+            count=lambda n:type(n) is int and 0<=n<=1000000
+            if (type(usage) is not dict or not core<=set(usage) or not set(usage)<=core|optional
+                    or any(not count(usage[k]) for k in core)
+                    or usage['total_tokens']!=usage['prompt_tokens']+usage['completion_tokens']
+                    or usage['completion_tokens']>max_output_tokens):
+                raise ValueError('usage')
+            for name,keys,ceiling in (
+                    ('prompt_tokens_details',{'audio_tokens','cached_tokens','cache_write_tokens','image_tokens','text_tokens'},usage['prompt_tokens']),
+                    ('completion_tokens_details',{'audio_tokens','reasoning_tokens','accepted_prediction_tokens','rejected_prediction_tokens','text_tokens'},usage['completion_tokens'])):
+                details=usage.get(name)
+                if details is not None:
+                    if (type(details) is not dict or not set(details)<=keys
+                            or any(v is not None and (not count(v) or v>ceiling) for v in details.values())):
+                        raise ValueError('token details')
+            cache_keys={'prompt_cache_hit_tokens','prompt_cache_miss_tokens'}
+            if cache_keys & set(usage):
+                if (not cache_keys<=set(usage) or any(not count(usage[k]) for k in cache_keys)
+                        or sum(usage[k] for k in cache_keys)!=usage['prompt_tokens']):
+                    raise ValueError('cache usage')
+                details=usage.get('prompt_tokens_details')
+                if details and details.get('cached_tokens') is not None and details['cached_tokens']!=usage['prompt_cache_hit_tokens']:
+                    raise ValueError('cache details')
+        choices=value['choices']
+        if type(choices) is not list or len(choices)!=1:
+            raise ValueError('choices')
+        choice=choices[0]
+        if type(choice) is not dict or not {'index','finish_reason','message'}<=set(choice) or not set(choice)<={'index','finish_reason','message','logprobs'} or choice.get('logprobs') is not None or type(choice['index']) is not int or choice['index']!=0 or choice['finish_reason']!='stop':
+            raise ValueError('finish')
+        message=choice['message']
+        if type(message) is not dict or not {'role','content'}<=set(message) or not set(message)<={'role','content','refusal','annotations','tool_calls','function_call','audio','reasoning_content'} or message['role']!='assistant' or message.get('refusal') is not None or type(message['content']) is not str or not message['content']:
+            raise ValueError('assistant content')
+        # This organizer is text-only: tolerate absent/null inactive fields,
+        # never silently discard a tool call, refusal, citation or reasoning body.
+        if (message.get('annotations') not in (None,[]) or message.get('tool_calls') not in (None,[])
+                or any(message.get(k) is not None for k in ('function_call','audio','reasoning_content'))):
+            raise ValueError('unsupported assistant payload')
+        # Lone surrogate escapes are valid JSON syntax but not valid UTF-8 text.
+        message['content'].encode('utf-8')
+        return message['content']
+    except Exception:
+        raise PinnedDispatchError('invalid_chat_completion_envelope') from None
