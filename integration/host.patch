+    home = _home_with_plugins(tmp_path, monkeypatch, {'memoryprobe': PLUGIN})
+    manager = PluginManager()
+    manager.discover_and_load()
+    owner, connection, ref = await local_session(home, monkeypatch)
+    try:
+        assert manager._plugins['memoryprobe'].error is None
+        handler = manager._plugin_rpc_methods['plugin.memoryprobe.read']
+        assert isinstance(handler, _LocalMemoryReadHandler)
+        monkeypatch.setattr('hermes_cli.plugin_rpc.plugin_rpc_handler',
+                            lambda method: manager._plugin_rpc_methods.get(method))
+        owner.sessions.pop(ref.session_id)
+        with owner.db._read_ctx() as conn:
+            before = tuple(conn.iterdump())
+        response = await connection.dispatch({'id': 1, 'method': 'plugin.memoryprobe.read',
+                                               'params': {'session_id': ref.session_id}})
+        result = response['result']
+        with owner.db._read_ctx() as conn:
+            assert tuple(conn.iterdump()) == before
+        assert ref.session_id not in owner.sessions
+        assert result['pid'] != os.getpid()
+        assert result['owner']['canonical_session_id'] == ref.session_id
+        assert result['owner']['project_id'] is None
+        with pytest.raises(Exception, match='memory_context_unavailable'):
+            handler({}, session_id=ref.session_id)
+    finally:
+        manager.unload()
+        manager._plugin_host().shutdown()
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+async def test_hosted_background_replay_alias_and_publication_refuse(tmp_path, monkeypatch):
+    from gateway.session_memory_context import bind_memory_context
+    home = _home_with_plugins(tmp_path, monkeypatch, {'memoryprobe': PLUGIN})
+    manager = PluginManager()
+    manager.discover_and_load()
+    owner, connection, ref = await local_session(home, monkeypatch)
+    try:
+        handler = manager._plugin_rpc_methods['plugin.memoryprobe.read']
+        with bind_memory_context(owner, connection.actor, ref, read_only=True):
+            handler({'mode': 'save'})
+        with bind_memory_context(owner, connection.actor, ref, read_only=True):
+            with pytest.raises(Exception, match='memory_context_unavailable'):
+                handler({'mode': 'replay'})
+            background = handler({'mode': 'background'})
+            assert 'memory_context_unavailable' in background['errors'][0]
+            with pytest.raises(Exception, match='permission_denied'):
+                handler({'alias': 'foreign-session'})
