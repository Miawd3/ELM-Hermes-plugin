+        project = projects_db.create_project(catalog, name='Selected', slug='selected')
+        bind_memory_project(owner, connection.actor, ref, resolve_memory_owner(owner, connection.actor, ref), project)
+        actor = replace(connection.actor, capabilities=frozenset({'session:read'}))
+        expected = resolve_memory_owner(owner, actor, ref)
+        before = _dump(owner.db), tuple(catalog.iterdump())
+        def writer(path):
+            conn = sqlite3.connect(path, timeout=0)
+            try:
+                conn.execute('BEGIN IMMEDIATE')
+                return 'acquired'
+            except sqlite3.OperationalError as exc:
+                assert 'locked' in str(exc)
+                return 'excluded'
+            finally:
+                conn.rollback()
+                conn.close()
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            def reader():
+                for path in (catalog_path, owner.db.db_path):
+                    assert executor.submit(writer, path).result(timeout=10) == 'excluded'
+                return 'record'
+            assert read_memory(owner, actor, ref, expected, reader) == 'record'
+            for path in (catalog_path, owner.db.db_path):
+                assert executor.submit(writer, path).result(timeout=10) == 'acquired'
+        assert (_dump(owner.db), tuple(catalog.iterdump())) == before
+    finally:
