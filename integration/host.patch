+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    catalog = projects_db.connect(Path(owner.db.db_path).parent / 'projects.db')
+    try:
+        project_id = projects_db.create_project(catalog, name='Matching workspace', primary_path=str(tmp_path))
