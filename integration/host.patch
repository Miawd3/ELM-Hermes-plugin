index 00000000..7b43c823
--- /dev/null
+++ b/apps/desktop/src/lib/transcript-presentation.ts
@@ -0,0 +1,34 @@
+import type { Contribution } from '@/contrib/types'
+
+/** Presentation only. Does not change message status, authority, content or navigation. */
+export const TRANSCRIPT_PRESENTATION_AREA = 'transcript.presentation'
+export const PRESENTATION_TYPES = ['progress', 'update', 'answer', 'final', 'question'] as const
+export const PRESENTATION_ACCENTS = ['theme', 'blue', 'green', 'amber', 'violet', 'rose'] as const
+export interface TranscriptPresentationInput { readonly role: 'assistant'; readonly textPrefix: string; readonly streaming: boolean }
+export interface TranscriptPresentation {
+  type: typeof PRESENTATION_TYPES[number]; label: string; showLabel: boolean
+  accent: typeof PRESENTATION_ACCENTS[number]; background: 'none' | 'subtle'; border: 'none' | 'side' | 'outline'
+}
+export interface TranscriptPresentationContribution { classify: (input: Readonly<TranscriptPresentationInput>) => TranscriptPresentation | null | undefined }
+
+/** Serialized primitive keeps the streaming selector stable when presentation is unchanged. */
+export function transcriptPresentation(contributions: readonly Contribution[], role: string, text: string, streaming: boolean): string | undefined {
+  if (role !== 'assistant' || !contributions.length) return undefined
+  let textPrefix = text.slice(0, 8192)
+  if (text.length > 8192 || (streaming && !textPrefix.endsWith('\n'))) textPrefix = textPrefix.slice(0, textPrefix.lastIndexOf('\n') + 1)
+  const input = Object.freeze({ role: 'assistant' as const, textPrefix, streaming })
+  for (const c of contributions.slice(0, 8)) {
+    try {
+      const data = c.data as TranscriptPresentationContribution | undefined
+      if (typeof data?.classify !== 'function') continue
+      const value = data.classify(input)
+      if (value && typeof (value as unknown as { then?: unknown }).then === 'function') { void Promise.resolve(value).catch(() => undefined); continue }
+      if (!value || typeof value !== 'object' || Object.keys(value).sort().join(',') !== 'accent,background,border,label,showLabel,type') continue
+      const { type, label, showLabel, accent, background, border } = value
+      if (!PRESENTATION_TYPES.includes(type) || !PRESENTATION_ACCENTS.includes(accent) || !['none','subtle'].includes(background) || !['none','side','outline'].includes(border)) continue
+      if (typeof showLabel !== 'boolean' || typeof label !== 'string' || !label.trim() || label.length > 24 || /[\p{Cc}\p{Cf}\p{Cs}]/u.test(label)) continue
+      return JSON.stringify({ type, label: label.trim(), showLabel, accent, background, border })
+    } catch { /* A broken presentation policy must not break native transcript rendering. */ }
+  }
+  return undefined
+}
