+"""A publication fence never retries external effects and excludes durable owner changes."""
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import replace
+import sqlite3
+
+import pytest
+
+from gateway.session_memory_owner import resolve_memory_owner
+from gateway.session_memory_publication import MemoryPublicationUncertain, publish_memory
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway.test_local_authority_transitions import local_session
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('error', [sqlite3.OperationalError('database is locked'), RuntimeError('after effect')])
+async def test_external_exception_is_uncertain_and_never_replayed(tmp_path, monkeypatch, error):
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    calls = []
+    try:
+        expected = resolve_memory_owner(owner, connection.actor, ref)
+        def publish():
+            calls.append('effect')
+            raise error
+        with pytest.raises(MemoryPublicationUncertain) as caught:
+            publish_memory(owner, connection.actor, ref, expected, publish)
+        assert caught.value.__cause__ is error
+        assert calls == ['effect']
+        assert not owner.db._conn.in_transaction
+        assert resolve_memory_owner(owner, connection.actor, ref) == expected
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+async def test_reset_refuses_stale_snapshot_before_callback(tmp_path, monkeypatch):
+    from gateway.session_mutations import mutate_session
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    calls = []
+    try:
+        expected = resolve_memory_owner(owner, connection.actor, ref)
+        handle = owner._handle(ref)
+        await mutate_session(owner, connection.actor, ref, dict(session_id=ref.session_id,
+            request_id='reset', operation='reset', payload={}, expected_revision=handle.revision,
+            expected_generation=handle.execution_generation))
+        with pytest.raises(RuntimeStoreError, match='memory_owner_changed'):
+            publish_memory(owner, connection.actor, ref, expected, lambda: calls.append('effect'))
+        assert calls == []
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('change', ['epoch', 'project', 'revision', 'retired', 'capability'])
+async def test_stale_scope_refused_before_effect(tmp_path, monkeypatch, change):
+    from hermes_state_runtime import begin_runtime_epoch
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    calls = []
+    try:
+        expected = resolve_memory_owner(owner, connection.actor, ref)
+        actor = connection.actor
+        if change == 'epoch':
+            begin_runtime_epoch(owner.db, instance_id='successor')
+        elif change == 'project':
+            expected = replace(expected, project_id='not-bound')
+        elif change == 'revision':
+            expected = replace(expected, revision=expected.revision + 1)
+        elif change == 'retired':
+            owner.retired = True
+        else:
+            actor = replace(actor, capabilities=frozenset({'session:read'}))
+        with pytest.raises(RuntimeStoreError):
+            publish_memory(owner, actor, ref, expected, lambda: calls.append('effect'))
+        assert calls == []
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+async def test_sqlite_writer_excluded_during_publication_and_released_after(tmp_path, monkeypatch):
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    try:
+        expected = resolve_memory_owner(owner, connection.actor, ref)
+        def other_writer():
+            conn = sqlite3.connect(owner.db.db_path, timeout=0)
+            try:
+                conn.execute('BEGIN IMMEDIATE')
+                conn.rollback()
+                return 'acquired'
+            except sqlite3.OperationalError as exc:
+                assert 'locked' in str(exc)
+                return 'excluded'
+            finally:
+                conn.close()
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            def publish():
+                assert executor.submit(other_writer).result(timeout=10) == 'excluded'
+                return 'published'
+            assert publish_memory(owner, connection.actor, ref, expected, publish) == 'published'
+            assert executor.submit(other_writer).result(timeout=10) == 'acquired'
+        assert resolve_memory_owner(owner, connection.actor, ref) == expected
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('kind', ['coroutine_function', 'returned_awaitable', 'cancel'])
+async def test_async_and_cancel_contract(tmp_path, monkeypatch, kind):
+    import asyncio
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    calls = []
+    try:
+        expected = resolve_memory_owner(owner, connection.actor, ref)
+        async def deferred():
+            calls.append('async effect')
+        if kind == 'coroutine_function':
+            callback = deferred
+            error = RuntimeStoreError
+        elif kind == 'returned_awaitable':
+            def callback():
+                calls.append('sync effect')
+                return deferred()
+            error = MemoryPublicationUncertain
+        else:
+            def callback():
+                calls.append('sync effect')
+                raise asyncio.CancelledError()
+            error = asyncio.CancelledError
+        with pytest.raises(error):
+            publish_memory(owner, connection.actor, ref, expected, callback)
+        assert calls == ([] if kind == 'coroutine_function' else ['sync effect'])
+        assert not owner.db._conn.in_transaction
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+async def test_context_expired_while_waiting_for_writer_never_publishes(tmp_path, monkeypatch):
+    import threading
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    entered, calls = threading.Event(), []
+    try:
+        expected = resolve_memory_owner(owner, connection.actor, ref)
+        active = [True]
+        def check_context():
+            if not active[0]:
+                raise RuntimeStoreError('memory_context_unavailable')
+        def worker():
+            entered.set()
+            return publish_memory(owner, connection.actor, ref, expected,
+                                  lambda: calls.append('effect'), check_context=check_context)
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            with owner.db._lock:
+                future = executor.submit(worker)
+                assert entered.wait(timeout=10)
+                active[0] = False
+            with pytest.raises(RuntimeStoreError, match='memory_context_unavailable'):
+                future.result(timeout=10)
+        assert calls == []
+    finally:
+        await connection.close()
+        owner.db.close()
