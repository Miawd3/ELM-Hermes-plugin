+"""Explicit principal-scoped bindings and catalog exclusion without implicit creation."""
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.session_memory_projects import (
+    project_catalog, project_fingerprint, read_project_binding,
+    validate_project_binding, write_project_binding,
+)
+from hermes_state_runtime import RuntimeStoreError
+
+
+@pytest.fixture
+def stores(tmp_path):
+    from hermes_state import SessionDB
+    from hermes_cli import projects_db
+    db = SessionDB(tmp_path / 'state.db')
+    db.create_session('canonical', source='cli')
+    catalog = projects_db.connect(tmp_path / 'projects.db')
+    project_id = projects_db.create_project(catalog, name='Explicit project', slug='explicit')
+    authority = SimpleNamespace(db=db)
+    try:
+        yield authority, catalog, project_id
+    finally:
+        catalog.close()
+        db.close()
+
+
+def _bind(authority, project_id, *, revision=0, canonical_id='canonical', principal_id='owner'):
+    with project_catalog(authority, write=True) as catalog:
+        fingerprint = project_fingerprint(catalog, project_id)
+        return authority.db._execute_write(lambda conn: write_project_binding(
+            conn, canonical_id, principal_id, project_id, fingerprint, expected_revision=revision))
+
+
+def test_binding_cas_principal_and_tombstone(stores):
+    authority, catalog, project_id = stores
+    with authority.db._read_ctx() as conn:
+        empty = read_project_binding(conn, 'canonical', 'owner')
+    assert empty.project_id is None and empty.revision == 0
+    bound = _bind(authority, project_id)
+    assert bound.project_id == project_id and bound.revision == 1
+    with authority.db._read_ctx() as conn:
+        assert read_project_binding(conn, 'canonical', 'owner') == bound
+        with pytest.raises(RuntimeStoreError):
+            read_project_binding(conn, 'canonical', 'another-principal')
+    with pytest.raises(RuntimeStoreError, match='memory_owner_changed'):
+        _bind(authority, project_id)
+    unbound = authority.db._execute_write(lambda conn: write_project_binding(
+        conn, 'canonical', 'owner', None, None, expected_revision=1))
+    assert unbound.project_id is None and unbound.revision == 2
+    assert authority.db.get_session('canonical')['runtime_revision'] == 2
+
+
+@pytest.mark.parametrize('operation', ['archive', 'delete', 'rename'])
+def test_native_catalog_changes_invalidate_publication_snapshot(stores, operation):
+    from hermes_cli import projects_db
+    authority, catalog, project_id = stores
+    binding = _bind(authority, project_id)
+    if operation == 'archive':
+        projects_db.archive_project(catalog, project_id)
+    elif operation == 'delete':
+        projects_db.delete_project(catalog, project_id)
+    else:
+        projects_db.update_project(catalog, project_id, name='Changed')
+    with project_catalog(authority) as reader:
+        with pytest.raises(RuntimeStoreError):
+            validate_project_binding(reader, binding)
+    # Stored membership remains inspectable so explicit unbind is always possible.
+    with authority.db._read_ctx() as conn:
+        assert read_project_binding(conn, 'canonical', 'owner') == binding
+    unbound = authority.db._execute_write(lambda conn: write_project_binding(
+        conn, 'canonical', 'owner', None, None, expected_revision=binding.revision))
+    assert unbound.project_id is None
+
+
+def test_exact_id_only_no_active_or_path_inference(stores):
+    from hermes_cli import projects_db
+    authority, catalog, project_id = stores
+    projects_db.set_active(catalog, project_id)
+    projects_db.add_folder(catalog, project_id, str(Path(authority.db.db_path).parent))
+    with project_catalog(authority) as reader:
+        with pytest.raises(RuntimeStoreError, match='project_unavailable'):
+            project_fingerprint(reader, 'explicit')
+        with pytest.raises(RuntimeStoreError, match='project_unavailable'):
+            project_fingerprint(reader, str(Path(authority.db.db_path).parent))
+    with authority.db._read_ctx() as conn:
+        assert read_project_binding(conn, 'canonical', 'owner').project_id is None
+
+
+@pytest.mark.parametrize('contents', [None, b'not sqlite'])
+def test_missing_or_corrupt_catalog_never_created_or_repaired(tmp_path, contents):
+    path = tmp_path / 'projects.db'
+    if contents is not None:
+        path.write_bytes(contents)
+    authority = SimpleNamespace(db=SimpleNamespace(db_path=tmp_path / 'state.db'))
+    with pytest.raises(RuntimeStoreError):
+        with project_catalog(authority, write=True) as conn:
+            project_fingerprint(conn, 'p_missing')
+    if contents is None:
+        assert not path.exists()
+    else:
+        assert path.read_bytes() == contents
+
+
+def test_native_project_writer_excluded_until_guard_releases(stores):
+    import sqlite3
+    from hermes_cli import projects_db
+    authority, catalog, project_id = stores
+    binding = _bind(authority, project_id)
+    def archive():
+        conn = projects_db.connect(Path(authority.db.db_path).parent / 'projects.db')
+        conn.execute('PRAGMA busy_timeout=0')
+        try:
+            try:
+                projects_db.archive_project(conn, project_id)
+                return 'archived'
+            except sqlite3.OperationalError as exc:
+                assert 'locked' in str(exc)
+                return 'excluded'
+        finally:
+            conn.close()
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        with project_catalog(authority, write=True) as conn:
+            validate_project_binding(conn, binding)
+            assert executor.submit(archive).result(timeout=10) == 'excluded'
+            validate_project_binding(conn, binding)
+        assert executor.submit(archive).result(timeout=10) == 'archived'
+
+
+def test_unbind_without_catalog(stores):
+    authority, catalog, project_id = stores
+    _bind(authority, project_id)
+    catalog.close()
+    catalog_path = Path(authority.db.db_path).parent / 'projects.db'
+    catalog_path.unlink()
+    unbound = authority.db._execute_write(lambda conn: write_project_binding(
+        conn, 'canonical', 'owner', None, None, expected_revision=1))
+    assert unbound.project_id is None
+    assert not catalog_path.exists()
+
+
+@pytest.mark.parametrize('native_delete', [True, False])
+def test_recreated_same_id_does_not_inherit_project_binding(stores, native_delete):
+    authority, catalog, project_id = stores
+    binding = _bind(authority, project_id)
+    if native_delete:
+        authority.db.delete_session('canonical')
+    else:
+        authority.db._execute_write(lambda conn: conn.execute('DELETE FROM sessions WHERE id=?', ('canonical',)))
+    # Simulate a legacy writer/import bypassing canonical admission's deletion fence.
+    def recreate(conn):
+        conn.execute('INSERT INTO sessions(id,source,started_at) VALUES(?,?,?)',
+                     ('canonical', 'cli', binding.owner_started_at if native_delete else binding.owner_started_at + 1))
+    authority.db._execute_write(recreate)
+    with authority.db._read_ctx() as conn:
+        with pytest.raises(RuntimeStoreError, match='memory_owner_changed'):
+            read_project_binding(conn, 'canonical', 'owner')
+    with pytest.raises(RuntimeStoreError, match='memory_owner_changed'):
+        authority.db._execute_write(lambda conn: write_project_binding(
+            conn, 'canonical', 'owner', None, None, expected_revision=binding.revision))
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('operation', ['reset', 'compression'])
+async def test_canonical_incarnation_survives_transcript_rotation(tmp_path, monkeypatch, operation):
+    from tests.gateway.test_local_authority_transitions import local_session
+    from tests.gateway.test_local_resume_compression_child import _compress
+    from hermes_cli import projects_db
+    from gateway.session_memory_owner import resolve_memory_owner
+    from gateway.session_mutations import mutate_session
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    catalog = projects_db.connect(Path(owner.db.db_path).parent / 'projects.db')
+    try:
+        project_id = projects_db.create_project(catalog, name='Bound project')
+        binding = _bind(owner, project_id, canonical_id=ref.session_id, principal_id=connection.actor.subject)
+        if operation == 'compression':
+            _compress(owner.db, ref.session_id, 'compressed-child', 'cli')
+        else:
+            handle = owner._handle(ref)
+            await mutate_session(owner, connection.actor, ref, dict(session_id=ref.session_id,
+                request_id='reset', operation='reset', payload={}, expected_revision=handle.revision,
+                expected_generation=handle.execution_generation))
+        result = resolve_memory_owner(owner, connection.actor, ref)
+        assert result.physical_session_id != ref.session_id
+        assert result.project_id == project_id
+        with owner.db._read_ctx() as conn:
