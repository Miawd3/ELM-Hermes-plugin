+"""Experimental pinned-dispatch contract; NO production transport is implemented.
+
+The private offline factory is a trusted test seam, not a plugin permission or a
+sandbox. Nothing here loads credentials, discovers routes, or performs HTTP.
+"""
+from dataclasses import dataclass, field
+import hashlib
+import inspect
+import json
+import secrets
+import threading
+import time
+
+
+class PinnedDispatchError(RuntimeError):
+    """Fixed, non-secret diagnostic."""
+
+
+class PinnedOutcomeUncertain(PinnedDispatchError):
+    """Transport was invoked; the consumed request MUST NOT be replayed."""
+
+
+@dataclass(frozen=True)
+class Recipient:
+    provider: str = 'offline-test'
+    endpoint: str = 'https://offline.invalid/v1/chat/completions'
+    credential_mode: str = 'none'
+    redirects: bool = False
+    automatic_retries: int = 0
+    fallback: bool = False
+    environment_proxy: bool = False
+    credential_slot: str | None = None
+    credential_version: int | None = None
+    route_sha256: str | None = None
+
+
+@dataclass(frozen=True)
+class WireRequest:
+    recipient: Recipient
+    model: str
+    body: bytes = field(repr=False)
+    payload_sha256: str
+    timeout_seconds: int
+    max_response_bytes: int
+    max_output_tokens: int
+
+
+@dataclass(frozen=True)
+class PreparedRequest:
+    token: str = field(repr=False)
+    wire: WireRequest
+    expires_in_seconds: int = 300
+    production_dispatch_supported: bool = False
+    cost_notice: str = 'Experimental contract only; no priced production route or spending guarantee exists.'
+
+    @property
+    def attempt_id(self):
+        return hashlib.sha256(self.token.encode('ascii')).hexdigest()
+
+
+@dataclass(frozen=True)
+class _Pending:
+    prepared: PreparedRequest
+    owner: object = field(repr=False)
+    freshness: str = field(repr=False)
+    deadline: float
+
+
+def production_contract():
+    raise PinnedDispatchError('pinned_production_transport_unavailable')
+
+
+def _native_owner():
+    from hermes_cli.plugin_memory import memory_owner
+    return memory_owner(version=1)
+
+
+def _native_admission(owner, check):
+    from hermes_cli.plugin_memory import read_memory
+    return read_memory(owner, check)
+
+
+def _body(payload, model):
+    if type(model) is not str or not model or len(model)>128:
+        raise PinnedDispatchError('invalid_model')
+    if type(payload) is not dict or set(payload)!={'messages','temperature','max_tokens'}:
+        raise PinnedDispatchError('invalid_payload')
+    if type(payload['max_tokens']) is not int or not 1<=payload['max_tokens']<=512:
+        raise PinnedDispatchError('invalid_output_bound')
+    if type(payload['temperature']) is not int or payload['temperature']!=0:
+        raise PinnedDispatchError('invalid_temperature')
+    messages=payload['messages']
+    if type(messages) is not list or not 1<=len(messages)<=8:
+        raise PinnedDispatchError('invalid_messages')
+    for row in messages:
+        if (type(row) is not dict or set(row)!={'role','content'}
+                or type(row['role']) is not str or row['role'] not in ('system','user')
+                or type(row['content']) is not str or len(row['content'])>32768):
+            raise PinnedDispatchError('invalid_messages')
+    try:
+        body=json.dumps(dict(payload,model=model),sort_keys=True,ensure_ascii=True,
+                        separators=(',',':'),allow_nan=False).encode('utf-8')
+    except (ValueError,TypeError,UnicodeError):
+        raise PinnedDispatchError('invalid_payload') from None
+    if len(body)>32768:
+        raise PinnedDispatchError('payload_limit')
+    return body
+
+
+class _OfflineContract:
+    def __init__(self,transport,owner_reader,freshness_reader,admit):
+        if not callable(transport) or inspect.iscoroutinefunction(transport):
+            raise PinnedDispatchError('synchronous_transport_required')
+        self._transport=transport
+        self._recipient=Recipient()
+        self._owner_reader=owner_reader
+        self._freshness_reader=freshness_reader
+        self._admit=admit
+        self._lock=threading.RLock()
+        self._pending={}
+        self._closed=False
+
+    def _live(self):
+        if self._closed:
+            raise PinnedDispatchError('contract_closed')
+
+    def close(self):
+        with self._lock:
+            self._closed=True
+            self._pending.clear()
+
+    def _checked_callback(self, callback, *args):
+        try:
+            value=callback(*args)
+        except Exception:
+            raise PinnedDispatchError('authority_or_freshness_check_failed') from None
+        # RLock allows a trusted callback to close this contract reentrantly.
+        self._live()
+        return value
+
+    def _fresh(self):
+        value=self._checked_callback(self._freshness_reader)
+        if type(value) is not str or len(value)!=64 or any(c not in '0123456789abcdef' for c in value):
+            raise PinnedDispatchError('invalid_freshness_digest')
+        return value
+
+    def prepare(self,payload,*,model,expected_freshness,max_response_bytes=8192,timeout_seconds=10):
+        body=_body(payload,model)
+        output_tokens=json.loads(body)['max_tokens']
+        if type(expected_freshness) is not str or len(expected_freshness)!=64 or any(c not in '0123456789abcdef' for c in expected_freshness):
+            raise PinnedDispatchError('invalid_freshness_digest')
+        if (type(max_response_bytes) is not int or not 1<=max_response_bytes<=8192
+                or type(timeout_seconds) is not int or not 1<=timeout_seconds<=30):
+            raise PinnedDispatchError('invalid_transport_limits')
+        with self._lock:
+            self._live()
+            owner=self._checked_callback(self._owner_reader)
+            freshness=self._checked_callback(self._admit,owner,self._fresh)
+            if freshness!=expected_freshness:
+                raise PinnedDispatchError('source_snapshot_changed')
+            now=time.monotonic()
+            self._pending={k:v for k,v in self._pending.items() if v.deadline>now}
+            if len(self._pending)>=16:
+                raise PinnedDispatchError('preview_capacity')
+            wire=WireRequest(self._recipient,model,body,hashlib.sha256(body).hexdigest(),
+                             timeout_seconds,max_response_bytes,output_tokens)
+            prepared=PreparedRequest(secrets.token_urlsafe(32),wire)
+            self._pending[prepared.token]=_Pending(prepared,owner,freshness,now+300)
+            return prepared
+
+    def cancel(self,token):
+        with self._lock:
+            self._live()
+            pending=self._pending.get(token) if type(token) is str else None
+            if pending is None:
+                raise PinnedDispatchError('preview_unavailable')
+            if self._checked_callback(self._owner_reader)!=pending.owner:
+                raise PinnedDispatchError('owner_changed')
+            del self._pending[token]
+
+    def _invoke(self,pending):
+        return self._transport(pending.prepared.wire)
+
+    def execute(self,token,*,confirm,payload_sha256):
+        if confirm is not True or type(token) is not str:
+            raise PinnedDispatchError('explicit_confirmation_required')
+        with self._lock:
+            self._live()
+            pending=self._pending.get(token)
+            if pending is None:
+                raise PinnedDispatchError('preview_unavailable')
+            # Foreign callers do not burn another owner's preview. This object
+            # never accepts caller-provided identity as authority.
+            if self._checked_callback(self._owner_reader)!=pending.owner:
+                raise PinnedDispatchError('owner_changed')
+            del self._pending[token]
+            wire=pending.prepared.wire
+            if time.monotonic()>=pending.deadline:
+                raise PinnedDispatchError('preview_expired')
+            if type(payload_sha256) is not str or payload_sha256!=wire.payload_sha256:
+                raise PinnedDispatchError('payload_changed')
+            if self._checked_callback(self._admit,pending.owner,self._fresh)!=pending.freshness:
+                raise PinnedDispatchError('source_snapshot_changed')
+            # Native read locks are released before transport. This is final
+            # admission, not a lock held across a network call. No retry path.
+            try:
+                result=self._invoke(pending)
+                if inspect.isawaitable(result):
+                    if inspect.iscoroutine(result):
+                        result.close()
+                    raise ValueError('asynchronous result')
+                if type(result) is not bytes or len(result)>wire.max_response_bytes:
+                    raise ValueError('invalid response')
+                return result
+            except Exception:
+                raise PinnedOutcomeUncertain('dispatch_outcome_uncertain_do_not_replay') from None
+            except BaseException as exc:
+                exc.add_note('Pinned request consumed; outcome uncertain; do not replay.')
+                raise
+
+
+def _offline_contract(transport,*,freshness_reader,owner_reader=_native_owner,admit=_native_admission):
+    """Trusted LOCAL tests only. The transport must not perform network I/O.
+
+    Injected callbacks are not a security boundary. Production never calls this
+    factory. A fake verifies state/bytes, NOT HTTP redirect, timeout, proxy, price,
+    credential or remote-outcome guarantees of a future production adapter.
+    """
+    return _OfflineContract(transport,owner_reader,freshness_reader,admit)
