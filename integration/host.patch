@@ -0,0 +1,204 @@
+"""Explicit project CAS and catalog/state publication fencing on native databases."""
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import replace
+import sqlite3
+from pathlib import Path
+
+import pytest
+from hermes_cli import projects_db
+from gateway.session_memory_owner import resolve_memory_owner
+from gateway.session_memory_binding import bind_memory_project
+from gateway.session_memory_publication import publish_memory
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway.test_local_authority_transitions import local_session
+
+
+async def setup(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    catalog = projects_db.connect(Path(owner.db.db_path).parent / 'projects.db')
+    one = projects_db.create_project(catalog, name='One')
+    two = projects_db.create_project(catalog, name='Two')
+    return owner, connection, ref, catalog, one, two
+
+
+async def close(owner, connection, catalog):
+    catalog.close()
+    await connection.close()
+    owner.db.close()
+
+
+@pytest.mark.asyncio
+async def test_explicit_bind_rebind_and_stale_publication_refusal(tmp_path, monkeypatch):
+    owner, connection, ref, catalog, one, two = await setup(tmp_path, monkeypatch)
+    try:
+        before = resolve_memory_owner(owner, connection.actor, ref)
+        first = bind_memory_project(owner, connection.actor, ref, before, one)
+        assert first.project_id == one and first.project_revision > before.project_revision
+        assert first.principal_id == before.principal_id
+        second = bind_memory_project(owner, connection.actor, ref, first, two)
+        effects = []
+        with pytest.raises(RuntimeStoreError):
+            publish_memory(owner, connection.actor, ref, first, lambda: effects.append('stale'))
+        assert not effects
+        assert publish_memory(owner, connection.actor, ref, second, lambda: 'ok') == 'ok'
+        with pytest.raises(RuntimeStoreError):
+            bind_memory_project(owner, connection.actor, ref, first, None)
+    finally:
+        await close(owner, connection, catalog)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('operation', ['archive', 'delete', 'rename'])
+async def test_changed_catalog_blocks_publish_but_allows_explicit_unbind(tmp_path, monkeypatch, operation):
+    owner, connection, ref, catalog, one, _ = await setup(tmp_path, monkeypatch)
+    try:
+        before = resolve_memory_owner(owner, connection.actor, ref)
+        bound = bind_memory_project(owner, connection.actor, ref, before, one)
+        if operation == 'archive':
+            projects_db.archive_project(catalog, one)
+        elif operation == 'delete':
+            projects_db.delete_project(catalog, one)
+        else:
+            projects_db.update_project(catalog, one, name='Renamed')
+        effects = []
+        with pytest.raises(RuntimeStoreError):
+            publish_memory(owner, connection.actor, ref, bound, lambda: effects.append('invalid'))
+        assert not effects
+        # A binding snapshot is not a claim that its catalog target remains eligible.
+        current = resolve_memory_owner(owner, connection.actor, ref)
+        cleared = bind_memory_project(owner, connection.actor, ref, current, None)
+        assert cleared.project_id is None and cleared.project_revision > current.project_revision
+        assert publish_memory(owner, connection.actor, ref, cleared, lambda: 'unbound') == 'unbound'
+    finally:
+        await close(owner, connection, catalog)
+
+
+@pytest.mark.asyncio
+async def test_catalog_and_state_writers_excluded_during_bound_effect(tmp_path, monkeypatch):
+    owner, connection, ref, catalog, one, _ = await setup(tmp_path, monkeypatch)
+    try:
+        bound = bind_memory_project(owner, connection.actor, ref, resolve_memory_owner(owner, connection.actor, ref), one)
+        def can_write(path):
+            conn = sqlite3.connect(path, timeout=0)
+            try:
+                conn.execute('BEGIN IMMEDIATE')
+                conn.rollback()
+                return True
+            except sqlite3.OperationalError as exc:
+                assert 'locked' in str(exc)
+                return False
+            finally:
+                conn.close()
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            def effect():
+                assert not executor.submit(can_write, Path(owner.db.db_path).parent / 'projects.db').result(timeout=10)
+                assert not executor.submit(can_write, owner.db.db_path).result(timeout=10)
+                return 'done'
+            assert publish_memory(owner, connection.actor, ref, bound, effect) == 'done'
+            assert executor.submit(can_write, Path(owner.db.db_path).parent / 'projects.db').result(timeout=10)
+            assert executor.submit(can_write, owner.db.db_path).result(timeout=10)
+    finally:
+        await close(owner, connection, catalog)
+
+
+@pytest.mark.asyncio
+async def test_foreign_principal_cannot_bind_or_publish(tmp_path, monkeypatch):
+    owner, connection, ref, catalog, one, _ = await setup(tmp_path, monkeypatch)
+    try:
+        current = resolve_memory_owner(owner, connection.actor, ref)
+        foreign = replace(connection.actor, subject='someone-else')
+        with pytest.raises(RuntimeStoreError):
+            bind_memory_project(owner, foreign, ref, current, one)
+        assert resolve_memory_owner(owner, connection.actor, ref) == current
+    finally:
+        await close(owner, connection, catalog)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('operation', ['archive', 'delete'])
+async def test_native_catalog_lifecycle_waits_for_publication(tmp_path, monkeypatch, operation):
+    owner, connection, ref, catalog, one, _ = await setup(tmp_path, monkeypatch)
+    try:
+        bound = bind_memory_project(owner, connection.actor, ref, resolve_memory_owner(owner, connection.actor, ref), one)
+        def mutate_catalog():
+            conn = sqlite3.connect(Path(owner.db.db_path).parent / 'projects.db', timeout=0)
+            conn.row_factory = sqlite3.Row
+            try:
+                method = projects_db.archive_project if operation == 'archive' else projects_db.delete_project
+                return method(conn, one)
+            finally:
+                conn.close()
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            def effect():
+                with pytest.raises(sqlite3.OperationalError, match='locked'):
+                    executor.submit(mutate_catalog).result(timeout=10)
+            publish_memory(owner, connection.actor, ref, bound, effect)
+            assert executor.submit(mutate_catalog).result(timeout=10)
+        with pytest.raises(RuntimeStoreError):
+            publish_memory(owner, connection.actor, ref, bound, lambda: pytest.fail('revoked target'))
+    finally:
+        await close(owner, connection, catalog)
+
+
+@pytest.mark.asyncio
+async def test_public_api_scope_controls_binding(tmp_path, monkeypatch):
+    from gateway.session_memory_context import bind_memory_context
+    from hermes_cli.plugin_memory import bind_memory_project as public_bind
+    owner, connection, ref, catalog, one, _ = await setup(tmp_path, monkeypatch)
+    try:
+        expected = resolve_memory_owner(owner, connection.actor, ref)
+        with bind_memory_context(owner, connection.actor, ref, read_only=True):
+            with pytest.raises(RuntimeStoreError, match='memory_publication_unavailable'):
+                public_bind(expected, one)
+        with bind_memory_context(owner, connection.actor, ref):
+            result = public_bind(expected, one)
+        assert result.project_id == one
+        with pytest.raises(RuntimeStoreError, match='memory_publication_unavailable'):
+            public_bind(result, None)
+    finally:
+        await close(owner, connection, catalog)
+
+
+@pytest.mark.asyncio
+async def test_retirement_before_commit_rolls_binding_back(tmp_path, monkeypatch):
+    import gateway.session_memory_binding as binding_module
+    owner, connection, ref, catalog, one, _ = await setup(tmp_path, monkeypatch)
+    try:
+        expected = resolve_memory_owner(owner, connection.actor, ref)
+        real_write = binding_module.write_project_binding
+        def retire_after_write(*args, **kwargs):
+            result = real_write(*args, **kwargs)
+            owner.retired = True
+            return result
+        monkeypatch.setattr(binding_module, 'write_project_binding', retire_after_write)
+        with pytest.raises(RuntimeStoreError):
+            bind_memory_project(owner, connection.actor, ref, expected, one)
+        owner.retired = False
+        assert resolve_memory_owner(owner, connection.actor, ref) == expected
+    finally:
+        owner.retired = False
+        await close(owner, connection, catalog)
+
+
+@pytest.mark.asyncio
+async def test_postcommit_retirement_reports_uncertain_persisted_binding(tmp_path, monkeypatch):
+    import gateway.session_authorities as authorities
+    owner, connection, ref, catalog, one, _ = await setup(tmp_path, monkeypatch)
+    try:
+        expected = resolve_memory_owner(owner, connection.actor, ref)
+        real_check, checks = authorities.require_serving, []
+        def retire_at_postcommit(authority):
+            checks.append(1)
+            if len(checks) == 3:
+                authority.retired = True
+            return real_check(authority)
+        monkeypatch.setattr(authorities, 'require_serving', retire_at_postcommit)
+        with pytest.raises(RuntimeStoreError, match='memory_binding_uncertain'):
+            bind_memory_project(owner, connection.actor, ref, expected, one)
+        owner.retired = False
+        monkeypatch.setattr(authorities, 'require_serving', real_check)
+        assert resolve_memory_owner(owner, connection.actor, ref).project_id == one
+    finally:
+        owner.retired = False
+        await close(owner, connection, catalog)
