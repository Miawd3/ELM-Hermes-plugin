+"""Metadata-only current-chat filing; no filesystem or memory sharing authority."""
+import os
+
+from hermes_state_runtime import RuntimeStoreError
+
+
+def chat_folder_capabilities():
+    from hermes_cli.plugin_isolation import HOST_PROCESS_ENV
+    return {'version': 1, 'available': os.environ.get(HOST_PROCESS_ENV) != '1'}
+
+
+def chat_folders(*, operation='status', value=None, expected_context=None, expected_revision=None):
+    if not chat_folder_capabilities()['available']:
+        raise RuntimeStoreError('chat_folders_unavailable')
+    from gateway.session_memory_context import _current
+    scope = _current.get()
+    write = operation != 'status'
+    def check():
+        if scope is None or not scope.active or not scope.ref.session_id or (write and scope.read_only):
+            raise RuntimeStoreError('chat_folders_unavailable')
+        if scope.validate is not None:
+            scope.validate()
+    check()
+    from gateway.session_chat_folders import chat_folders as invoke
+    return invoke(scope.authority, scope.actor, scope.ref, operation=operation, value=value,
+                  expected_context=expected_context, expected_revision=expected_revision, check_context=check)
