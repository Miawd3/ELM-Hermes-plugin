@@ -0,0 +1,52 @@
+"""Synchronous opt-in local finalizer capture; never asynchronous memory sync."""
+
+
+def _notice(agent, text):
+    try:
+        emit = getattr(agent, '_emit_status', None)
+        if callable(emit):
+            emit(text)
+    except Exception:
+        pass
+
+
+def finalize_memory_capture(agent, result):
+    manager = getattr(agent, '_memory_manager', None)
+    if (manager is None or getattr(manager, '_agent_context', None) != 'primary'
+            or not result.get('completed') or result.get('failed') or result.get('interrupted') or result.get('partial')
+            or getattr(agent, '_persist_disabled', False) or getattr(agent, 'is_subagent', False)
+            or getattr(agent, '_parent_session_id', None) or getattr(agent, 'side_agent', False)
+            or getattr(agent, '_interrupt_requested', False) or getattr(agent, '_turn_author', None)
+            or getattr(agent, 'memory_agent_context', None) not in (None, 'primary')
+            or getattr(agent, 'platform', None) in ('cron', 'subagent', 'background', 'flush')
+            or getattr(agent, '_scoped_memory_moa_active', False) or getattr(agent, 'provider', None) == 'moa'):
+        return
+    entered = False
+    try:
+        if not manager._owner_allows('capture_finalized_turn'):
+            return
+        providers = [p for p in manager.providers if getattr(p, 'local_capture_contract', None) == 1]
+        if len(providers) != 1:
+            return
+        assistant = result.get('final_response')
+        if type(assistant) is not str or not assistant:
+            return
+        from gateway.session_memory_turn import finalized_capture_scope, capture_turn_input, set_capture_material
+        from agent.memory_manager import _redact_for_provider
+        with finalized_capture_scope():
+            receipt = capture_turn_input()
+            entered = True
+            if len(receipt['user_text'].encode('utf-8')) + len(assistant.encode('utf-8')) > 65536:
+                outcome = {'status': 'skipped', 'reason': 'oversized_turn'}
+            else:
+                user, assistant = _redact_for_provider(receipt.pop('user_text'), assistant)
+                set_capture_material(user, assistant)
+                outcome = providers[0].capture_finalized_turn(
+                    session_id=agent.session_id, receipt=receipt, user_text=user, assistant_text=assistant)
+        if isinstance(outcome, dict) and outcome.get('status') not in ('disabled', 'captured', 'already_captured'):
+            _notice(agent, 'Local conversation capture was not confirmed: ' + str(outcome.get('reason', 'unavailable')))
+    except Exception:
+        if not entered:
+            return
+        # Never fail a completed chat because optional capture failed. No body/path logs.
+        _notice(agent, 'Local conversation capture was not confirmed; inspect capture status before retrying.')
