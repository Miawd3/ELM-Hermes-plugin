+import './message-presentation.css'
+import { useAuiState } from '@assistant-ui/react'
+import { useContributions } from '@/contrib/react/use-contributions'
+import { transcriptPresentation, TRANSCRIPT_PRESENTATION_AREA, type TranscriptPresentation } from '@/lib/transcript-presentation'
+import { partText } from './content'
+
+/** Preserve whitespace: trimming would turn an indented code example into a directive. */
+export function presentationText(content: unknown): string {
+  if (typeof content === 'string') return content
+  if (!Array.isArray(content)) return ''
+  const texts: string[] = []
+  for (const part of content) {
+    if (typeof part !== 'string' && (!part || (part.type && part.type !== 'text'))) return ''
+    const text = partText(part)
+    const previous = texts.at(-1)
+    // Never manufacture a directive or a line boundary by joining fragments.
+    if (previous !== undefined && !previous.endsWith('\n') && !text.startsWith('\n')) return ''
+    texts.push(text)
+  }
+  return texts.join('')
+}
