diff --git a/hermes_cli/plugins_update_policy.py b/hermes_cli/plugins_update_policy.py
new file mode 100644
index 00000000..89738ab2
--- /dev/null
+++ b/hermes_cli/plugins_update_policy.py
@@ -0,0 +1,328 @@
+"""Source-bound, opt-in catalog-only automatic updates using the native transaction.
+
+No arbitrary repositories, dependencies, build hooks, host upgrades or silent fallback.
+An absent policy preserves old native behavior; explicit off overrides unattended apply.
+"""
+from dataclasses import replace
+import hashlib
+import json
+import os
+import re
+import stat
+import threading
+import time
+from urllib.parse import urlsplit
+
+from hermes_cli.plugins_update_policy_store import failure, name_checked, read_policies, write_policy
+
+_started = {}
+_tick_lock = threading.Lock()
+_INTERVAL = 24 * 3600
+_DEP_FILES = ('pyproject.toml', 'setup.py', 'setup.cfg', 'requirements.txt', 'package.json',
+              'package-lock.json', 'pnpm-lock.yaml', 'yarn.lock', '.gitmodules')
+
+
+def _fingerprint(source):
+    return hashlib.sha256(json.dumps(source, sort_keys=True, ensure_ascii=True,
+                                     separators=(',', ':')).encode()).hexdigest()
+
+
+def _trusted_repo(repo):
+    if type(repo) is not str or len(repo) > 2048:
+        return False
+    parts = urlsplit(repo)
+    return (parts.scheme == 'https' and bool(parts.hostname) and not parts.username and not parts.password
+            and not parts.query and not parts.fragment and not any(ord(c) < 33 or c == '\\' for c in repo))
+
+
+def _catalog_entry(name, *, live=False):
+    from hermes_cli.plugin_catalog import get_catalog_entry, get_live_catalog_entry
+    return get_live_catalog_entry(name) if live else get_catalog_entry(name)
+
+
+def _tree_safe(tree):
+    from pm.filesystem import is_junction
+    count = 0
+    total = 0
+    if tree.is_symlink() or is_junction(tree):
+        raise failure('update_policy_linked_tree_refused')
+    for root, dirs, files in os.walk(tree, followlinks=False):
+        for name in dirs + files:
+            path = type(tree)(root) / name
+            count += 1
+            if count > 10000 or path.is_symlink() or is_junction(path):
+                raise failure('update_policy_linked_or_oversize_tree_refused')
+            if '.git' not in path.relative_to(tree).parts:
+                if path.suffix.lower() in ('.jsx', '.ts', '.tsx'):
+                    raise failure('update_policy_build_required')
+                if path.suffix.lower() in ('.js', '.mjs', '.cjs'):
+                    from hermes_cli.plugins_update_syntax import node_binary
+                    node_binary()
+            mode = path.lstat().st_mode
+            if not stat.S_ISDIR(mode):
+                total += path.stat().st_size
+                if not stat.S_ISREG(mode) or total > 64 * 1024 * 1024:
+                    raise failure('update_policy_nonregular_or_oversize_tree_refused')
+
+
+def _dependency_free(tree, manifest):
+    # Even an unchanged local-package build can execute new candidate code via sync_venv.
+    # Refuse the entire declaration class instead of trying to infer harmless scripts.
+    if any((tree / name).exists() or (tree / name).is_symlink() for name in _DEP_FILES):
+        raise failure('update_policy_dependency_review_required')
+    if (tree / 'node_modules').exists() or manifest.get('python_dependencies'):
+        raise failure('update_policy_dependency_review_required')
+
+
+def _source(name):
+    from hermes_cli import plugins_cmd as pc
+    from pm.store import tree_digest
+    target = pc._user_installed_plugin_dir(name)
+    if target is None or target.is_symlink():
+        raise failure('update_policy_install_unavailable')
+    row = pc._read_install_metadata().get(name)
+    block = row.get('catalog') if type(row) is dict else None
+    if type(block) is not dict or not block.get('name') or row.get('pinned') is not True or not block.get('pin'):
+        raise failure('update_policy_catalog_install_required')
+    entry = _catalog_entry(block['name'])
+    if entry is None or entry.tier not in ('official', 'verified') or not _trusted_repo(entry.repo):
+        raise failure('update_policy_trusted_catalog_required')
+    if (block.get('repo') != entry.repo or block.get('tier') != entry.tier
+            or row.get('source') != pc._canonical_source(entry.repo, entry.subdir)
+            or block.get('sha') != row.get('revision') or block.get('pin') != row.get('revision')):
+        raise failure('update_policy_source_changed')
+    _tree_safe(target)
+    manifest = pc._read_manifest(target)
+    if manifest.get('name') != name:
+        raise failure('update_policy_source_changed')
+    _dependency_free(target, manifest)
+    source = {'catalog_name': entry.name, 'repo': entry.repo, 'subdir': entry.subdir, 'tier': entry.tier,
+              'installed_revision': row['revision'], 'installed_digest': tree_digest(target)}
+    return target, source
+
+
+def policy_status(name):
+    name_checked(name)
+    from hermes_cli.plugins_cadence import auto_apply_enabled
+    row = read_policies().get(name)
+    try:
+        _, source = _source(name)
+        eligible, reason = True, ''
+    except Exception:
+        source, eligible, reason = None, False, 'Installed provenance or dependency-free trusted catalog eligibility is unavailable'
+    mode = 'inherit' if row is None else 'enabled' if row['enabled'] else 'disabled'
+    current = bool(row and row['enabled'] and row['last_result'] != 'attempted' and eligible and row['source'] == source)
+    if row and row['enabled'] and not current:
+        reason = ('An attempted update requires inspection and explicit new consent'
+                  if row['last_result'] == 'attempted' else
+                  'Installed source changed; review and explicitly configure again')
+    return {'name': name, 'mode': mode, 'enabled': bool(row and row['enabled']),
+            'effective_auto_apply': auto_apply_enabled() if row is None else current,
+            'revision': row['revision'] if row else 0, 'source_fingerprint': _fingerprint(source),
+            'source': {k: v for k, v in source.items() if k != 'installed_digest'} if source else None,
+            'eligible': eligible, 'reason': reason,
+            'last_result': row['last_result'] if row else None,
+            'startup_check': current, 'check_hours': 24,
+            'notice': ('Future catalog-pinned plugin code may execute. Source approval is not publisher authentication. '
+                       'Dependencies, widened surfaces and host upgrades are not approved. '
+                       'An admitted update is not cancelled by a busy disable request. '
+                       'Existing global checks may still query explicitly disabled plugins.')}
+
+
+def set_policy(name, *, enable, expected_revision, expected_source, confirm):
+    from hermes_cli.plugins_auto_update import plugin_update_lock
+    from hermes_cli import plugins_cmd as pc
+    from hermes_cli.config import is_managed
+    name_checked(name)
+    if (type(enable) is not bool or confirm is not True or type(expected_revision) is not int
+            or not 0 <= expected_revision < 2**53
+            or type(expected_source) is not str or not re.fullmatch('[0-9a-f]{64}', expected_source)):
+        raise failure('invalid_plugin_update_policy')
+    if is_managed():
+        raise failure('update_policy_managed_configuration')
+    target = pc._plugins_dir() / name
+    with plugin_update_lock(target):
+        state = policy_status(name)
+        if state['revision'] != expected_revision or state['source_fingerprint'] != expected_source:
+            raise failure('update_policy_changed')
+        source = _source(name)[1] if enable else None
+        write_policy(name, {'revision': expected_revision + 1, 'enabled': enable, 'source': source,
+                            'last_result': 'configured'})
+        _started.pop((str(pc._plugins_dir()), name), None)
+        return policy_status(name)
+
+
+def _same_identity(left, right):
+    return all(left.get(k) == right.get(k) for k in ('catalog_name', 'repo', 'subdir', 'tier'))
+
+
+def _compatible(spec):
+    if not spec:
+        return
+    from packaging.specifiers import SpecifierSet, InvalidSpecifier
+    from packaging.version import Version, InvalidVersion
+    from hermes_cli.plugins_manifest import running_hermes_version
+    if type(spec) is not str or len(spec) > 512:
+        raise failure('update_policy_host_version_review_required')
+    try:
+        current = Version(running_hermes_version())
+        clauses = [clause.strip() for clause in spec.split(',')]
+        if not all(clauses):
+            raise InvalidSpecifier()
+        normalized = ','.join(c if c[0] in '<>=!' else '>=' + c for c in clauses)
+        if current not in SpecifierSet(normalized):
+            raise InvalidSpecifier()
+    except (InvalidVersion, InvalidSpecifier) as exc:
+        raise failure('update_policy_host_version_review_required') from exc
+
+
+def _static_candidate(manifest, staged):
+    _compatible(manifest.get('requires_hermes', ''))
+    total = 0
+    javascript = 0
+    for path in staged.rglob('*'):
+        if '.git' in path.relative_to(staged).parts or not path.is_file():
+            continue
+        suffix = path.suffix.lower()
+        if suffix not in ('.py', '.js', '.mjs', '.cjs'):
+            continue
+        size = path.stat().st_size
+        total += size
+        if size > 2 * 1024 * 1024 or total > 16 * 1024 * 1024:
+            raise failure('update_policy_validation_capacity')
+        data = path.read_bytes()
+        if suffix != '.py':
+            javascript += 1
+            if javascript > 16:
+                raise failure('update_policy_validation_capacity')
+            from hermes_cli.plugins_update_syntax import check_javascript
+            check_javascript(data, commonjs=suffix == '.cjs')
+            continue
+        try:
+            compile(data, '<plugin candidate>', 'exec', dont_inherit=True)
+        except (SyntaxError, ValueError, UnicodeError) as exc:
+            raise failure('update_policy_candidate_syntax_invalid') from exc
+
+
+def _candidate_guard(name, initial, source, entry, phase, manifest=None, staged=None):
+    if read_policies().get(name) != initial or _source(name)[1] != source:
+        raise failure('update_policy_changed')
+    candidate = {'catalog_name': entry.name, 'repo': entry.repo, 'subdir': entry.subdir, 'tier': entry.tier}
+    _compatible(entry.requires_hermes)
+    if not _same_identity(source, candidate):
+        raise failure('update_policy_source_changed')
+    if staged is not None:
+        _tree_safe(staged)
+        _dependency_free(staged, manifest or {})
+    if manifest is not None:
+        if phase == 'manifest':
+            _static_candidate(manifest, staged)
+        from hermes_cli import plugins_cmd as pc
+        from hermes_cli.plugins_cmd_catalog import plugin_surface, surface_delta
+        target = pc._user_installed_plugin_dir(name)
+        if manifest.get('name') != name or surface_delta(plugin_surface(pc._read_manifest(target), target),
+                                                        plugin_surface(manifest, staged)):
+            raise failure('update_policy_surface_review_required')
+
+
+def apply_policy(name):
+    """Return False for absent policy, otherwise own the unattended outcome/refusal."""
+    from hermes_cli.plugins_auto_update import plugin_update_lock
+    from hermes_cli import plugins_cmd as pc
+    name_checked(name)
+    if name not in read_policies():
+        return False
+    with plugin_update_lock(pc._plugins_dir() / name):
+        initial = read_policies().get(name)
+        if initial is None:
+            return False
+        if not initial['enabled']:
+            raise failure('update_policy_disabled')
+        if initial['last_result'] == 'attempted':
+            raise failure('update_policy_attempt_requires_review')
+        phase = 'checking'
+        try:
+            target, source = _source(name)
+            if source != initial['source']:
+                raise failure('update_policy_source_changed')
+            entry = _catalog_entry(source['catalog_name'], live=True)
+            if entry is not None:
+                entry = replace(entry)  # freeze the selected route/pin away from a mutable catalog cache
+            if (entry is None or entry.tier not in ('official', 'verified')
+                    or not re.fullmatch('[0-9a-f]{40}', entry.sha)):
+                raise failure('update_policy_catalog_unavailable')
+            _candidate_guard(name, initial, source, entry, 'initial')
+            if entry.sha == source['installed_revision']:
+                outcome = 'current'
+            else:
+                from hermes_cli.plugins_transaction import update_plugin
+                from hermes_cli.plugins_cmd_catalog import _local_changes, _carry_user_files
+                local, modified = _local_changes(target)
+                if modified:
+                    raise failure('update_policy_local_edits_require_review')
+                initial = {**initial, 'revision': initial['revision'] + 1, 'last_result': 'attempted'}
+                write_policy(name, initial)
+                def guard(stage, manifest=None, staged=None):
+                    nonlocal phase
+                    _candidate_guard(name, initial, source, entry, stage, manifest, staged)
+                    if stage == 'publication':
+                        phase = 'publication'
+                update_plugin(target, catalog_entry=entry, interactive=False, force=False,
+                              update_guard=guard, dependency_free=True,
+                              carry_user_files=lambda staged: _carry_user_files(target, staged, local))
+                outcome = 'updated'
+            if outcome == 'updated':
+                if read_policies().get(name) != initial:
+                    raise failure('update_policy_changed')
+                published = _source(name)[1]
+                if not _same_identity(source, published) or published['installed_revision'] != entry.sha:
+                    raise failure('update_policy_published_source_unconfirmed')
+                from hermes_cli.plugins_activation import activate_plugin_now
+                activation = activate_plugin_now(name)
+                if (not isinstance(activation, dict) or activation.get('restart_required') is not False
+                        or not activation.get('activation')):
+                    outcome = 'updated_needs_restart'
+            new_source = _source(name)[1]
+            if read_policies().get(name) != initial:
+                raise failure('update_policy_changed')
+            write_policy(name, {'revision': initial['revision'] + 1, 'enabled': outcome != 'updated_needs_restart',
+                                'source': new_source, 'last_result': outcome})
+        except BaseException as exc:
+            outcome = 'outcome_unconfirmed' if phase == 'publication' else 'needs_review'
+            # Never automatically replay a partially completed/unknown update. Preserve only
+            # a fixed diagnostic, not arbitrary git URLs/credential-bearing exception text.
+            if read_policies().get(name) == initial:
+                write_policy(name, {'revision': initial['revision'] + 1, 'enabled': False,
+                                    'source': initial['source'], 'last_result': outcome})
+            if not isinstance(exc, Exception):
+                exc.add_note('Plugin update outcome requires inspection; automatic policy disabled.')
+                raise
+            raise failure(outcome) from exc
+        return True
+
+
+def run_startup_checks(*, now=None):
+    """One boot check per profile/process, then at most daily. Independent of global toggle.
+
+    It never changes global settings. Disabled/absent policies perform no new checks.
+    Calls the same native transaction, not a bespoke git pull or host updater.
+    """
+    from hermes_cli import plugins_cmd as pc
+    now = time.monotonic() if now is None else now
+    if not _tick_lock.acquire(blocking=False):
+        return []
+    results = []
+    try:
+        for name, row in read_policies().items():
+            key = (str(pc._plugins_dir()), name)
+            if not row['enabled'] or row['last_result'] == 'attempted' or (key in _started and now - _started[key] < _INTERVAL):
+                continue
+            _started[key] = now
+            try:
+                apply_policy(name)
+                results.append({'name': name, 'status': policy_status(name)['last_result']})
+            except Exception:
+                results.append({'name': name, 'status': 'needs_review_or_busy'})
+        return results
+    finally:
+        _tick_lock.release()
diff --git a/hermes_cli/plugins_update_policy_store.py b/hermes_cli/plugins_update_policy_store.py
new file mode 100644
index 00000000..6c15a306
--- /dev/null
+++ b/hermes_cli/plugins_update_policy_store.py
@@ -0,0 +1,121 @@
+"""Bounded profile-local per-plugin updater consent; no payloads or credentials."""
+from contextlib import contextmanager
+import json
+import os
+from pathlib import Path
+import re
+import tempfile
+
+_NAME = re.compile(r'^[a-z0-9_-]{1,64}$')
+_DIGEST = re.compile(r'^[0-9a-f]{64}$')
+
+
+def policy_path():
+    from hermes_constants import get_hermes_home
+    return get_hermes_home() / 'plugin-auto-update-policy.json'
+
+
+def failure(reason='update_policy_unavailable'):
+    from hermes_cli.plugins_cmd import PluginOperationError
+    return PluginOperationError(reason)
+
+
+def name_checked(name):
+    if type(name) is not str or not _NAME.fullmatch(name):
+        raise failure('invalid_plugin_update_policy')
+    return name
+
+
+def _unique(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError()
+        result[key] = value
+    return result
+
+
+def read_policies():
+    path = policy_path()
+    if path.is_symlink() or path.parent.is_symlink():
+        raise failure()
+    if not path.exists():
+        return {}
+    try:
+        if path.stat().st_size > 131072:
+            raise ValueError()
+        data = json.loads(path.read_text(), object_pairs_hook=_unique)
+        if type(data) is not dict or set(data) != {'version', 'plugins'} or type(data['version']) is not int or data['version'] != 1:
+            raise ValueError()
+        rows = data['plugins']
+        if type(rows) is not dict or len(rows) > 64:
+            raise ValueError()
+        for name, row in rows.items():
+            name_checked(name)
+            _validate_row(row)
+        return rows
+    except (OSError, ValueError, TypeError, KeyError) as exc:
+        raise failure() from exc
+
+
+def _validate_row(row):
+    if (type(row) is not dict or set(row) != {'revision', 'enabled', 'source', 'last_result'}
+            or type(row['revision']) is not int or not 1 <= row['revision'] < 2**53
+            or type(row['enabled']) is not bool
+            or row['last_result'] not in ('configured', 'current', 'updated', 'needs_review', 'outcome_unconfirmed', 'attempted', 'updated_needs_restart')):
+        raise ValueError()
+    source = row['source']
+    if source is None:
+        if row['enabled']:
+            raise ValueError()
+        return
+    fields = {'catalog_name', 'repo', 'subdir', 'tier', 'installed_revision', 'installed_digest'}
+    if type(source) is not dict or set(source) != fields:
+        raise ValueError()
+    if any(type(v) is not str or len(v) > 2048 for v in source.values()):
+        raise ValueError()
+    if source['tier'] not in ('official', 'verified') or not _DIGEST.fullmatch(source['installed_digest']):
+        raise ValueError()
+    if not re.fullmatch('[0-9a-f]{40}', source['installed_revision']):
+        raise ValueError()
+
+
+@contextmanager
+def policy_write_lock():
+    from hermes_cli.auth import _file_lock
+    from hermes_cli.plugins_auto_update import _holder
+    lock = policy_path().with_suffix('.lock')
+    if lock.is_symlink():
+        raise failure()
+    with _file_lock(lock, _holder(str(lock)), 1.0, 'plugin update policy busy'):
+        yield
+
+
+def write_policy(name, row):
+    """Called while native per-plugin update lock is held; lock ordering plugin→policy."""
+    with policy_write_lock():
+        rows = read_policies()
+        if name not in rows and len(rows) >= 64:
+            raise failure('update_policy_capacity')
+        _validate_row(row)
+        rows[name] = row
+        raw = json.dumps({'version': 1, 'plugins': rows}, sort_keys=True, ensure_ascii=True, allow_nan=False)
+        if len(raw.encode()) > 131072:
+            raise failure('update_policy_capacity')
+        path = policy_path()
+        path.parent.mkdir(parents=True, exist_ok=True)
+        fd, temp = tempfile.mkstemp(prefix='.plugin-update-policy-', dir=path.parent)
+        try:
+            with os.fdopen(fd, 'w') as stream:
+                stream.write(raw)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temp, path)
+            if os.name != 'nt':
+                directory = os.open(path.parent, os.O_RDONLY)
+                try:
+                    os.fsync(directory)
+                finally:
+                    os.close(directory)
+        finally:
+            Path(temp).unlink(missing_ok=True)
