+        const slot=r.slots.find(s=>s.role===expected.selection.role),old=expected.status.slots.find(s=>s.role===expected.selection.role)
+        if(!slot||slot.version!==(old?.version??0)+1||slot.active===expected.revoke||slot.provider!==expected.selection.provider||slot.model!==expected.selection.model||new URL(slot.endpoint).href!==new URL(expected.selection.endpoint).href)throw Error()
+        setStatus(r)
+      }
+    }catch{if(valid())setError('Enrollment outcome is uncertain. The input has been cleared. Refresh metadata before deciding what to do; this action will not retry automatically.')}
+    finally{inFlight.current=false;if(valid())setBusy(false)}
+  }
+  return <section aria-label="Dedicated model credentials" className="mt-6 grid gap-3 rounded border p-4">
+    <h3>Dedicated model credentials</h3>
+    <p>Host-owned storage for search and organizer roles. Saving does not enable model calls, approve external processing, or change your chat model. Dispatch remains unavailable.</p>
