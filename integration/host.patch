index 00000000..3144fe85
--- /dev/null
+++ b/gateway/session_model_credentials.py
@@ -0,0 +1,109 @@
+"""Interactive native enrollment only. No model/plugin tool and no secret read API.
+
+Interactive grants are not proof of a human click. Trusted local code shares process
+and renderer authority; encryption at rest is not a sandbox against that code.
+"""
+from dataclasses import asdict
+from functools import partial
+
+from hermes_state_runtime import RuntimeStoreError
+from gateway import model_credential_storage as store
+
+
+def handlers(connection):
+    return {f'model_credentials.{op}': partial(invoke,connection,op) for op in ('status','set','revoke')}
+
+
+def _context(owner):
+    return store.digest(['model-credentials-v1',asdict(owner)])
+
+
+def _status(owner,data,mode):
+    slots=[dict(role=role,**{k:v for k,v in row.items() if k!='secret'}) for role,row in sorted(data['slots'].items())]
+    return dict(revision=data['revision'],context_key=_context(owner),slots=slots,
+                dispatch_supported=False,key_storage=mode,scope='profile_principal')
+
+
+def _mutate(owner,data,op,params):
+    role=params.get('role')
+    if (role not in ('search','organizer') or type(role) is not str or params.get('confirm') is not True
+            or type(params.get('expected_revision')) is not int
+            or params['expected_revision']!=data['revision'] or params.get('expected_context')!=_context(owner)):
+        store.fail('model_credentials_changed')
+    if data['revision']>=2**53-1:
+        store.fail('model_credentials_capacity')
+    old=data['slots'].get(role)
+    version=(old['version'] if old else 0)+1
+    if op=='set':
+        values=store.route(params.get('provider'),params.get('model'),params.get('endpoint'))
+        store.validate_secret(params.get('secret'))
+        data['slots'][role]=dict(values,version=version,active=True,secret=params['secret'])
+    else:
+        if old is None or not old['active']:
+            store.fail('model_credentials_changed')
+        data['slots'][role]=dict(old,version=version,active=False,secret=None)
+    data['revision']+=1
+
+
+def _transaction(connection,ref,op,params):
+    from gateway.session_authorities import require_serving
+    from gateway.session_memory_owner import _receipt_owner
+    authority,actor=connection.authority,connection.actor
+    db=authority.db
+    write=op!='status'
+    committed=False
+    try:
+        with db._lock:
+            require_serving(authority)
+            db._raise_if_db_corrupt(storage=True)
+            db._raise_if_db_replaced()
+            if db._conn is None or db._conn.in_transaction or (write and db.read_only):
+                store.fail()
+            conn=db._conn
+            conn.execute('BEGIN IMMEDIATE' if write else 'BEGIN')
+            try:
+                owner=_receipt_owner(authority,actor,ref,None,conn)
+                mode=store.policy()
+                data=store.load(conn,owner,mode)
+                first=data['revision']==0
+                if write:
+                    _mutate(owner,data,op,params)
+                    store.save(conn,owner,mode,data,first=first)
+                result=_status(owner,data,mode)
+                require_serving(authority)
+                db._raise_if_db_replaced()
+                if _receipt_owner(authority,actor,ref,None,conn)!=owner:
+                    store.fail('model_credentials_changed')
+                if write:
+                    committed=True
+                    conn.commit()
+                    require_serving(authority)
+                    db._raise_if_db_replaced()
+                return result
+            finally:
+                if conn.in_transaction:
+                    conn.rollback()
+    except Exception:
+        if committed:
+            store.fail('model_credentials_outcome_unconfirmed')
+        raise
+
+
+async def invoke(connection,op,ref,params):
+    from gateway.runtime_bootstrap import _PURPOSE_CAPABILITIES
+    from gateway.session_authorities import owner_scope
+    try:
+        actor=connection.actor
+        if (actor.profile_id!=connection.authority.profile_id or ref.profile_id!=actor.profile_id
+                or not _PURPOSE_CAPABILITIES['interactive']<=frozenset(actor.capabilities)
+                or not ref.session_id):
+            store.fail('permission_denied')
+        connection.authority.authorize(actor,ref,'session:control')
+        with owner_scope(connection.authority):
+            return _transaction(connection,ref,op,params)
+    except RuntimeStoreError as exc:
+        allowed={'permission_denied','invalid_params','model_credentials_changed',
+                 'model_credentials_capacity','model_credentials_outcome_unconfirmed'}
+        raise RuntimeStoreError(exc.reason if exc.reason in allowed else 'model_credentials_unavailable') from None
+    except Exception:
+        raise RuntimeStoreError('model_credentials_unavailable') from None
