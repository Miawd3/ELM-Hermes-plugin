+import './message-importance.css'
+import { useAuiState } from '@assistant-ui/react'
+import { useContributions } from '@/contrib/react/use-contributions'
+import { transcriptImportance, TRANSCRIPT_IMPORTANCE_AREA } from '@/lib/transcript-importance'
+import { messageContentText } from './content'
+
+/** Tiny selector leaf: streaming text does not subscribe/rerender message roots. */
+export function MessageImportance() {
+  const policies = useContributions(TRANSCRIPT_IMPORTANCE_AREA)
+  const label = useAuiState(state => transcriptImportance(policies, state.message.role, messageContentText(state.message.content)))
