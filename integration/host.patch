@@ -0,0 +1,57 @@
+"""Opt-in ephemeral memory on one primary request copy; never transcript/prefetch state."""
+from copy import deepcopy
+import json
+
+
+def request_memory_messages(agent, api_messages, tools, approx_tokens, moa_prepared=None):
+    """Return (request-only messages, changed). No auxiliary callers use this helper.
+
+    Native retry builds invoke this anew. SDK retries of an already-dispatched
+    logical request retain its bytes; disabling cannot retract those copies.
+    """
+    manager = getattr(agent, '_memory_manager', None)
+    if (manager is None or getattr(manager, '_agent_context', None) != 'primary'
+            or getattr(agent, '_persist_disabled', False) or getattr(agent, 'is_subagent', False)
+            or getattr(agent, '_parent_session_id', None) or getattr(agent, 'side_agent', False)
+            or getattr(agent, '_interrupt_requested', False)
+            or getattr(agent, 'memory_agent_context', None) not in (None, 'primary')
+            or getattr(agent, 'platform', None) in ('cron', 'subagent', 'background', 'flush')
+            or getattr(agent, 'api_mode', None) != 'chat_completions'
+            or getattr(agent, 'provider', None) == 'moa' or moa_prepared is not None
+            or getattr(agent, '_scoped_memory_moa_active', False)
+            or not manager._owner_allows('request_context')):
+        return api_messages, False
+    try:
+        # Remote image/audio/video token costs are not conservatively represented
+        # by serialized bytes. This first lane supports text-only requests.
+        for message in api_messages:
+            content = message.get('content')
+            if isinstance(content, list) and any(not isinstance(part, dict) or part.get('type') != 'text' for part in content):
+                return api_messages, False
+        from gateway.session_memory_turn import check_admitted_memory_turn
+        check_admitted_memory_turn()
+        providers = [p for p in manager.providers if getattr(p, 'request_memory_contract', None) == 1]
+        if len(providers) != 1:
+            return api_messages, False
+        packet = providers[0].request_context(session_id=agent.session_id)
+        if type(packet) is not str or not packet or len(packet.encode('utf-8')) > 16384:
+            return api_messages, False
+        # Conservative byte-based upper reserve, NOT a token measurement. Include
+        # current tools/framing/output; omit recall when window/headroom is unknown.
+        compressor = getattr(agent, 'context_compressor', None)
+        window = getattr(compressor, 'context_length', None)
+        reserve = getattr(agent, 'max_tokens', None)
+        if type(window) is not int or window <= 0 or type(reserve) is not int or reserve <= 0:
+            return api_messages, False
+        base = len(json.dumps([api_messages, tools], ensure_ascii=False, default=str).encode('utf-8'))
+        pressure = max(base, int(approx_tokens or 0)) + len(packet.encode('utf-8')) + reserve + 2048
+        if pressure >= window:
+            return api_messages, False
+        check_admitted_memory_turn()
+        copied = deepcopy(api_messages)
+        # A request-only user-role data message, not a system instruction and not
+        # the legacy authoritative memory wrapper. JSON preserves structural data boundaries; it does not make malicious text harmless.
+        copied.append({'role': 'user', 'content': packet})
+        return copied, True
+    except Exception:
+        return api_messages, False
