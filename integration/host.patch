+ it('stale owner refuses staged mutation',async()=>{let current=true;const request=await setup(undefined,()=>current);stage();fireEvent.change(screen.getByLabelText('Secret key'),{target:{value:'synthetic-fixture-only'}});current=false;fireEvent.click(screen.getByText('Confirm enrollment'));expect(request).toHaveBeenCalledTimes(1)})
