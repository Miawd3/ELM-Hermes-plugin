+"""The opt-in local-memory gate does not mount or repair native sessions."""
+from dataclasses import asdict
+import pytest
+from gateway.session_plugin_rpc import call_plugin_rpc
+from hermes_cli.plugin_memory import memory_owner, publish_memory
+from hermes_cli.plugin_rpc import _LocalMemoryReadHandler
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway.test_local_authority_transitions import local_session
+
+
+def dump(db):
+    with db._read_ctx() as conn:
+        return tuple(conn.iterdump())
+
+
+@pytest.mark.asyncio
+async def test_cold_read_ingress_no_native_mutation_or_mount(tmp_path, monkeypatch):
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    try:
+        owner.sessions.pop(ref.session_id)
+        before = dump(owner.db)
+        def inspect(params, **kw):
+            snapshot = memory_owner()
+            with pytest.raises(RuntimeStoreError, match='memory_publication_unavailable'):
+                publish_memory(snapshot, lambda: pytest.fail('read handler cannot publish'))
+            return asdict(snapshot)
+        result = await call_plugin_rpc(connection, ref, 'plugin.demo.read', _LocalMemoryReadHandler(inspect), {})
+        assert result['canonical_session_id'] == ref.session_id
+        assert dump(owner.db) == before
+        assert ref.session_id not in owner.sessions
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+async def test_bad_profile_refuses_before_handler_without_mutation(tmp_path, monkeypatch):
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    try:
+        before = dump(owner.db)
+        handler = _LocalMemoryReadHandler(lambda *a, **k: pytest.fail('unauthorized handler'))
+        with pytest.raises(RuntimeStoreError):
+            await call_plugin_rpc(connection, ref, 'plugin.demo.read', handler, {'profile': 123})
+        assert dump(owner.db) == before
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+async def test_read_capability_suffices_without_control(tmp_path, monkeypatch):
+    from dataclasses import replace
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    try:
+        connection.actor = replace(connection.actor, capabilities=frozenset({'session:read'}))
+        handler = _LocalMemoryReadHandler(lambda *a, **k: asdict(memory_owner()))
+        result = await call_plugin_rpc(connection, ref, 'plugin.demo.read', handler, {})
+        assert result['canonical_session_id'] == ref.session_id
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+async def test_untracked_compression_is_not_adopted_by_ingress(tmp_path, monkeypatch):
+    from tests.gateway.test_local_receipt_untracked_compression import _compact_like_0_22_2
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    try:
+        _compact_like_0_22_2(owner.db, ref.session_id, 'untracked-child')
+        owner.sessions.pop(ref.session_id)
+        before = dump(owner.db)
+        handler = _LocalMemoryReadHandler(lambda *a, **k: pytest.fail('invalid owner reached handler'))
+        with pytest.raises(RuntimeStoreError):
+            await call_plugin_rpc(connection, ref, 'plugin.demo.read', handler, {})
+        assert dump(owner.db) == before
+        assert not owner.sessions
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+async def test_control_rpc_can_publish_once_via_public_api(tmp_path, monkeypatch):
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    effects = []
+    try:
+        def handler(*a, **k):
+            expected = memory_owner()
+            return publish_memory(expected, lambda: effects.append('written') or 'done')
+        result = await call_plugin_rpc(connection, ref, 'plugin.demo.publish', handler, {})
+        assert result == 'done'
+        assert effects == ['written']
+        with pytest.raises(RuntimeStoreError, match='memory_publication_unavailable'):
+            publish_memory(None, lambda: effects.append('escaped'))
+        assert effects == ['written']
+    finally:
+        await connection.close()
+        owner.db.close()
