diff --git a/gateway/session_memory_binding.py b/gateway/session_memory_binding.py
new file mode 100644
index 00000000..0fa161c2
--- /dev/null
+++ b/gateway/session_memory_binding.py
@@ -0,0 +1,60 @@
+"""Explicit per-principal project selection; never infer authority from cwd or sidebar."""
+from contextlib import nullcontext
+
+from gateway.session_memory_owner import MemoryOwner, _receipt_owner
+from gateway.session_memory_publication import _validate_publication
+from gateway.session_memory_projects import project_catalog, project_fingerprint, write_project_binding
+from hermes_state_runtime import RuntimeStoreError
+
+
+def bind_memory_project(authority, actor, ref, expected, project_id, *, check_context=None):
+    """CAS stored binding under catalog-then-state writer locks; None explicitly unbinds.
+
+    The catalog is only read/locked, never modified; only the state transaction commits.
+    Archived/deleted old bindings can be cleared without opening the catalog. A selection
+    does not establish a project-wide ACL: principal remains part of every memory key.
+    """
+    if type(expected) is not MemoryOwner or type(expected.version) is not int or expected.version != 1:
+        raise RuntimeStoreError('invalid_params')
+    if project_id is not None and (not isinstance(project_id, str) or not project_id):
+        raise RuntimeStoreError('invalid_params')
+    from gateway.session_authorities import require_serving
+    catalog_scope = project_catalog(authority, write=True) if project_id is not None else nullcontext(None)
+    db = authority.db
+    commit_started = False
+    try:
+        with catalog_scope as catalog, db._lock:
+            fingerprint = project_fingerprint(catalog, project_id) if project_id is not None else None
+            db._raise_if_db_corrupt(storage=True)
+            db._raise_if_db_replaced()
+            if db.read_only or db._conn is None or db._conn.in_transaction:
+                raise RuntimeStoreError('runtime_coordination_required')
+            conn = db._conn
+            conn.execute('BEGIN IMMEDIATE')
+            try:
+                _validate_publication(authority, actor, ref, expected, expected.authority_epoch, conn)
+                if check_context is not None:
+                    check_context()
+                write_project_binding(conn, expected.canonical_session_id, expected.principal_id,
+                                      project_id, fingerprint, expected_revision=expected.project_revision)
+                result = _receipt_owner(authority, actor, ref, None, conn)
+                if check_context is not None:
+                    check_context()
+                db._raise_if_db_replaced()
+                require_serving(authority)
+                commit_started = True
+                conn.commit()
+                require_serving(authority)
+                if check_context is not None:
+                    check_context()
+                db._raise_if_db_replaced()
+                return result
+            finally:
+                if conn.in_transaction:
+                    conn.rollback()
+    except BaseException as exc:
+        if commit_started:
+            if isinstance(exc, Exception):
+                raise RuntimeStoreError('memory_binding_uncertain', detail='Read current binding before retry.') from exc
+            exc.add_note('Memory binding may have committed; read current binding before retry.')
+        raise
diff --git a/gateway/session_memory_context.py b/gateway/session_memory_context.py
new file mode 100644
index 00000000..6a29cd61
--- /dev/null
+++ b/gateway/session_memory_context.py
@@ -0,0 +1,88 @@
+"""Short-lived authenticated context for plugin memory inspection, never a durable grant."""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+
+from hermes_state_runtime import RuntimeStoreError
+
+
+@dataclass
+class _Scope:
+    authority: object
+    actor: object
+    ref: object
+    active: bool = True
+    read_only: bool = False
+    validate: object = None
+
+
+_current = ContextVar('plugin_memory_scope', default=None)
+
+
+@contextmanager
+def bind_memory_context(authority, actor, ref, *, read_only=False, validate=None):
+    """Core-only ingress binding after RPC authorization or a validated admission claim."""
+    scope = _Scope(authority, actor, ref, read_only=read_only, validate=validate)
+    token = _current.set(scope)
+    try:
+        yield
+    finally:
+        scope.active = False
+        _current.reset(token)
+
+
+def current_memory_owner(*, version=1, alias=None):
+    """Resolve again against the bound actor; a snapshot is not permission to publish."""
+    if type(version) is not int or version != 1:
+        raise RuntimeStoreError('unsupported_memory_contract')
+    scope = _current.get()
+    if scope is None or not scope.active or not scope.ref.session_id:
+        raise RuntimeStoreError('memory_context_unavailable')
+    if scope.validate is not None:
+        scope.validate()
+    from gateway.session_memory_owner import resolve_memory_owner
+    result = resolve_memory_owner(scope.authority, scope.actor, scope.ref, alias=alias)
+    if scope.validate is not None:
+        scope.validate()
+    if not scope.active:
+        raise RuntimeStoreError('memory_context_unavailable')
+    return result
+
+
+def publish_current_memory(expected, publish):
+    """Nonreplaying bounded publication in the active control RPC; never a read RPC."""
+    scope = _current.get()
+    if scope is None or not scope.active or scope.read_only or not scope.ref.session_id:
+        raise RuntimeStoreError('memory_publication_unavailable')
+    from gateway.session_memory_publication import publish_memory
+    def check_context():
+        if not scope.active or scope.read_only:
+            raise RuntimeStoreError('memory_publication_unavailable')
+    return publish_memory(scope.authority, scope.actor, scope.ref, expected, publish,
+                          check_context=check_context)
+
+
+def bind_current_project(expected, project_id):
+    scope = _current.get()
+    if scope is None or not scope.active or scope.read_only or not scope.ref.session_id:
+        raise RuntimeStoreError('memory_publication_unavailable')
+    def check_context():
+        if not scope.active or scope.read_only:
+            raise RuntimeStoreError('memory_publication_unavailable')
+    from gateway.session_memory_binding import bind_memory_project
+    return bind_memory_project(scope.authority, scope.actor, scope.ref, expected, project_id,
+                               check_context=check_context)
+
+
+def read_current_memory(expected, read):
+    scope = _current.get()
+    if scope is None or not scope.active or not scope.ref.session_id:
+        raise RuntimeStoreError('memory_context_unavailable')
+    def check_context():
+        if scope.validate is not None:
+            scope.validate()
+        if not scope.active:
+            raise RuntimeStoreError('memory_context_unavailable')
+    from gateway.session_memory_read import read_memory
+    return read_memory(scope.authority, scope.actor, scope.ref, expected, read,
+                       check_context=check_context)
