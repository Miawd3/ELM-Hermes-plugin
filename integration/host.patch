diff --git a/gateway/session_chat_folders.py b/gateway/session_chat_folders.py
new file mode 100644
index 00000000..864c026c
--- /dev/null
+++ b/gateway/session_chat_folders.py
@@ -0,0 +1,277 @@
+"""Bounded logical chat filing. Only state_meta changes; no workspace or memory grants.
+
+Native ingress supplies identity. A folder never authorizes a session read. Returned
+member IDs are individually resolved again and the UI must intersect authorized rows.
+"""
+from dataclasses import asdict
+import hashlib
+import json
+import math
+import re
+import unicodedata
+import uuid
+
+from gateway.session_contract import SessionRef
+from gateway.session_memory_owner import _receipt_owner
+from hermes_state_runtime import RuntimeStoreError
+
+_PREFIX = 'gateway.chat_folders.v1:'
+_MAX_BYTES = 131072
+_ID = re.compile(r'^folder_[0-9a-f]{32}$')
+
+
+def _hash(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=True,
+                                     separators=(',', ':'), allow_nan=False).encode()).hexdigest()
+
+
+def _label(value):
+    if (type(value) is not str or not value.strip() or value != value.strip()
+            or len(value) > 80 or any(unicodedata.category(c).startswith('C') for c in value)):
+        raise RuntimeStoreError('invalid_params')
+    return value
+
+
+def _incarnation(conn, sid):
+    from gateway.session_memory_projects import _owner_incarnation
+    return _owner_incarnation(conn, sid)
+
+
+def _key(owner):
+    return _PREFIX + _hash([owner.profile_id, owner.principal_id])
+
+
+def _unique_fields(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError()
+        result[key] = value
+    return result
+
+
+def _load(conn, owner):
+    row = conn.execute('SELECT value FROM state_meta WHERE key=?', (_key(owner),)).fetchone()
+    if row is None:
+        return {'version': 1, 'revision': 0, 'folders': {}, 'members': {}, 'undo': None}
+    try:
+        if len(row[0].encode()) > _MAX_BYTES:
+            raise ValueError()
+        data = json.loads(row[0], object_pairs_hook=_unique_fields)
+        _validate(data)
+        return data
+    except (ValueError, TypeError, KeyError, AttributeError) as exc:
+        raise RuntimeStoreError('chat_folders_storage_unavailable') from exc
+
+
+def _validate(data):
+    if (type(data) is not dict or set(data) != {'version', 'revision', 'folders', 'members', 'undo'}
+            or type(data['version']) is not int or data['version'] != 1
+            or type(data['revision']) is not int or not 0 <= data['revision'] < 2**53
+            or type(data['folders']) is not dict or len(data['folders']) > 32
+            or type(data['members']) is not dict or len(data['members']) > 256):
+        raise ValueError()
+    for fid, label in data['folders'].items():
+        if not _ID.fullmatch(fid):
+            raise ValueError()
+        try:
+            _label(label)
+        except RuntimeStoreError as exc:
+            raise ValueError() from exc
+    for sid, member in data['members'].items():
+        if (type(sid) is not str or not sid or len(sid) > 512
+                or type(member) is not dict or set(member) != {'folder_id', 'incarnation'}
+                or member['folder_id'] not in data['folders']
+                or type(member['incarnation']) not in (int, float)
+                or not math.isfinite(member['incarnation'])):
+            raise ValueError()
+    undo = data['undo']
+    if undo is not None:
+        if (type(undo) is not dict or set(undo) != {'session_id', 'incarnation', 'before', 'after', 'revision'}
+                or type(undo['session_id']) is not str or not undo['session_id']
+                or len(undo['session_id']) > 512
+                or type(undo['incarnation']) not in (int, float) or not math.isfinite(undo['incarnation'])
+                or type(undo['revision']) is not int or undo['revision'] != data['revision']
+                or undo['before'] == undo['after']):
+            raise ValueError()
+        for value in (undo['before'], undo['after']):
+            if value is not None and value not in data['folders']:
+                raise ValueError()
+        member = data['members'].get(undo['session_id'])
+        if (member['folder_id'] if member else None) != undo['after']:
+            raise ValueError()
+        if member and member['incarnation'] != undo['incarnation']:
+            raise ValueError()
+
+
+def _member_owner(authority, actor, conn, sid, member):
+    try:
+        if _incarnation(conn, sid) != member['incarnation']:
+            return None
+        owner = _receipt_owner(authority, actor, SessionRef(authority.profile_id, sid), None, conn)
+        return owner if owner.canonical_session_id == sid else None
+    except RuntimeStoreError:
+        # Stale/deleted/foreign/unresolved rows do not leak aliases or gain membership.
+        return None
+
+
+def _context(owner):
+    return _hash(['chat-folders-v1', asdict(owner)])
+
+
+def _status(authority, actor, conn, owner, data):
+    members = []
+    for sid, member in data['members'].items():
+        resolved = _member_owner(authority, actor, conn, sid, member)
+        if resolved is not None:
+            members.append({'session_id': sid, 'aliases': list(resolved.aliases), 'folder_id': member['folder_id']})
+    sid = owner.canonical_session_id
+    current = next((m['folder_id'] for m in members if m['session_id'] == sid), None)
+    undo = data['undo']
+    undo_available = bool(undo and undo['session_id'] == sid
+                          and undo['incarnation'] == _incarnation(conn, sid))
+    result = {'version': 1, 'revision': data['revision'], 'context_key': _context(owner),
+            'scope_key': _hash([owner.profile_id, owner.principal_id]),
+            'current_session_id': sid, 'current_aliases': list(owner.aliases),
+            'current_folder_id': current,
+            'folders': [{'id': fid, 'label': label,
+                         'removable': not any(m['folder_id'] == fid for m in data['members'].values())}
+                        for fid, label in data['folders'].items()],
+            'members': members, 'unavailable_members': len(data['members']) - len(members),
+            'undo_available': undo_available}
+    if len(json.dumps(result, ensure_ascii=True).encode()) > _MAX_BYTES:
+        raise RuntimeStoreError('chat_folders_capacity')
+    return result
+
+
+def _mutate(conn, owner, data, operation, value):
+    sid = owner.canonical_session_id
+    incarnation = _incarnation(conn, sid)
+    if operation == 'create':
+        label = _label(value)
+        if len(data['folders']) >= 32:
+            raise RuntimeStoreError('chat_folders_capacity')
+        if label in data['folders'].values():
+            raise RuntimeStoreError('chat_folder_label_exists')
+        fid = 'folder_' + uuid.uuid4().hex
+        if fid in data['folders']:
+            raise RuntimeStoreError('chat_folders_storage_unavailable')
+        data['folders'][fid] = label
+        data['undo'] = None
+    elif operation in ('rename', 'remove'):
+        fid = value.get('folder_id') if type(value) is dict else value
+        if type(fid) is not str or fid not in data['folders']:
+            raise RuntimeStoreError('chat_folder_not_found')
+        if operation == 'rename':
+            if type(value) is not dict or set(value) != {'folder_id', 'label'}:
+                raise RuntimeStoreError('invalid_params')
+            label = _label(value['label'])
+            if data['folders'][fid] == label:
+                raise RuntimeStoreError('chat_folder_unchanged')
+            if label in data['folders'].values():
+                raise RuntimeStoreError('chat_folder_label_exists')
+            data['folders'][fid] = label
+        else:
+            if type(value) is not str:
+                raise RuntimeStoreError('invalid_params')
+            # Count every stored membership, even if hidden, stale or unloaded.
+            # Removing a label must never unfile or delete any chat implicitly.
+            if any(m['folder_id'] == fid for m in data['members'].values()):
+                raise RuntimeStoreError('chat_folder_not_empty')
+            del data['folders'][fid]
+        # Folder-management operations invalidate prior filing undo receipts.
+        data['undo'] = None
+    else:
+        member = data['members'].get(sid)
+        if member and member['incarnation'] != incarnation:
+            raise RuntimeStoreError('chat_folder_incarnation_changed')
+        before = member['folder_id'] if member else None
+        if operation == 'undo':
+            undo = data['undo']
+            if not undo or undo['session_id'] != sid or undo['incarnation'] != incarnation:
+                raise RuntimeStoreError('chat_folder_undo_unavailable')
+            value = undo['before']
+        if value is not None and (type(value) is not str or value not in data['folders']):
+            raise RuntimeStoreError('chat_folder_not_found')
+        if value == before:
+            raise RuntimeStoreError('chat_folder_unchanged')
+        if value is None:
+            data['members'].pop(sid, None)
+        else:
+            if sid not in data['members'] and len(data['members']) >= 256:
+                raise RuntimeStoreError('chat_folders_capacity')
+            data['members'][sid] = {'folder_id': value, 'incarnation': incarnation}
+        data['undo'] = (None if operation == 'undo' else
+                        {'session_id': sid, 'incarnation': incarnation, 'before': before,
+                         'after': value, 'revision': data['revision'] + 1})
+    data['revision'] += 1
+    _validate(data)
+    raw = json.dumps(data, ensure_ascii=True, separators=(',', ':'), allow_nan=False)
+    if len(raw.encode()) > _MAX_BYTES:
+        raise RuntimeStoreError('chat_folders_capacity')
+    conn.execute('INSERT INTO state_meta(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value',
+                 (_key(owner), raw))
+
+
+def chat_folders(authority, actor, ref, *, operation='status', value=None,
+                 expected_context=None, expected_revision=None, check_context=None):
+    """Single native snapshot/transaction; no callback retries, no external effects.
+
+    Metadata is independent of selected project's current catalog eligibility. Native
+    canonical ownership is still validated. A commit-then-retirement failure is uncertain:
+    refresh status rather than automatically replaying a write.
+    """
+    from gateway.session_authorities import require_serving
+    if operation not in ('status', 'create', 'file', 'undo', 'rename', 'remove'):
+        raise RuntimeStoreError('invalid_params')
+    write = operation != 'status'
+    if actor.profile_id != authority.profile_id or ref.profile_id != authority.profile_id:
+        raise RuntimeStoreError('profile_mismatch')
+    needed = {'session:read', 'session:control'} if write else {'session:read'}
+    if not needed.issubset(actor.capabilities):
+        raise RuntimeStoreError('permission_denied')
+    if write and (type(expected_revision) is not int or expected_revision < 0
+                  or type(expected_context) is not str or not re.fullmatch('[0-9a-f]{64}', expected_context)):
+        raise RuntimeStoreError('invalid_params')
+    db = authority.db
+    committed = False
+    try:
+        with db._lock:
+            require_serving(authority)
+            db._raise_if_db_corrupt(storage=True)
+            db._raise_if_db_replaced()
+            if db._conn is None or db._conn.in_transaction or (write and db.read_only):
+                raise RuntimeStoreError('runtime_coordination_required')
+            conn = db._conn
+            conn.execute('BEGIN IMMEDIATE' if write else 'BEGIN')
+            try:
+                if check_context is not None:
+                    check_context()
+                owner = _receipt_owner(authority, actor, ref, None, conn)
+                data = _load(conn, owner)
+                if write:
+                    if expected_context != _context(owner) or expected_revision != data['revision']:
+                        raise RuntimeStoreError('chat_folders_changed')
+                    _mutate(conn, owner, data, operation, value)
+                result = _status(authority, actor, conn, owner, data)
+                require_serving(authority)
+                db._raise_if_db_replaced()
+                if check_context is not None:
+                    check_context()
+                if write:
+                    committed = True
+                    conn.commit()
+                    require_serving(authority)
+                    db._raise_if_db_replaced()
+                    if check_context is not None:
+                        check_context()
+                return result
+            finally:
+                if conn.in_transaction:
+                    conn.rollback()
+    except BaseException as exc:
+        if committed:
+            if isinstance(exc, Exception):
+                raise RuntimeStoreError('chat_folders_uncertain', detail='Refresh folder status before any retry.') from exc
+            exc.add_note('Chat folder change may have committed; refresh before retry.')
+        raise
