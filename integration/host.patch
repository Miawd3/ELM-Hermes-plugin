+      {(['provider','model','endpoint'] as const).map(field=><label key={field}>{field}<input aria-label={field} value={selection[field]} disabled={busy} maxLength={field==='endpoint'?256:field==='model'?128:64} onChange={e=>{setReview(null);setSelection({...selection,[field]:e.target.value})}} /></label>)}
