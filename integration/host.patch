new file mode 100644
index 00000000..0e01ad4a
--- /dev/null
+++ b/gateway/session_memory_owner.py
@@ -0,0 +1,115 @@
+"""Read-only v1 memory ownership for already canonical local conversations.
+
+The caller supplies an authenticated actor, not client-authored identity fields. This
+snapshot is neither authentication nor permission to publish a later memory write.
+"""
+from dataclasses import dataclass
+import json
+import sqlite3
+
+from hermes_state_runtime import RuntimeStoreError
+
+
+@dataclass(frozen=True)
+class MemoryOwner:
+    version: int
+    profile_id: str
+    principal_id: str
+    canonical_session_id: str
+    physical_session_id: str
+    aliases: tuple[str, ...]
+    revision: int
+    authority_epoch: int
+    project_id: str | None = None
+    project_revision: int = 0
+    project_fingerprint: str | None = None
+
+
+def _receipt_owner(authority, actor, ref, alias, conn):
+    from gateway.owner_identity import same_owner
+    from hermes_state_local import POLICY_PREFIX, local_lineage_owner
+    from hermes_state_local_lineage import validate_local_lineage
+
+    from hermes_state_runtime import _epoch
+    _epoch(conn, authority.epoch)
+    owner = local_lineage_owner(conn, ref.session_id)
+    stored = conn.execute('SELECT value FROM state_meta WHERE key=?', (POLICY_PREFIX + owner,)).fetchone()
+    if stored is None:
+        raise RuntimeStoreError('not_found')
+    receipt = json.loads(stored[0])
+    if receipt['session_id'] != owner:
+        raise RuntimeStoreError('storage_unavailable')
+    if not same_owner(receipt['principal_id'], actor.subject):
+        raise RuntimeStoreError('permission_denied')
+    # Native validator proves deterministic identity (or the exact legacy adoption
+    # receipt) and every reset/compression edge. Unadopted compressions fail closed.
+    tip = validate_local_lineage(conn, receipt)
+    lineage = tuple(receipt.get('lineage', [owner]))
+    if ref.session_id not in lineage or (alias is not None and alias not in lineage):
+        raise RuntimeStoreError('permission_denied')
+    revision = _validate_route_rows(authority, conn, receipt, owner, tip, lineage)
+    from gateway.session_memory_projects import read_project_binding
+    binding = read_project_binding(conn, owner, receipt['principal_id'])
+    if binding is not None and binding.principal_id != receipt['principal_id']:
+        raise RuntimeStoreError('permission_denied')
+    return MemoryOwner(1, authority.profile_id, receipt['principal_id'], owner, tip, lineage,
+                       revision, authority.epoch,
+                       binding.project_id if binding else None,
+                       binding.revision if binding else 0,
+                       binding.fingerprint if binding else None)
+
+
+def _validate_route_rows(authority, conn, receipt, owner, tip, lineage):
+    from gateway.session import SessionEntry
+    from gateway.session_local_recovery import local_source
+
+    source = local_source(authority, owner, receipt['principal_id'])
+    route = authority.runner.session_store._generate_session_key(source)
+    entry = SessionEntry.from_dict(receipt['entry'])
+    if 'profile' not in receipt['entry']['origin']:
+        entry.origin.profile = source.profile
+    if receipt['route'] != route or entry.session_key != route or entry.origin.to_dict() != source.to_dict():
+        raise RuntimeStoreError('storage_unavailable')
+    routed = conn.execute("SELECT entry_json FROM gateway_routing WHERE scope='' AND session_key=?", (route,)).fetchone()
+    if routed is None or json.loads(routed[0])['session_id'] != tip:
+        raise RuntimeStoreError('storage_unavailable')
+    revision = None
+    for sid in lineage:
+        row = conn.execute('SELECT session_key,chat_id,user_id,runtime_revision FROM sessions WHERE id=?', (sid,)).fetchone()
+        if row is None or tuple(row)[:3] != (route, owner, receipt['principal_id']):
+            raise RuntimeStoreError('storage_unavailable')
+        if sid == owner:
+            revision = row['runtime_revision']
+    return revision
+
+
+def resolve_memory_owner(authority, actor, ref, alias=None):
+    """Resolve only persisted canonical local receipts; never restore, adopt or infer projects.
+
+    All durable checks share an explicit SQLite snapshot. ``alias`` is an optional
+    physical id to prove belongs to the caller's conversation, not an owner override.
+    The actor must originate in the authenticated host transport/turn context.
+    """
+    from gateway.session_authorities import require_serving
+    require_serving(authority)
+    if actor.profile_id != authority.profile_id or ref.profile_id != authority.profile_id:
+        raise RuntimeStoreError('profile_mismatch')
+    if 'session:read' not in actor.capabilities:
+        raise RuntimeStoreError('permission_denied')
+    if not isinstance(ref.session_id, str) or not ref.session_id or (alias is not None and not isinstance(alias, str)):
+        raise RuntimeStoreError('invalid_params')
+    with authority.db._read_ctx(reopen=False) as conn:
+        began = not conn.in_transaction
+        if began:
+            conn.execute('BEGIN')
+        try:
+            result = _receipt_owner(authority, actor, ref, alias, conn)
+            require_serving(authority)
+            return result
+        except (KeyError, TypeError, ValueError, AttributeError, sqlite3.Error) as exc:
+            if isinstance(exc, RuntimeStoreError):
+                raise
+            raise RuntimeStoreError('storage_unavailable') from exc
+        finally:
+            if began and conn.in_transaction:
+                conn.execute('ROLLBACK')
diff --git a/gateway/session_memory_projects.py b/gateway/session_memory_projects.py
new file mode 100644
index 00000000..82d41be5
--- /dev/null
+++ b/gateway/session_memory_projects.py
@@ -0,0 +1,170 @@
+"""Explicit principal-scoped memory project bindings, independent of cwd/sidebar state.
+
+The native project catalog has no principal ACL. A project ID therefore never grants
+cross-principal access: callers retain the binding's principal in every memory key.
+Acquire catalog writer exclusion BEFORE state.db writer exclusion. This module never
+writes projects.db; holding its lock while committing one state binding is not a
+cross-database atomic commit. Archive/restore is current eligibility, not permanent
+historical revocation. Renaming any project row field conservatively invalidates its
+fingerprint until explicit rebinding. Unbinding needs no catalog, even after deletion.
+"""
+from contextlib import contextmanager
+from dataclasses import asdict, dataclass
+import hashlib
+import json
+import math
+from pathlib import Path
+import sqlite3
+
+from hermes_state_runtime import RuntimeStoreError
+
+_BINDING_PREFIX = 'gateway.memory_project.v1:'
+
+
+@dataclass(frozen=True)
+class ProjectBinding:
+    canonical_session_id: str
+    principal_id: str
+    project_id: str | None = None
+    revision: int = 0
+    fingerprint: str | None = None
+    owner_started_at: float | None = None
+
+
+def read_project_binding(conn, canonical_id, principal_id):
+    """Read a binding on the caller's existing state snapshot; never infer or repair."""
+    row = conn.execute('SELECT value FROM state_meta WHERE key=?', (_BINDING_PREFIX + canonical_id,)).fetchone()
+    if row is None:
+        return ProjectBinding(canonical_id, principal_id)
+    try:
+        data = json.loads(row[0])
+        if set(data) != {'canonical_session_id', 'principal_id', 'project_id', 'revision', 'fingerprint', 'owner_started_at'}:
+            raise ValueError('binding fields')
+        binding = ProjectBinding(**data)
+        if binding.owner_started_at != _owner_incarnation(conn, canonical_id):
+            raise RuntimeStoreError('memory_owner_changed')
+        if (binding.canonical_session_id != canonical_id or binding.principal_id != principal_id
+                or type(binding.revision) is not int or binding.revision < 1):
+            raise ValueError('binding identity')
+        if binding.project_id is None:
+            if binding.fingerprint is not None:
+                raise ValueError('unbound fingerprint')
+        elif (not isinstance(binding.project_id, str) or not binding.project_id
+              or not isinstance(binding.fingerprint, str) or len(binding.fingerprint) != 64):
+            raise ValueError('bound project')
+        return binding
+    except (TypeError, ValueError) as exc:
+        if isinstance(exc, RuntimeStoreError):
+            raise
+        raise RuntimeStoreError('storage_unavailable') from exc
+
+
+def _owner_incarnation(conn, canonical_id):
+    """Native root creation timestamp, plus the durable deletion fence.
+
+    Reset/compression rotate children, not this root's started_at. This detects normal
+    recreation, not a forged replacement copying the timestamp after fence expiry.
+    """
+    from hermes_state_mutation_retirement import retired_in
+    row = conn.execute('SELECT started_at FROM sessions WHERE id=?', (canonical_id,)).fetchone()
+    if row is None or retired_in(conn, canonical_id):
+        raise RuntimeStoreError('memory_owner_changed')
+    value = row[0]
+    if not isinstance(value, (int, float)) or not math.isfinite(value):
+        raise RuntimeStoreError('storage_unavailable')
+    return value
+
+
+def write_project_binding(conn, canonical_id, principal_id, project_id, fingerprint, *, expected_revision):
+    """CAS binding and bump native owner revision in the caller's authorized writer txn.
+
+    The caller must already validate exact project ID/fingerprint under catalog writer
+    exclusion, then authenticate owner/principal under state writer exclusion. This
+    primitive neither authenticates nor commits, and contains no retry loop.
+    """
+    if not conn.in_transaction:
+        raise RuntimeStoreError('runtime_coordination_required')
+    if (type(expected_revision) is not int or expected_revision < 0
+            or not isinstance(principal_id, str) or not principal_id
+            or (project_id is None and fingerprint is not None)
+            or (project_id is not None and (not isinstance(project_id, str) or not project_id
+                                           or not isinstance(fingerprint, str) or len(fingerprint) != 64))):
+        raise RuntimeStoreError('invalid_params')
+    incarnation = _owner_incarnation(conn, canonical_id)
+    old = read_project_binding(conn, canonical_id, principal_id)
+    if old.revision != expected_revision:
+        raise RuntimeStoreError('memory_owner_changed')
+    if conn.execute('UPDATE sessions SET runtime_revision=runtime_revision+1 WHERE id=?', (canonical_id,)).rowcount != 1:
+        raise RuntimeStoreError('not_found')
+    binding = ProjectBinding(canonical_id, principal_id, project_id, old.revision + 1, fingerprint, incarnation)
+    conn.execute('INSERT INTO state_meta(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value',
+                 (_BINDING_PREFIX + canonical_id, json.dumps(asdict(binding), sort_keys=True, separators=(',', ':'))))
+    return binding
+
+
+def _catalog_identity(path):
+    stat = path.stat()
+    return stat.st_dev, stat.st_ino
+
+
+@contextmanager
+def project_catalog(authority, *, write=False):
+    """Existing owning profile's catalog only: no ambient home, create, repair or migration.
+
+    Writer mode is a bounded lock, not permission to modify the catalog. No retries.
+    Normal native writers serialize with BEGIN IMMEDIATE; uncoordinated file replacement
+    cannot be prevented, but a changed file identity is refused before/after the body.
+    """
+    path = Path(authority.db.db_path).absolute().parent / 'projects.db'
+    conn = None
+    try:
+        identity = _catalog_identity(path)
+        conn = sqlite3.connect(path.as_uri() + ('?mode=rw' if write else '?mode=ro'),
+                               uri=True, timeout=5, isolation_level=None)
+        conn.row_factory = sqlite3.Row
+        conn.execute('BEGIN IMMEDIATE' if write else 'BEGIN')
+        if _catalog_identity(path) != identity:
+            raise RuntimeStoreError('project_catalog_changed')
+    except (OSError, sqlite3.Error) as exc:
+        if conn is not None:
+            conn.close()
+        raise RuntimeStoreError('project_catalog_unavailable') from exc
+    except BaseException:
+        if conn is not None:
+            conn.close()
+        raise
+    try:
+        yield conn
+        try:
+            changed = _catalog_identity(path) != identity
+        except OSError as exc:
+            raise RuntimeStoreError('project_catalog_changed') from exc
+        if changed:
+            raise RuntimeStoreError('project_catalog_changed')
+    finally:
+        try:
+            if conn.in_transaction:
+                conn.rollback()
+        finally:
+            conn.close()
+
+
+def project_fingerprint(conn, project_id):
+    """Exact catalog ID, not a slug/path match; project row changes invalidate snapshots."""
+    if not isinstance(project_id, str) or not project_id:
+        raise RuntimeStoreError('invalid_params')
+    try:
+        row = conn.execute('SELECT * FROM projects WHERE id=?', (project_id,)).fetchone()
+        if row is None or row['archived'] != 0:
+            raise RuntimeStoreError('project_unavailable')
+        payload = json.dumps(dict(row), sort_keys=True, separators=(',', ':'), allow_nan=False)
+        return hashlib.sha256(payload.encode('utf-8')).hexdigest()
+    except (sqlite3.Error, KeyError, IndexError, TypeError, ValueError) as exc:
+        if isinstance(exc, RuntimeStoreError):
+            raise
+        raise RuntimeStoreError('project_catalog_unavailable') from exc
+
+
+def validate_project_binding(conn, binding):
+    if binding.project_id is not None and project_fingerprint(conn, binding.project_id) != binding.fingerprint:
+        raise RuntimeStoreError('project_changed')
diff --git a/gateway/session_memory_publication.py b/gateway/session_memory_publication.py
new file mode 100644
index 00000000..fd07f336
--- /dev/null
+++ b/gateway/session_memory_publication.py
@@ -0,0 +1,102 @@
+"""Nonreplaying external publication under the canonical store's writer exclusion.
+
+This is NOT a transaction spanning SQLite and an external memory store. A callback
+may have published even when it raises or cleanup fails: those outcomes are uncertain
+and must never be automatically replayed. Callbacks must be short, synchronous, and
+must not re-enter SessionDB or wait for a task that needs its writer lock.
+"""
+import inspect
+from contextlib import nullcontext
+
+from gateway.session_memory_owner import MemoryOwner, _receipt_owner
+from hermes_state_runtime import RuntimeStoreError, _epoch
+
+
+class MemoryPublicationUncertain(RuntimeStoreError):
+    """The external callback started; inspect its destination before any retry."""
+
+    def __init__(self):
+        super().__init__('memory_publication_uncertain', detail='External publication may have taken effect; do not replay.')
+
+
+def _validate_publication(authority, actor, ref, expected, expected_epoch, conn):
+    from gateway.session_authorities import require_serving
+    require_serving(authority)
+    if actor.profile_id != authority.profile_id or ref.profile_id != authority.profile_id:
+        raise RuntimeStoreError('profile_mismatch')
+    if not {'session:read', 'session:control'}.issubset(actor.capabilities):
+        raise RuntimeStoreError('permission_denied')
+    if type(expected_epoch) is not int or authority.epoch != expected_epoch:
+        raise RuntimeStoreError('stale_epoch')
+    _epoch(conn, expected_epoch)
+    current = _receipt_owner(authority, actor, ref, None, conn)
+    if current != expected:
+        raise RuntimeStoreError('memory_owner_changed')
+
+
+def _check_publication_input(expected, publish):
+    if (type(expected) is not MemoryOwner or type(expected.version) is not int or expected.version != 1
+            or not callable(publish) or inspect.iscoroutinefunction(publish)):
+        raise RuntimeStoreError('invalid_params')
+
+
+def _check_project_snapshot(catalog, expected):
+    if expected.project_id is not None:
+        from gateway.session_memory_projects import project_fingerprint
+        if project_fingerprint(catalog, expected.project_id) != expected.project_fingerprint:
+            raise RuntimeStoreError('memory_project_changed')
+
+
+def publish_memory(authority, actor, ref, expected, publish, *, check_context=None):
+    """Validate *expected* and call *publish* once, with no callback retry machinery.
+
+    Inputs must be bound by the host; this function does not authenticate an actor.
+    The host-only check_context guard rechecks ingress lifetime after lock acquisition
+    and after publication. It must raise when the bound context expires.
+    The expected snapshot carries its captured authority epoch.
+    SQLite writers (including other processes) cannot reset/delete/change the owner
+    between validation and callback completion. In-memory authority retirement is
+    checked before/after, not locked by SQLite; an overlapping retirement therefore
+    may produce an uncertain outcome. Uncoordinated filesystem replacement likewise
+    cannot be prevented by this fence. There is no durable exactly-once receipt.
+    """
+    _check_publication_input(expected, publish)
+    from gateway.session_memory_projects import project_catalog
+    catalog_scope = project_catalog(authority, write=True) if expected.project_id is not None else nullcontext(None)
+    expected_epoch = expected.authority_epoch
+    db = authority.db
+    started = False
+    try:
+        with catalog_scope as catalog, db._lock:
+            db._raise_if_db_corrupt(storage=True)
+            db._raise_if_db_replaced()
+            if db.read_only or db._conn is None or db._conn.in_transaction:
+                raise RuntimeStoreError('runtime_coordination_required')
+            conn = db._conn
+            conn.execute('BEGIN IMMEDIATE')
+            try:
+                _validate_publication(authority, actor, ref, expected, expected_epoch, conn)
+                _check_project_snapshot(catalog, expected)
+                if check_context is not None:
+                    check_context()
+                started = True
+                result = publish()
+                if inspect.isawaitable(result):
+                    if inspect.iscoroutine(result):
+                        result.close()
+                    raise RuntimeStoreError('invalid_params')
+                if check_context is not None:
+                    check_context()
+                # A replacement/retirement during external work cannot undo it.
+                db._raise_if_db_replaced()
+                _validate_publication(authority, actor, ref, expected, expected_epoch, conn)
+                _check_project_snapshot(catalog, expected)
+                return result
+            finally:
+                conn.rollback()
+    except BaseException as exc:
+        if started:
+            if isinstance(exc, Exception):
+                raise MemoryPublicationUncertain() from exc
+            exc.add_note("External memory publication may have taken effect; do not replay.")
+        raise
diff --git a/gateway/session_memory_read.py b/gateway/session_memory_read.py
new file mode 100644
index 00000000..6bb877b0
--- /dev/null
+++ b/gateway/session_memory_read.py
@@ -0,0 +1,92 @@
+"""Bounded, nonreplaying reads of an external memory snapshot under native exclusion.
+
+This fence authenticates the host owner snapshot, not the memory policy. ELM must
+still enforce private-scope access, approval and policy. The host never transports
+arbitrary callbacks: this is an in-process primitive for a trusted plugin caller.
+"""
+from contextlib import nullcontext
+import inspect
+import math
+
+from gateway.session_memory_owner import _receipt_owner
+from gateway.session_memory_publication import _check_project_snapshot, _check_publication_input
+from hermes_state_runtime import RuntimeStoreError, _epoch
+
+
+def _validate_read(authority, actor, ref, expected, conn):
+    from gateway.session_authorities import require_serving
+    require_serving(authority)
+    if actor.profile_id != authority.profile_id or ref.profile_id != authority.profile_id:
+        raise RuntimeStoreError('profile_mismatch')
+    if 'session:read' not in actor.capabilities:
+        raise RuntimeStoreError('permission_denied')
+    if type(expected.authority_epoch) is not int or authority.epoch != expected.authority_epoch:
+        raise RuntimeStoreError('stale_epoch')
+    if not isinstance(ref.session_id, str) or not ref.session_id:
+        raise RuntimeStoreError('invalid_params')
+    _epoch(conn, expected.authority_epoch)
+    if _receipt_owner(authority, actor, ref, None, conn) != expected:
+        raise RuntimeStoreError('memory_owner_changed')
+
+
+def _materialize(value, *, depth=0, budget=None):
+    """Copy only inert built-in data; reject lazy/custom objects before releasing the fence."""
+    budget = [10000] if budget is None else budget
+    budget[0] -= 1
+    if depth > 32 or budget[0] < 0:
+        raise RuntimeStoreError('invalid_memory_read_result')
+    kind = type(value)
+    if value is None or kind in (str, bool, int):
+        return value
+    if kind is float and math.isfinite(value):
+        return value
+    if kind in (list, tuple):
+        values = [_materialize(item, depth=depth + 1, budget=budget) for item in value]
+        return tuple(values) if kind is tuple else values
+    if kind is dict and all(type(key) is str for key in value):
+        return {key: _materialize(item, depth=depth + 1, budget=budget) for key, item in value.items()}
+    raise RuntimeStoreError('invalid_memory_read_result')
+
+
+def read_memory(authority, actor, ref, expected, reader, *, check_context=None):
+    """Return one pure synchronous read only while the exact owner remains valid.
+
+    A reader must be short, side-effect-free and synchronous: read an external
+    RecordStore snapshot, do not re-enter SessionDB, publish, or wait on its writers.
+    Return data must be fully materialized builtin containers/scalars, without lazy I/O.
+    No retry occurs, including on reader errors. Any invalidation before return
+    withholds the result. Native catalog-before-state writer exclusion stabilizes
+    authority across the external read; both host transactions always roll back.
+    The expected selection is not authorization to disclose the selected records.
+    Uncoordinated file replacement cannot be prevented, only detected at the fence.
+    """
+    _check_publication_input(expected, reader)
+    from gateway.session_memory_projects import project_catalog
+    catalog_scope = project_catalog(authority, write=True) if expected.project_id is not None else nullcontext(None)
+    db = authority.db
+    with catalog_scope as catalog, db._lock:
+        db._raise_if_db_corrupt(storage=True)
+        db._raise_if_db_replaced()
+        if db.read_only or db._conn is None or db._conn.in_transaction:
+            raise RuntimeStoreError('runtime_coordination_required')
+        conn = db._conn
+        conn.execute('BEGIN IMMEDIATE')
+        try:
+            _validate_read(authority, actor, ref, expected, conn)
+            _check_project_snapshot(catalog, expected)
+            if check_context is not None:
+                check_context()
+            result = reader()
+            if inspect.isawaitable(result):
+                if inspect.iscoroutine(result):
+                    result.close()
+                raise RuntimeStoreError('invalid_params')
+            result = _materialize(result)
+            if check_context is not None:
+                check_context()
+            db._raise_if_db_replaced()
+            _validate_read(authority, actor, ref, expected, conn)
+            _check_project_snapshot(catalog, expected)
+        finally:
+            conn.rollback()
+    return result
diff --git a/gateway/session_memory_turn.py b/gateway/session_memory_turn.py
new file mode 100644
index 00000000..49b338a6
--- /dev/null
+++ b/gateway/session_memory_turn.py
@@ -0,0 +1,145 @@
+"""Core-only claimed local admission binding for fresh request-scoped memory reads."""
+from contextlib import contextmanager
+from contextvars import ContextVar
+import threading
+import hashlib
+
+from hermes_state_runtime import RuntimeStoreError
+
+_turn = ContextVar('admitted_memory_turn', default=None)
+_capture = ContextVar('finalized_memory_capture', default=None)
+
+
+@contextmanager
+def bind_admitted_memory_turn(authority, ref, row):
+    """Never trust request payload identity; recover the committed claim's principal.
+
+    Unsupported/nonlocal admissions proceed normally without memory authority.
+    This context is not serialized into managed workers or plugin subprocesses.
+    """
+    from gateway.session_contract import SessionActor
+    from gateway.session_memory_context import bind_memory_context
+    from gateway.session_memory_owner import resolve_memory_owner
+    from hermes_state_runtime import get_session_admission
+    scope = None
+    try:
+        durable = get_session_admission(authority.db, admission_id=row['admission_id'])
+        if (durable is None or durable['status'] != 'started'
+                or durable['target_session_id'] != ref.session_id
+                or durable['owner_epoch'] != authority.epoch
+                or durable['generation'] != row['generation']
+                or authority.executing.get(ref.session_id) != row['generation']
+                or durable['payload'].get('local_automation_v1') is not None
+                or durable['payload'].get('native_text_v1') is not None):
+            raise RuntimeStoreError('memory_context_unavailable')
+        actor = SessionActor(durable['principal_id'], ref.profile_id, frozenset({'session:read'}),
+                             'memory-turn:' + durable['admission_id'])
+        resolve_memory_owner(authority, actor, ref)
+        scope = {'authority': authority, 'ref': ref, 'generation': durable['generation'], 'epoch': authority.epoch, 'row': durable, 'actor': actor, 'active': True}
+    except Exception:
+        pass
+    if scope is None:
+        # Shadow inherited request authority even for unsupported nested work.
+        token = _turn.set(None)
+        try:
+            yield
+        finally:
+            _turn.reset(token)
+        return
+    token = _turn.set(scope)
+    try:
+        with bind_memory_context(authority, actor, ref, read_only=True, validate=check_admitted_memory_turn):
+            yield
+    finally:
+        scope['active'] = False
+        _turn.reset(token)
+
+
+def check_admitted_memory_turn():
+    scope = _turn.get()
+    if scope is not None:
+        from gateway.session_authorities import require_serving
+        require_serving(scope['authority'])
+    if (scope is None or not scope['active']
+            or scope['authority'].profile_id != scope['ref'].profile_id
+            or scope['authority'].epoch != scope['epoch']
+            or scope['authority'].executing.get(scope['ref'].session_id) != scope['generation']
+            or scope['authority'].pending_stops.get(scope['ref'].session_id) == scope['generation']
+            or scope['authority'].delivered_stops.get(scope['ref'].session_id) == scope['generation']):
+        raise RuntimeStoreError('memory_context_unavailable')
+
+
+def request_memory_owner(*, version=1, alias=None):
+    check_admitted_memory_turn()
+    from gateway.session_memory_context import current_memory_owner
+    return current_memory_owner(version=version, alias=alias)
+
+
+@contextmanager
+def finalized_capture_scope():
+    """Core finalizer only: a non-transferable synchronous capture callback lifetime."""
+    check_admitted_memory_turn()
+    permit = {'turn': _turn.get(), 'active': True, 'thread_id': threading.get_ident(), 'material': None}
+    token = _capture.set(permit)
+    try:
+        yield
+    finally:
+        permit['active'] = False
+        _capture.reset(token)
+
+
+def capture_turn_input():
+    check_admitted_memory_turn()
+    permit = _capture.get()
+    if (permit is None or not permit['active'] or permit['turn'] is not _turn.get()
+            or permit['thread_id'] != threading.get_ident()):
+        raise RuntimeStoreError('memory_capture_unavailable')
+    row = _turn.get()['row']
+    text = row['payload'].get('text')
+    if type(text) is not str or not text or row['payload'].get('turn_author'):
+        raise RuntimeStoreError('memory_capture_unavailable')
+    return {'admission_id': row['admission_id'], 'sequence': row['seq'], 'user_text': text}
+
+
+def capture_turn_memory(expected, publish):
+    """Dedicated finalizer capture capability, not general turn publication access."""
+    capture_turn_provenance()
+    scope = _turn.get()
+    from gateway.session_contract import SessionActor
+    from gateway.session_memory_publication import publish_memory
+    actor = SessionActor(scope['actor'].subject, scope['ref'].profile_id,
+                         frozenset({'session:read', 'session:control'}), scope['actor'].transport_id)
+    def check_context():
+        capture_turn_input()
+    return publish_memory(scope['authority'], actor, scope['ref'], expected, publish, check_context=check_context)
+
+
+def capture_admission_watermark():
+    """Control-publication-only high-water mark; excludes already admitted turns."""
+    from gateway.session_memory_context import _current
+    scope = _current.get()
+    if (scope is None or not scope.active or scope.read_only
+            or 'session:control' not in scope.actor.capabilities
+            or scope.authority.db._conn is None or not scope.authority.db._conn.in_transaction):
+        raise RuntimeStoreError('memory_publication_unavailable')
+    return scope.authority.db._conn.execute(
+        'SELECT COALESCE(MAX(seq),0) FROM session_admissions').fetchone()[0]
+
+
+def set_capture_material(user_text, assistant_text):
+    """Core-only once-per-finalization redacted material binding."""
+    capture_turn_input()
+    permit = _capture.get()
+    if permit['material'] is not None or type(user_text) is not str or type(assistant_text) is not str:
+        raise RuntimeStoreError('memory_capture_unavailable')
+    permit['material'] = {
+        'user_sha256': hashlib.sha256(user_text.encode('utf-8')).hexdigest(),
+        'assistant_sha256': hashlib.sha256(assistant_text.encode('utf-8')).hexdigest()}
+
+
+def capture_turn_provenance():
+    receipt = capture_turn_input()
+    material = _capture.get()['material']
+    if material is None:
+        raise RuntimeStoreError('memory_capture_unavailable')
+    return {'admission_id': receipt['admission_id'], 'sequence': receipt['sequence'], **material}
