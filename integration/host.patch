+"""Real process bridge retains authenticated call context, never publication authority."""
+import os
+
+import pytest
+
+from hermes_cli.plugins import PluginManager
+from tests.hermes_cli.test_plugin_host import _home_with_plugins
+from tests.gateway.test_local_authority_transitions import local_session
+
+PLUGIN = '''
+import contextvars, os, threading
+from dataclasses import asdict
+from hermes_cli.plugin_memory import memory_owner, publish_memory
+
+saved = None
+
+def read(params, **kwargs):
+    global saved
+    mode = params.get('mode')
+    if mode == 'save':
+        saved = contextvars.copy_context()
+    if mode == 'replay':
+        return saved.run(lambda: asdict(memory_owner()))
+    if mode == 'background':
+        answer = []
+        def worker():
+            try:
+                memory_owner()
+            except Exception as exc:
+                answer.append(str(exc))
+        thread = threading.Thread(target=worker)
+        thread.start()
+        thread.join(10)
+        return {'errors': answer}
+    owner = memory_owner(alias=params.get('alias'))
+    if mode == 'publish':
+        effects = []
+        try:
+            publish_memory(owner, lambda: effects.append('written'))
+        except Exception as exc:
+            return {'error': str(exc), 'error_type': type(exc).__name__, 'effects': effects}
+    return {'owner': asdict(owner), 'pid': os.getpid()}
+
+def register(ctx):
+    ctx.register_rpc('read', read, memory_scope='local_read')
+'''
+
+
