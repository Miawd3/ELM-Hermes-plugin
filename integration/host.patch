+    manager = plugins.PluginManager()
+    monkeypatch.setattr(plugins, '_plugin_manager', manager)
+    try:
+        reply = await connection.dispatch({'id': 1, 'method': 'plugin.owner-demo.owner', 'params': {
+            'session_id': ref.session_id, 'principal_id': 'forged', 'profile_id': 'forged'}})
+        assert 'result' in reply, reply
+        assert reply['result']['canonical_session_id'] == ref.session_id, reply
+        assert reply['result']['principal_id'] == connection.actor.subject
+        assert reply['result']['project_id'] is None
+        assert reply['result']['version'] == 1
+        refused = await connection.dispatch({'id': 2, 'method': 'plugin.owner-demo.owner', 'params': {
+            'session_id': ref.session_id, 'alias': 'foreign'}})
+        assert refused['error']['data']['reason'] == 'plugin_rpc_failed'
+        with pytest.raises(RuntimeStoreError, match='memory_context_unavailable'):
+            memory_owner()
+    finally:
+        manager.unload('owner-demo')
+        await connection.close()
+        authority.db.close()
