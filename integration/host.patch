+"""RPC-bound ownership context lifetime; resolver integrity has separate native-state tests."""
+import contextvars
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.session_memory_context import bind_memory_context
+from hermes_cli.plugin_memory import memory_owner
+from hermes_state_runtime import RuntimeStoreError
+
+
+@pytest.fixture
+def bound(monkeypatch):
+    import gateway.session_memory_owner as resolver
+    seen = []
+    def resolve(authority, actor, ref, alias=None):
+        seen.append((authority, actor, ref, alias))
+        return {'version': 1}
+    monkeypatch.setattr(resolver, 'resolve_memory_owner', resolve)
+    return seen
+
+
+def test_unbound_call_refuses():
+    with pytest.raises(RuntimeStoreError, match='memory_context_unavailable'):
+        memory_owner()
+
+
+@pytest.mark.parametrize('version', [True, 0, 2, '1', None])
+def test_unknown_contract_refuses(version):
+    with pytest.raises(RuntimeStoreError, match='unsupported_memory_contract'):
+        memory_owner(version=version)
+
+
+def test_context_carries_host_identity_and_expires_even_in_copied_context(bound):
+    authority, actor, ref = object(), object(), SimpleNamespace(session_id='canonical')
+    with bind_memory_context(authority, actor, ref):
+        copied = contextvars.copy_context()
+        assert memory_owner(alias='child') == {'version': 1}
+    assert bound == [(authority, actor, ref, 'child')]
+    with pytest.raises(RuntimeStoreError, match='memory_context_unavailable'):
+        copied.run(memory_owner)
+
+
+def test_nested_scope_restores_parent_and_failure_cleans_up(bound):
+    ref = SimpleNamespace(session_id='s')
+    with bind_memory_context('outer', 'actor', ref):
+        with pytest.raises(ValueError):
+            with bind_memory_context('inner', 'actor', ref):
+                memory_owner()
+                raise ValueError()
+        memory_owner()
+    assert [call[0] for call in bound] == ['inner', 'outer']
+    with pytest.raises(RuntimeStoreError, match='memory_context_unavailable'):
+        memory_owner()
+
+
+def test_unscoped_rpc_does_not_get_a_memory_identity(bound):
+    with bind_memory_context(object(), object(), SimpleNamespace(session_id=None)):
+        with pytest.raises(RuntimeStoreError, match='memory_context_unavailable'):
+            memory_owner()
+    assert not bound
