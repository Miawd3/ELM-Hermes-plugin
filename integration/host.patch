index 00000000..b37d4190
--- /dev/null
+++ b/hermes_cli/plugin_organizer.py
@@ -0,0 +1,230 @@
+"""Host-owned organizer receipt and secret consumption for explicit one-shot sends.
+
+The direct HTTPS adapter pins a public address and verifies the reviewed host.
+Tests may inject a local socket adapter, never via RPC. No callable returns
+plaintext credentials to a plugin. Provider compatibility/pricing are unverified.
+"""
+from dataclasses import asdict
+import json
+
+from gateway import model_credential_storage as storage
+from hermes_cli.plugin_llm_pinned import _OfflineContract, Recipient, PinnedDispatchError
+from hermes_cli.plugin_llm_transport import HttpsTransport
+
+# Production remains gated until provider-specific request/response qualification.
+# PublicHttpsConnection is a hardened candidate, not enabled by saved preferences.
+_TRANSPORT_FACTORY = None
+
+
+def dispatch_available():
+    return _TRANSPORT_FACTORY is not None
+
+
+def _scope(expected=None, *, write=False):
+    from gateway.session_memory_context import _current, current_memory_owner
+    from gateway.runtime_bootstrap import _PURPOSE_CAPABILITIES
+    scope=_current.get()
+    if (scope is None or not scope.active or (write and scope.read_only)
+            or not _PURPOSE_CAPABILITIES['interactive']<=frozenset(scope.actor.capabilities)):
+        raise PinnedDispatchError('interactive_organizer_context_required')
+    owner=current_memory_owner(version=1)
+    if expected is not None and owner!=expected:
+        raise PinnedDispatchError('organizer_owner_changed')
+    return scope,owner
+
+
+def _native(expected, callback, *, write=False):
+    from gateway.session_authorities import require_serving, owner_scope
+    from gateway.session_memory_owner import _receipt_owner
+    scope,owner=_scope(expected,write=write)
+    db=scope.authority.db
+    try:
+        with owner_scope(scope.authority), db._lock:
+            require_serving(scope.authority)
+            db._raise_if_db_replaced()
+            db._raise_if_db_corrupt(storage=True)
+            if db._conn is None or db._conn.in_transaction or (write and db.read_only):
+                raise PinnedDispatchError('organizer_storage_unavailable')
+            conn=db._conn
+            if write and not _durable(conn):
+                raise PinnedDispatchError('organizer_durable_storage_required')
+            conn.execute('BEGIN IMMEDIATE' if write else 'BEGIN')
+            try:
+                if _receipt_owner(scope.authority,scope.actor,scope.ref,None,conn)!=owner:
+                    raise PinnedDispatchError('organizer_owner_changed')
+                result=callback(conn,owner)
+                require_serving(scope.authority)
+                db._raise_if_db_replaced()
+                if not scope.active:
+                    raise PinnedDispatchError('organizer_owner_changed')
+                if write:
+                    conn.commit()
+                    require_serving(scope.authority)
+                    db._raise_if_db_replaced()
+            finally:
+                if conn.in_transaction:
+                    conn.rollback()
+        _scope(owner,write=write)  # Final native catalog/owner validation before returning buffered data.
+        return result
+    except Exception:
+        raise PinnedDispatchError('organizer_authority_or_storage_unavailable') from None
+
+
+def _durable(conn):
+    level=conn.execute('PRAGMA synchronous').fetchone()[0]
+    mode=conn.execute('PRAGMA journal_mode').fetchone()[0]
+    return type(level) is int and level>=2 and mode in ('wal','delete','truncate','persist')
+
+
+def require_dispatch_ready():
+    if not dispatch_available():
+        raise PinnedDispatchError('organizer_production_dispatch_unavailable')
+    _,owner=_scope(write=True)
+    ready=_native(owner,lambda conn,current:_durable(conn))
+    if not ready:
+        raise PinnedDispatchError('organizer_durable_storage_required')
+
+
+def _slot(conn,owner):
+    data=storage.load(conn,owner,storage.policy())
+    row=data['slots'].get('organizer')
+    if row is None or not row['active']:
+        raise PinnedDispatchError('organizer_credential_unavailable')
+    return row
+
+
+def _metadata(row,owner):
+    result={k:row[k] for k in ('provider','model','endpoint','version')}
+    result['route_sha256']=storage.digest([storage.binding(owner),'organizer',result])
+    return result
+
+
+def organizer_route():
+    _,owner=_scope()
+    return _native(owner,lambda conn,current:_metadata(_slot(conn,current),current))
+
+
+def _echoes_secret(response,secret):
+    # Recognize exact values, including JSON escaping and the nested content JSON.
+    # This is not a general covert-channel or arbitrary-transformation detector.
+    stack=[(response.decode('utf-8','replace'),0)]
+    count=0
+    while stack:
+        value,depth=stack.pop()
+        count+=1
+        if count>4096:
+            return True
+        if isinstance(value,str):
+            if secret in value:
+                return True
+            if depth<4:
+                try:
+                    decoded=json.loads(value)
+                except (ValueError,RecursionError):
+                    continue
+                stack.append((decoded,depth+1))
+        elif isinstance(value,dict):
+            stack.extend((item,depth) for pair in value.items() for item in pair)
+        elif isinstance(value,list):
+            stack.extend((item,depth) for item in value)
+    return False
+
+
+class _HostTransport(HttpsTransport):
+    def __init__(self,owner,route):
+        super().__init__(route['endpoint'])
+        self._owner=owner
+        self._route=dict(route)
+        self._sent_secret=None
+        self.recipient=Recipient(provider=route['provider'],endpoint=route['endpoint'],
+            credential_mode='host-enrolled-slot',credential_slot='organizer',
+            credential_version=route['version'],route_sha256=route['route_sha256'])
+
+    def __repr__(self):
+        return '<host organizer transport; credentials redacted>'
+
+    def _check(self,wire,*,headers=False):
+        def inspect(conn,owner):
+            row=_slot(conn,owner)
+            if (_metadata(row,owner)!=self._route or wire.model!=row['model']
+                    or wire.recipient!=self.recipient):
+                raise PinnedDispatchError('organizer_route_changed')
+            # Only the host transport builds this header. No secret getter exists.
+            return {'Authorization':'Bearer '+row['secret']} if headers else None
+        return _native(self._owner,inspect)
+
+    def _before_connect(self,wire):
+        self._check(wire)
+
+    def _headers(self,wire):
+        headers=self._check(wire,headers=True)
+        self._sent_secret=headers['Authorization'][len('Bearer '):]
+        return super()._headers(wire)|headers
+
+    def __call__(self,wire):
+        self._sent_secret=None
+        try:
+            result=super().__call__(wire)
+            if self._sent_secret and _echoes_secret(result,self._sent_secret):
+                raise PinnedDispatchError('organizer_response_withheld')
+            return result
+        finally:
+            self._sent_secret=None
+
+    def _connection(self,timeout):
+        # The test adapter replaces only socket construction; exact host-owned
+        # destination/body/credential checks above remain the public path.
+        if _TRANSPORT_FACTORY is None:
+            raise PinnedDispatchError('organizer_production_dispatch_unavailable')
+        return _TRANSPORT_FACTORY(self._host,self._port,timeout)
+
+
+class _OrganizerContract(_OfflineContract):
+    def __init__(self,route,freshness_reader):
+        from hermes_cli.plugin_llm_pinned import _native_owner,_native_admission
+        _,owner=_scope()
+        transport=_HostTransport(owner,route)
+        super().__init__(transport,_native_owner,freshness_reader,_native_admission)
+        self._recipient=transport.recipient
+
+    def prepare(self,*args,**kwargs):
+        try:
+            prepared=super().prepare(*args,**kwargs)
+            self._transport._before_connect(prepared.wire)  # Validation only; never opens a socket.
+            return prepared
+        except BaseException:
+            self.close()
+            raise
+
+    def _invoke(self,pending):
+        if not dispatch_available():
+            raise PinnedDispatchError('organizer_production_dispatch_unavailable')
+        _scope(pending.owner,write=True)
+        wire=pending.prepared.wire
+        self._transport._before_connect(wire)
+        key='gateway.organizer_attempt.v1:'+storage.binding(pending.owner)+':'+pending.prepared.attempt_id
+        fingerprint=storage.digest([asdict(pending.owner),asdict(wire.recipient),wire.model,wire.payload_sha256,pending.freshness])
+        def claim(conn,owner):
+            prefix='gateway.organizer_attempt.v1:'+storage.binding(owner)+':'
+            if conn.execute('SELECT 1 FROM state_meta WHERE key=?',(key,)).fetchone() is not None:
+                raise PinnedDispatchError('organizer_attempt_already_claimed')
+            if conn.execute('SELECT COUNT(*) FROM state_meta WHERE key LIKE ?',(prefix+'%',)).fetchone()[0]>=64:
+                raise PinnedDispatchError('organizer_attempt_capacity')
+            conn.execute('INSERT INTO state_meta(key,value) VALUES(?,?)',(key,json.dumps(dict(state='attempted',binding=fingerprint))))
+        _native(pending.owner,claim,write=True)
+        # Durable claim precedes all socket I/O; failures after it never retry.
+        if self._checked_callback(self._admit,pending.owner,self._fresh)!=pending.freshness:
+            raise PinnedDispatchError('source_snapshot_changed')
+        response=self._transport(wire)
+        self._transport._before_connect(wire)  # Withhold completion after observed rotation/revocation.
+        def complete(conn,owner):
+            conn.execute('UPDATE state_meta SET value=? WHERE key=?',
+                         (json.dumps(dict(state='completed',binding=fingerprint)),key))
+        _native(pending.owner,complete,write=True)
+        return response
+
+
+def organizer_contract(route,*,freshness_reader):
+    # This capability returns a secret-free one-use receipt/operation object,
+    # never a credential. Only current native interactive contexts can prepare.
+    return _OrganizerContract(route,freshness_reader)
diff --git a/hermes_cli/plugin_public_https.py b/hermes_cli/plugin_public_https.py
new file mode 100644
index 00000000..229466e4
--- /dev/null
+++ b/hermes_cli/plugin_public_https.py
@@ -0,0 +1,40 @@
+"""Single-address, verified-TLS connections for explicitly reviewed model requests.
+
+DNS is resolved once per invocation. Every returned address must be globally
+routable; a socket connects to exactly one numeric address and TLS verifies the
+original hostname. No proxy, redirect, alternate-address retry or trust override.
+This does not certify provider API compatibility, pricing or DNS lookup duration.
+"""
+import http.client
+import ipaddress
+import socket
+import ssl
+
+
+class PublicHttpsConnection(http.client.HTTPSConnection):
+    def __init__(self, host, port, timeout):
+        super().__init__(host, port, timeout=timeout, context=ssl.create_default_context())
+
+    def connect(self):
+        if self._tunnel_host is not None:
+            raise OSError('Tunnels are not supported')
+        answers = socket.getaddrinfo(self.host, self.port, type=socket.SOCK_STREAM,
+                                     proto=socket.IPPROTO_TCP)
+        if not answers or len(answers) > 64:
+            raise OSError('Destination unavailable')
+        for family, kind, protocol, _, address in answers:
+            ip = ipaddress.ip_address(address[0])
+            if (family not in (socket.AF_INET, socket.AF_INET6)
+                    or kind != socket.SOCK_STREAM or protocol != socket.IPPROTO_TCP
+                    or not ip.is_global or ip.is_multicast or ip.is_unspecified
+                    or '%' in address[0] or (family == socket.AF_INET6 and address[3])):
+                raise OSError('Destination is not a public unicast address')
+        family, kind, protocol, _, address = answers[0]
+        raw = socket.socket(family, kind, protocol)
+        try:
+            raw.settimeout(self.timeout)
+            raw.connect(address)
+            self.sock = self._context.wrap_socket(raw, server_hostname=self.host)
+        except BaseException:
+            raw.close()
+            raise
