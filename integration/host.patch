@@ -0,0 +1,53 @@
+import { useStore } from '@nanostores/react'
+import { useState } from 'react'
+import { registry } from '@/contrib/registry'
+import { useContributions } from '@/contrib/react/use-contributions'
+import { CHAT_FOLDERS_AREA, folderRows, currentFolderRow, sameChatFolderOwner, validChatFolderSnapshot, type ChatFolderOwner } from '@/lib/chat-folder-contributions'
+import type { SessionInfo } from '@/hermes'
+import { $activeGatewayProfile } from '@/store/profile'
+import { gatewayActivationEpoch, useGatewayActivationEpoch } from '@/store/gateway'
+import { $connection, $gatewayState, $sessions, sessionPinId, sessionOwnerRouteFromRow } from '@/store/session'
+import { $focusedStoredSessionId } from '@/store/session-focus'
+import { $focusedRuntimeId, knownOwnerForSession } from '@/store/session-states'
+import { $removedSessionIds } from '@/store/session-removal'
+import { SidebarSessionsSection } from './sessions-section'
+
+export function currentChatFolderOwner(): ChatFolderOwner | null {
+  const storedSessionId=$focusedStoredSessionId.get(), runtimeSessionId=$focusedRuntimeId.get()
+  const connection=$connection.get(), profile=$activeGatewayProfile.get()
+  const connectionId=String(connection?.connectionId || (connection?.mode==='local'?'local':'')).trim()
+  const owner=knownOwnerForSession(runtimeSessionId)
+  if ($gatewayState.get()!=='open' || !storedSessionId || !runtimeSessionId || !owner || typeof owner==='string' || owner.connectionId!==connectionId || owner.profile!==profile) return null
+  return {connectionId,profile,storedSessionId,runtimeSessionId,epoch:gatewayActivationEpoch()}
+}
+interface Props {
+  sessions: SessionInfo[]; activeSessionId: string|null
+  onResumeSession:(id:string,row?:SessionInfo)=>void
+  onDeleteSession:(id:string)=>void; onArchiveSession:(id:string)=>void
+  onTogglePin:(id:string)=>void; onToggleUnread:(id:string)=>void
+}
+export function ChatFolderSection(props:Props) {
+  const contributions=useContributions(CHAT_FOLDERS_AREA)
+  useStore($focusedStoredSessionId); useStore($focusedRuntimeId); useStore($connection); useStore($activeGatewayProfile); useStore($gatewayState); useGatewayActivationEpoch()
+  const [collapsed,setCollapsed]=useState<Set<string>>(new Set())
+  const owner=currentChatFolderOwner()
+  const contribution=contributions.find(c=>validChatFolderSnapshot(c.data)&&sameChatFolderOwner(c.data.owner,owner))
+  if (!contribution || !validChatFolderSnapshot(contribution.data)) return null
+  const snapshot=contribution.data
+  const rowOwner=(row:SessionInfo)=>{const known=sessionOwnerRouteFromRow(row); return known && typeof known!=='string'?known:null}
+  const aliases=(row:SessionInfo)=>[row.id,sessionPinId(row)]
+  const valid=()=>sameChatFolderOwner(owner,currentChatFolderOwner())&&registry.getArea(CHAT_FOLDERS_AREA).some(c=>c===contribution)
+  return <section aria-label="Chat folders" className="border-t border-(--ui-stroke-secondary) pt-2">
+    <p className="px-2 text-xs text-(--ui-text-tertiary)">Chat folders · refreshed snapshot. Only already-loaded, owner-verified rows are shown. Empty display does not prove an empty folder. Recents and Projects are unchanged.</p>
+    {snapshot.folders.map(folder=>{
+      const rows=folderRows(snapshot,folder.id,props.sessions,rowOwner,aliases)
+      const currentRow=(id:string)=>currentFolderRow(snapshot,folder.id,rows,$sessions.get().filter(row=>!$removedSessionIds.get().has(row.id)&&!$removedSessionIds.get().has(sessionPinId(row))),id,rowOwner,aliases)
+      const guarded=(fn:(id:string)=>void)=>(id:string)=>{if(valid()&&currentRow(id))fn(id)}
+      const key=JSON.stringify([snapshot.owner.connectionId,snapshot.owner.profile,folder.id])
+      return <SidebarSessionsSection navigationOnly key={key} label={folder.label} open={!collapsed.has(key)} onToggle={()=>{if(valid())setCollapsed(old=>{const next=new Set(old);next.has(key)?next.delete(key):next.add(key);return next})}} sessions={rows} activeSessionId={props.activeSessionId}
+        onResumeSession={(id)=>{const row=valid()?currentRow(id):null;if(row)props.onResumeSession(id,row)}}
+        onDeleteSession={guarded(props.onDeleteSession)} onArchiveSession={guarded(props.onArchiveSession)} onTogglePin={guarded(props.onTogglePin)} onToggleUnread={guarded(props.onToggleUnread)} pinned={false} preserveOrder
+        emptyState={<p className="px-2 text-xs text-(--ui-text-tertiary)">No currently loaded matching rows. Refresh or load chats through the native sidebar; no history is fetched here.</p>} />
+    })}
+  </section>
+}
