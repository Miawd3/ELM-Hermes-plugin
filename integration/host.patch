+"""Experimental direct transport and durable attempt ledger; not production-enabled.
+
+No credential discovery, SDK, auxiliary router, redirect handler or proxy support.
+Only the explicitly private loopback adapter permits HTTP for local tests.
+"""
+from dataclasses import asdict, is_dataclass
+import hashlib
+import http.client
+import json
+import os
+from pathlib import Path
+import sqlite3
+import ssl
+import time
+from urllib.parse import urlsplit
+
+from hermes_cli.plugin_llm_pinned import (
+    PinnedDispatchError, Recipient, _OfflineContract, _native_owner, _native_admission,
+)
+
+
+def _digest(value):
+    if type(value) is not str or len(value)!=64 or any(c not in '0123456789abcdef' for c in value):
+        raise PinnedDispatchError('invalid_ledger_digest')
+    return value
+
+
+def _destination(endpoint, *, loopback=False):
+    if type(endpoint) is not str or len(endpoint)>2048 or any(ord(c)<33 or ord(c)>126 for c in endpoint):
+        raise PinnedDispatchError('invalid_endpoint')
+    try:
+        parsed=urlsplit(endpoint)
+        port=parsed.port
+    except ValueError:
+        raise PinnedDispatchError('invalid_endpoint') from None
+    scheme='http' if loopback else 'https'
+    if (parsed.scheme!=scheme or not parsed.hostname or parsed.username is not None
+            or parsed.password is not None or parsed.query or parsed.fragment
+            or not parsed.path.startswith('/') or '\\' in endpoint
+            or parsed.path!='/v1/chat/completions'):
+        raise PinnedDispatchError('invalid_endpoint')
+    if port is not None and not 1<=port<=65535:
+        raise PinnedDispatchError('invalid_endpoint')
+    if loopback and parsed.hostname not in ('127.0.0.1','::1'):
+        raise PinnedDispatchError('loopback_only')
+    return parsed.hostname, port or (80 if loopback else 443), parsed.path
+
+
+class HttpsTransport:
+    """No-auth HTTPS adapter. Not a configured/qualified production capability."""
+    def __init__(self,endpoint):
+        self._host,self._port,self._path=_destination(endpoint)
+        self.recipient=Recipient(provider='direct-https-experimental',endpoint=endpoint)
+        self._loopback=False
+
+    def _connection(self,timeout):
+        if self._loopback:
+            return http.client.HTTPConnection(self._host,self._port,timeout=timeout)
+        # Platform trust validation and hostname checks remain enabled.
+        context=ssl.create_default_context()
+        return http.client.HTTPSConnection(self._host,self._port,timeout=timeout,context=context)
+
+    def _before_connect(self,wire):
+        pass
+
+    def _headers(self,wire):
+        return {'Content-Type':'application/json','Accept':'application/json',
+                'Accept-Encoding':'identity','Connection':'close'}
+
+    def __call__(self,wire):
+        if wire.recipient!=self.recipient:
+            raise PinnedDispatchError('recipient_changed')
+        if (type(wire.body) is not bytes or len(wire.body)>32768
+                or hashlib.sha256(wire.body).hexdigest()!=wire.payload_sha256
+                or type(wire.timeout_seconds) is not int or not 1<=wire.timeout_seconds<=30
+                or type(wire.max_response_bytes) is not int or not 1<=wire.max_response_bytes<=8192):
+            raise PinnedDispatchError('invalid_wire_request')
+        conn=None
+        try:
+            body=json.loads(wire.body)
+            if (type(body) is not dict or body.get('model')!=wire.model
+                    or type(body.get('max_tokens')) is not int or body['max_tokens']!=wire.max_output_tokens
+                    or json.dumps(body,sort_keys=True,ensure_ascii=True,separators=(',',':'),allow_nan=False).encode()!=wire.body):
+                raise ValueError('wire metadata mismatch')
+            self._before_connect(wire)
+            deadline=time.monotonic()+wire.timeout_seconds
+            conn=self._connection(wire.timeout_seconds)
+            # Explicit connect; http.client does not follow redirects or retry.
+            conn.connect()
+            self._remaining(conn,deadline)
+            conn.request('POST',self._path,body=wire.body,headers=self._headers(wire))
+            self._remaining(conn,deadline)
+            response=conn.getresponse()
+            if response.status!=200 or response.getheader('Content-Encoding','identity').lower()!='identity':
+                raise ValueError('response status or encoding')
+            length=response.getheader('Content-Length')
+            if length is not None and (not length.isdigit() or int(length)>wire.max_response_bytes):
+                raise ValueError('response bound')
+            chunks=[]
+            size=0
+            while True:
+                self._remaining(conn,deadline,response)
+                chunk=response.read1(min(4096,wire.max_response_bytes+1-size))
+                if not chunk:
+                    break
+                chunks.append(chunk)
+                size+=len(chunk)
+                if size>wire.max_response_bytes:
+                    raise ValueError('response bound')
+            if length is not None and size!=int(length):
+                raise ValueError('truncated response')
+            return b''.join(chunks)
+        except Exception:
+            raise PinnedDispatchError('transport_failed_outcome_unknown') from None
+        finally:
+            if conn is not None:
+                conn.close()
+
+    @staticmethod
+    def _remaining(conn,deadline,response=None):
+        remaining=deadline-time.monotonic()
+        if remaining<=0:
+            raise TimeoutError('request deadline')
+        sock=conn.sock
+        if sock is None and response is not None and response.fp is not None:
+            sock=getattr(getattr(response.fp,'raw',None),'_sock',None)
+        if sock is not None:
+            sock.settimeout(remaining)
+
+
+class _LoopbackTransport(HttpsTransport):
+    """Local test-only HTTP seam. Never selected by production configuration."""
+    def __init__(self,endpoint):
+        self._host,self._port,self._path=_destination(endpoint,loopback=True)
+        self.recipient=Recipient(provider='loopback-test',endpoint=endpoint)
+        self._loopback=True
+
+
+class AttemptLedger:
+    """Trusted configured path, never an RPC parameter; no payload or secrets."""
+    def __init__(self,path,*,create=False):
+        self.path=Path(path).absolute()
+        self._safe_path()
+        conn=None
+        try:
+            if type(create) is not bool:
+                raise ValueError('creation mode')
+            if create:
+                fd=os.open(self.path,os.O_CREAT|os.O_EXCL|os.O_WRONLY,0o600)
+                os.close(fd)
+            conn=self._connect()
+            if create:
+                with conn:
+                    conn.execute('CREATE TABLE pinned_meta (version INTEGER NOT NULL)')
+                    conn.execute('INSERT INTO pinned_meta VALUES (1)')
+                    conn.execute('CREATE TABLE pinned_attempts ('
+                                 'attempt_id TEXT PRIMARY KEY, owner_sha256 TEXT NOT NULL, '
+                                 'payload_sha256 TEXT NOT NULL, binding_sha256 TEXT NOT NULL, '
+                                 "state TEXT NOT NULL CHECK(state IN ('attempted','completed')))")
+                # Creation is explicit and directory durability is required.
+                fd=os.open(self.path.parent,os.O_RDONLY)
+                try:
+                    os.fsync(fd)
+                finally:
+                    os.close(fd)
+            self._validate(conn)
+            stat=self.path.stat()
+            self._identity=(stat.st_dev,stat.st_ino)
+        except Exception:
+            raise PinnedDispatchError('attempt_ledger_unavailable') from None
+        finally:
+            if conn is not None:
+                conn.close()
+
+    @staticmethod
+    def _validate(conn):
+        objects=conn.execute('SELECT type,name,tbl_name FROM sqlite_master ORDER BY type,name').fetchall()
+        if objects!=[('index','sqlite_autoindex_pinned_attempts_1','pinned_attempts'),
+                     ('table','pinned_attempts','pinned_attempts'),('table','pinned_meta','pinned_meta')]:
+            raise ValueError('unexpected ledger objects')
+        if conn.execute("SELECT sql FROM sqlite_master WHERE name='pinned_meta'").fetchone()[0]!='CREATE TABLE pinned_meta (version INTEGER NOT NULL)':
+            raise ValueError('ledger metadata schema')
+        if conn.execute('PRAGMA quick_check').fetchall()!=[('ok',)]:
+            raise ValueError('ledger integrity')
+        if conn.execute('SELECT version FROM pinned_meta').fetchall()!=[(1,)]:
+            raise ValueError('ledger version')
+        columns=conn.execute('PRAGMA table_info(pinned_attempts)').fetchall()
+        names=['attempt_id','owner_sha256','payload_sha256','binding_sha256','state']
+        expected=[(i,name,'TEXT',0 if i==0 else 1,None,1 if i==0 else 0) for i,name in enumerate(names)]
+        if columns!=expected:
+            raise ValueError('ledger schema')
+        schema=conn.execute("SELECT sql FROM sqlite_master WHERE type='table' AND name='pinned_attempts'").fetchone()[0]
+        required=("CREATE TABLE pinned_attempts (attempt_id TEXT PRIMARY KEY, owner_sha256 TEXT NOT NULL, "
+                  "payload_sha256 TEXT NOT NULL, binding_sha256 TEXT NOT NULL, state TEXT NOT NULL CHECK(state IN ('attempted','completed')))")
+        if schema!=required:
+            raise ValueError('ledger constraints')
+        rows=conn.execute('SELECT * FROM pinned_attempts LIMIT 10001').fetchall()
+        if len(rows)>10000:
+            raise ValueError('ledger capacity')
+        for row in rows:
+            for digest in row[:4]:
+                _digest(digest)
+            if row[4] not in ('attempted','completed'):
+                raise ValueError('ledger state')
+
+    def _safe_path(self):
+        if any(part.is_symlink() for part in (self.path,*self.path.parents)):
+            raise PinnedDispatchError('unsafe_ledger_path')
+        if not self.path.parent.is_dir():
+            raise PinnedDispatchError('ledger_parent_missing')
+        # SQLite rollback journal must not be a pre-existing escape either.
+        if any(Path(str(self.path)+suffix).is_symlink() for suffix in ('-journal','-wal','-shm')):
+            raise PinnedDispatchError('unsafe_ledger_path')
+
+    def _connect(self):
+        self._safe_path()
+        if hasattr(self,'_identity'):
+            stat=self.path.stat()
+            if (stat.st_dev,stat.st_ino)!=self._identity:
+                raise PinnedDispatchError('attempt_ledger_replaced')
+        conn=sqlite3.connect(self.path.as_uri()+'?mode=rw',uri=True,timeout=2)
+        try:
+            conn.execute('PRAGMA journal_mode=DELETE')
+            conn.execute('PRAGMA synchronous=FULL')
+            return conn
+        except BaseException:
+            conn.close()
+            raise
+
+    def claim(self,attempt_id,owner_sha256,payload_sha256,*,binding_sha256):
+        values=tuple(_digest(x) for x in (attempt_id,owner_sha256,payload_sha256,binding_sha256))
+        conn=None
+        try:
+            conn=self._connect()
+            conn.execute('BEGIN IMMEDIATE')
+            self._validate(conn)
+            if conn.execute('SELECT COUNT(*) FROM pinned_attempts').fetchone()[0]>=10000:
+                raise ValueError('ledger capacity')
+            conn.execute('INSERT INTO pinned_attempts VALUES (?,?,?,?,\'attempted\')',values)
+            # Any exception/unknown commit refuses sending. A persisted claim is
+            # never retried, even when no bytes actually reached the recipient.
+            conn.commit()
+        except sqlite3.IntegrityError:
+            raise PinnedDispatchError('attempt_already_recorded') from None
+        except Exception:
+            raise PinnedDispatchError('attempt_ledger_unavailable') from None
+        finally:
+            if conn is not None:
+                conn.close()
+
+    def complete(self,attempt_id):
+        _digest(attempt_id)
+        conn=None
+        try:
+            conn=self._connect()
+            with conn:
+                conn.execute('BEGIN IMMEDIATE')
+                self._validate(conn)
+                cursor=conn.execute("UPDATE pinned_attempts SET state='completed' WHERE attempt_id=? AND state='attempted'",(attempt_id,))
+                if cursor.rowcount!=1:
+                    raise ValueError('missing attempt')
+        except Exception:
+            raise PinnedDispatchError('attempt_completion_uncertain') from None
+        finally:
+            if conn is not None:
+                conn.close()
+
+    def status(self,attempt_id):
+        _digest(attempt_id)
+        conn=None
+        try:
+            conn=self._connect()
+            conn.execute('BEGIN')
+            self._validate(conn)
+            row=conn.execute('SELECT state FROM pinned_attempts WHERE attempt_id=?',(attempt_id,)).fetchone()
+            return row[0] if row else None
+        except Exception:
+            raise PinnedDispatchError('attempt_ledger_unavailable') from None
+        finally:
+            if conn is not None:
+                conn.close()
+
+
+class _DurableContract(_OfflineContract):
+    def __init__(self,transport,ledger,owner_reader,freshness_reader,admit):
+        super().__init__(transport,owner_reader,freshness_reader,admit)
+        from hermes_cli.plugin_llm_credentials import _CredentialLoopbackTransport
+        if type(transport) not in (HttpsTransport,_LoopbackTransport,_CredentialLoopbackTransport) or type(ledger) is not AttemptLedger:
+            raise PinnedDispatchError('unsupported_transport_or_ledger')
+        self._recipient=transport.recipient
+        self._ledger=ledger
+
+    def _invoke(self,pending):
+        if not is_dataclass(pending.owner):
+            raise PinnedDispatchError('native_owner_required')
+        owner_bytes=json.dumps(asdict(pending.owner),sort_keys=True,separators=(',',':'),allow_nan=False).encode()
+        attempt_id=pending.prepared.attempt_id
+        binding=dict(owner_sha256=hashlib.sha256(owner_bytes).hexdigest(),
+                     recipient=asdict(pending.prepared.wire.recipient),model=pending.prepared.wire.model,
+                     payload_sha256=pending.prepared.wire.payload_sha256,freshness=pending.freshness)
+        binding_digest=hashlib.sha256(json.dumps(binding,sort_keys=True,separators=(',',':')).encode()).hexdigest()
+        self._ledger.claim(attempt_id,binding['owner_sha256'],pending.prepared.wire.payload_sha256,
+                           binding_sha256=binding_digest)
+        # Ledger locking/fsync can take time. Revalidate after its durable claim;
+        # failure retains a conservative attempted marker but sends no bytes.
+        if self._checked_callback(self._owner_reader)!=pending.owner:
+            raise PinnedDispatchError('owner_changed')
+        if self._checked_callback(self._admit,pending.owner,self._fresh)!=pending.freshness:
+            raise PinnedDispatchError('source_snapshot_changed')
+        result=self._transport(pending.prepared.wire)
+        if type(result) is not bytes or len(result)>pending.prepared.wire.max_response_bytes:
+            raise PinnedDispatchError('invalid_transport_response')
+        self._ledger.complete(attempt_id)
+        return result
+
+
+def _durable_contract(transport,ledger,*,freshness_reader,owner_reader=_native_owner,admit=_native_admission):
+    """Internal qualification seam only; no public route/credential selection."""
+    return _DurableContract(transport,ledger,owner_reader,freshness_reader,admit)
