+      <button type="button" disabled={!trusted||busy||!selection.provider||!selection.model||!selection.endpoint} onClick={()=>{if(valid())setReview({selection:{...selection},status,revoke:false})}}>Review enrollment</button>
+    </>}
+    {review&&<div><h4>{review.revoke?'Confirm revocation':'Review recipient before entering key'}</h4><pre>{JSON.stringify(review.selection,null,2)}</pre><p>Permission is limited to storing this dedicated credential binding. Future external processing requires separate approval of data, destination and costs.</p>
