+async def test_hosted_reload_and_profile_isolation(tmp_path, monkeypatch):
+    from gateway.session_memory_context import bind_memory_context
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    home = _home_with_plugins(tmp_path, monkeypatch, {'memoryprobe': PLUGIN})
+    manager = PluginManager()
+    manager.discover_and_load()
+    owner, connection, ref = await local_session(home, monkeypatch)
+    try:
+        old_handler = manager._plugin_rpc_methods['plugin.memoryprobe.read']
+        manager.discover_and_load(force=True)
+        with bind_memory_context(owner, connection.actor, ref, read_only=True):
+            with pytest.raises(Exception):
+                old_handler({})
+            handler = manager._plugin_rpc_methods['plugin.memoryprobe.read']
+            assert handler({})['owner']['canonical_session_id'] == ref.session_id
+            token = set_hermes_home_override(tmp_path / 'foreign-profile')
+            try:
+                with pytest.raises(Exception, match='profile_mismatch'):
+                    handler({})
+            finally:
+                reset_hermes_home_override(token)
+    finally:
+        manager.unload()
+        manager._plugin_host().shutdown()
+        await connection.close()
+        owner.db.close()
