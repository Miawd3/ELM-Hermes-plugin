new file mode 100644
index 00000000..8ce2d347
--- /dev/null
+++ b/gateway/model_credential_storage.py
@@ -0,0 +1,189 @@
+"""Dedicated encrypted model-route slots. No credential resolution or dispatch API."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import stat
+from urllib.parse import urlsplit
+
+from hermes_state_runtime import RuntimeStoreError
+
+
+def fail(reason='model_credentials_unavailable'):
+    raise RuntimeStoreError(reason)
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+
+
+def binding(owner):
+    return digest([owner.profile_id, owner.principal_id])
+
+
+def route(provider, model, endpoint):
+    if (type(provider) is not str or re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,63}', provider) is None
+            or type(model) is not str or re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}', model) is None):
+        fail('invalid_params')
+    if (type(endpoint) is not str or len(endpoint)>256 or any(ord(c)<33 or ord(c)>126 for c in endpoint)
+            or any(c in endpoint for c in ('@','?','#','%','\\'))):
+        fail('invalid_params')
+    try:
+        p=urlsplit(endpoint)
+        host=p.hostname
+        port=p.port
+        if (p.scheme!='https' or not host or not re.fullmatch(r'[a-zA-Z0-9.-]+',host)
+                or any(not x or len(x)>63 or x.startswith('-') or x.endswith('-') for x in host.split('.'))
+                or p.path!='/v1/chat/completions' or p.netloc.endswith(':')
+                or (port is not None and not 1<=port<=65535)):
+            fail('invalid_params')
+    except ValueError:
+        fail('invalid_params')
+    return dict(provider=provider,model=model,endpoint='https://'+host.lower()+(':'+str(port) if port else '')+p.path)
+
+
+def policy():
+    from hermes_cli.config import load_config_readonly
+    value=(load_config_readonly().get('vault') or {}).get('key_storage','file')
+    if value not in ('file','keychain'):
+        fail()
+    return value
+
+
+def _safe(path):
+    for item in [path,*path.parents]:
+        if item.is_symlink() or (hasattr(item,'is_junction') and item.is_junction()):
+            fail()
+
+
+def _write_new(path, value):
+    # Never overwrite a peer's key. Unknown creation outcomes must be inspected.
+    fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|getattr(os,'O_NOFOLLOW',0),0o600)
+    try:
+        with os.fdopen(fd,'wb') as stream:
+            stream.write(value)
+            stream.flush()
+            os.fsync(stream.fileno())
+        if os.name=='posix':
+            directory=os.open(path.parent,os.O_RDONLY|getattr(os,'O_DIRECTORY',0))
+            try:
+                os.fsync(directory)
+            finally:
+                os.close(directory)
+    except BaseException:
+        # Do not blindly remove a key that may already have been made durable.
+        raise
+
+
+def _key(owner, mode, create):
+    from cryptography.fernet import Fernet
+    root=Path(owner.profile_id)/'model-route-keys'
+    path=root/(binding(owner)+'.key' if mode=='file' else binding(owner)+'.ref')
+    _safe(path)
+    if root.exists() and not root.is_dir():
+        fail()
+    if path.exists() and not stat.S_ISREG(path.stat().st_mode):
+        fail()
+    for existing in (root, path):
+        if existing.exists() and os.name == 'posix' and existing.stat().st_mode & 0o077:
+            fail()
+    alternate=root/(binding(owner)+('.ref' if mode=='file' else '.key'))
+    if alternate.exists():
+        fail()  # No implicit key-storage migration or weaker fallback.
+    if mode=='file':
+        if path.exists():
+            if path.stat().st_size>128:
+                fail()
+            return path.read_bytes()
+        if not create:
+            fail()
+        root.mkdir(mode=0o700,parents=True,exist_ok=True)
+        value=Fernet.generate_key()
+        _write_new(path,value)
+        return value
+    from agent import vault_keychain as kc
+    if path.exists():
+        if path.stat().st_size>2048:
+            fail()
+        ref=json.loads(path.read_text(),object_pairs_hook=_pairs)
+        if (type(ref) is not dict or set(ref)!={'service','account','binding'}
+                or ref['service']!='Hermes model-route encryption key'
+                or ref['binding']!=binding(owner) or type(ref['account']) is not str or re.fullmatch(r'model-route-[0-9a-f]{32}',ref['account']) is None):
+            fail()
+        value=kc.load_key(ref)
+        if value is None:
+            fail()
+        return value
+    if not create:
+        fail()
+    root.mkdir(mode=0o700,parents=True,exist_ok=True)
+    ref=dict(service='Hermes model-route encryption key',account='model-route-'+secrets.token_hex(16),binding=binding(owner))
+    value=Fernet.generate_key()
+    kc.store_key(ref,value)  # Configured keychain unavailable: refuse, never file fallback.
+    _write_new(path,json.dumps(ref).encode())
+    return value
+
+
+def _pairs(items):
+    result={}
+    for k,v in items:
+        if k in result:
+            fail()
+        result[k]=v
+    return result
+
+
+def validate(data, owner):
+    if (type(data) is not dict or set(data)!={'schema','binding','revision','slots'} or type(data['schema']) is not int or data['schema']!=1
+            or data['binding']!=binding(owner) or type(data['revision']) is not int
+            or not 0<=data['revision']<2**53 or type(data['slots']) is not dict
+            or not set(data['slots'])<={'search','organizer'}):
+        fail()
+    for role,row in data['slots'].items():
+        if (type(row) is not dict or set(row)!={'provider','model','endpoint','version','active','secret'}
+                or type(row['version']) is not int or not 1<=row['version']<=data['revision']
+                or type(row['active']) is not bool):
+            fail()
+        if route(row['provider'],row['model'],row['endpoint'])!={k:row[k] for k in ('provider','model','endpoint')}:
+            fail()
+        if row['active']:
+            validate_secret(row['secret'])
+        elif row['secret'] is not None:
+            fail()
+
+
+def validate_secret(secret):
+    if type(secret) is not str or not 1<=len(secret)<=4096 or any(ord(c)<33 or ord(c)>126 for c in secret):
+        fail('invalid_params')
+
+
+def dbkey(owner):
+    return 'gateway.model_credentials.v1:'+binding(owner)
+
+
+def load(conn,owner,mode):
+    from cryptography.fernet import Fernet
+    row=conn.execute('SELECT value FROM state_meta WHERE key=?',(dbkey(owner),)).fetchone()
+    if row is None:
+        return dict(schema=1,binding=binding(owner),revision=0,slots={})
+    if type(row[0]) is not str or len(row[0])>32768:
+        fail()
+    raw=Fernet(_key(owner,mode,False)).decrypt(row[0].encode('ascii'))
+    if len(raw)>16384:
+        fail()
+    data=json.loads(raw,object_pairs_hook=_pairs)
+    validate(data,owner)
+    return data
+
+
+def save(conn,owner,mode,data,*,first):
+    from cryptography.fernet import Fernet
+    validate(data,owner)
+    raw=json.dumps(data,sort_keys=True,separators=(',',':')).encode()
+    if len(raw)>16384:
+        fail()
+    encrypted=Fernet(_key(owner,mode,first)).encrypt(raw).decode('ascii')
+    conn.execute('INSERT INTO state_meta(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value',
+                 (dbkey(owner),encrypted))
