+def is_plugin_managed_path(path: Path) -> bool:
+    """Protect resolved plugin trees from disk-skill aliases, without discovery.
+
+    Independent copies outside these trees remain ordinary disk skills. This is
+    an in-process/current-install guard, not a hostile-filesystem sandbox.
+    """
+    from hermes_constants import get_hermes_home, hermes_home_key
+    from hermes_cli.plugins import get_plugin_manager
+    try:
+        target = Path(path).resolve()
+        manager = get_plugin_manager()
+        if manager.scope_key != hermes_home_key():
+            return True
+        with manager._discovery_lock:
+            roots = [get_hermes_home() / 'plugins']
+            roots.extend(Path(item.manifest.path) for item in manager._plugins.values()
+                         if item.manifest.path)
+            roots.extend(Path(entry['path']).parent for entry in manager._plugin_skills.values())
+            return any(target.is_relative_to(root.resolve()) or root.resolve().is_relative_to(target)
+                       for root in roots)
+    except (OSError, ValueError, TypeError):
+        return True
