+/** Metadata-only grouping. Native rows, owners and navigation remain core-owned. */
+export const CHAT_FOLDERS_AREA = 'sidebar.chatFolders'
+export interface ChatFolderOwner { connectionId: string; profile: string; storedSessionId: string; runtimeSessionId: string; epoch: number }
+export interface ChatFolderSnapshot {
+  owner: ChatFolderOwner
+  context_key: string
+  revision: number
+  folders: Array<{ id: string; label: string }>
+  members: Array<{ session_id: string; aliases: string[]; folder_id: string }>
+}
+export function sameChatFolderOwner(a: ChatFolderOwner | null, b: ChatFolderOwner | null): boolean {
+  return !!a && !!b && a.connectionId === b.connectionId && a.profile === b.profile && a.storedSessionId === b.storedSessionId && a.runtimeSessionId === b.runtimeSessionId && a.epoch === b.epoch
+}
+export function validChatFolderSnapshot(value: unknown): value is ChatFolderSnapshot {
+  const v = value as ChatFolderSnapshot
+  const id = (x: unknown) => typeof x === 'string' && x.length > 0 && x.length <= 512
+  if (!v || !v.owner || ![v.owner.connectionId,v.owner.profile,v.owner.storedSessionId,v.owner.runtimeSessionId,v.context_key].every(id) || !Number.isSafeInteger(v.owner.epoch) || !Number.isSafeInteger(v.revision) || v.revision < 0 || !Array.isArray(v.folders) || v.folders.length > 32 || !Array.isArray(v.members) || v.members.length > 256) return false
+  const folders = new Set<string>()
+  for (const f of v.folders) { if (!f || !id(f.id) || folders.has(f.id) || typeof f.label !== 'string' || !f.label.trim() || [...f.label].length > 80 || /[\u0000-\u001f\u007f\u202a-\u202e\u2066-\u2069]/u.test(f.label)) return false; folders.add(f.id) }
+  const members = new Set<string>()
+  for (const m of v.members) { if (!m || !id(m.session_id) || members.has(m.session_id) || !folders.has(m.folder_id) || !Array.isArray(m.aliases) || m.aliases.length > 256 || !m.aliases.every(id)) return false; members.add(m.session_id) }
+  return true
+}
+/** Only native visible rows with an exact known owner can gain a grouping. */
+export function folderRows<T extends { id: string }>(snapshot: ChatFolderSnapshot, folderId: string, rows: readonly T[], ownerOf: (row: T) => {connectionId:string;profile:string}|null, aliasesOf: (row:T)=>string[]): T[] {
+  const members = snapshot.members.filter(m=>m.folder_id===folderId)
+  return rows.filter(row=>{ const owner=ownerOf(row); if (!owner || owner.connectionId!==snapshot.owner.connectionId || owner.profile!==snapshot.owner.profile) return false; const aliases=aliasesOf(row); return members.some(m=>aliases.some(id=>id===m.session_id || m.aliases.includes(id))) })
+}
+
+/** Revalidate a click against current native rows, not the rendered row object. */
+export function currentFolderRow<T extends {id:string}>(snapshot:ChatFolderSnapshot,folderId:string,rendered:readonly T[],current:readonly T[],id:string,ownerOf:(row:T)=>{connectionId:string;profile:string}|null,aliasesOf:(row:T)=>string[]):T|null {
+  if (!rendered.some(row=>aliasesOf(row).includes(id))) return null
+  const matches=folderRows(snapshot,folderId,current,ownerOf,aliasesOf).filter(row=>aliasesOf(row).includes(id))
+  return matches.length===1?matches[0]:null
+}
