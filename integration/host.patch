+    {error&&<p role="alert">{error}</p>}
+    {status&&<><p>Storage: {status.key_storage}. Scope: this authenticated principal in the current profile, not only this chat. Revoked slot metadata remains stored.</p>
+      {status.slots.map(s=><div key={s.role}><pre>{JSON.stringify({role:s.role,provider:s.provider,model:s.model,endpoint:s.endpoint,version:s.version,active:s.active},null,2)}</pre><button type="button" disabled={!trusted||busy||!s.active} onClick={()=>{if(valid())setReview({selection:{role:s.role,provider:s.provider,model:s.model,endpoint:s.endpoint},status,revoke:true})}}>Review revocation of {s.role}</button></div>)}
