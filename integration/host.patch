+++ b/hermes_cli/plugins_update_syntax.py
@@ -0,0 +1,41 @@
+"""No-execution candidate syntax checks using only already-selected native tools."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+from hermes_cli.plugins_update_policy_store import failure
+
+
+def node_binary():
+    from pm.install import installed_package
+    installed = installed_package('node')
+    binary = installed.binary if installed is not None else None
+    if binary is None or not binary.is_file() or binary.is_symlink():
+        raise failure('update_policy_node_validation_unavailable')
+    return binary
+
+
+def check_javascript(data, *, commonjs=False):
+    """Node --check parses stdin, never imports/resolves/runs candidate modules.
+
+    No inherited NODE_OPTIONS/NODE_PATH or dynamic loader preloads. PM lookup is
+    read-only: absent selected Node refuses; it never installs a parser.
+    """
+    binary = node_binary()
+    if len(data) > 2 * 1024 * 1024:
+        raise failure('update_policy_validation_capacity')
+    env = {'PATH': os.defpath}
+    if os.name == 'nt':
+        for key in ('SystemRoot', 'WINDIR'):
+            if key in os.environ:
+                env[key] = os.environ[key]
+    with tempfile.TemporaryDirectory(prefix='plugin-syntax-') as cwd:
+        try:
+            result = subprocess.run([str(binary), '--input-type=' + ('commonjs' if commonjs else 'module'), '--check'],
+                                    input=data, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                                    cwd=cwd, env=env, timeout=10, check=False)
+        except (OSError, subprocess.TimeoutExpired) as exc:
+            raise failure('update_policy_javascript_validation_failed') from exc
+    if result.returncode != 0:
+        raise failure('update_policy_javascript_syntax_invalid')
