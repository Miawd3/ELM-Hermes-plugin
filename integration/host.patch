@@ -0,0 +1,40 @@
+import type { Contribution } from '@/contrib/types'
+
+/** Pure presentation policy; no identity, navigation callback or backend access. */
+export const TRANSCRIPT_IMPORTANCE_AREA = 'transcript.importance'
+export const TRANSCRIPT_IMPORTANCE_LIMITS = { textChars: 8192, labelChars: 48, policies: 8 } as const
+
+export interface TranscriptImportanceInput {
+  readonly role: 'assistant' | 'user'
+  readonly textPrefix: string
+}
+
+export interface TranscriptImportanceContribution {
+  classify: (message: Readonly<TranscriptImportanceInput>) => { label: string } | null | undefined
+}
+
+/** First valid bounded label wins. Plugin JS remains trusted, not sandboxed. */
+export function transcriptImportance(contributions: readonly Contribution[], role: string, text: string): string | undefined {
+  if ((role !== 'user' && role !== 'assistant') || !contributions.length) return undefined
+  const bounded = text.slice(0, TRANSCRIPT_IMPORTANCE_LIMITS.textChars)
+  const textPrefix = text.length > bounded.length ? bounded.slice(0, Math.max(0, bounded.lastIndexOf('\n'))) : bounded
+  const input = Object.freeze({ role, textPrefix })
+  for (const contribution of contributions.slice(0, TRANSCRIPT_IMPORTANCE_LIMITS.policies)) {
+    try {
+      const data = contribution.data as TranscriptImportanceContribution | undefined
+      if (typeof data?.classify !== 'function') continue
+      const result = data.classify(input)
+      if (result && typeof (result as unknown as { then?: unknown }).then === 'function') {
+        void Promise.resolve(result).catch(() => undefined)
+        continue
+      }
+      if (!result || typeof result !== 'object' || Object.keys(result).length !== 1 || typeof result.label !== 'string') continue
+      const label = result.label.trim()
+      if (!label || label.length > TRANSCRIPT_IMPORTANCE_LIMITS.labelChars || /[\p{Cc}\p{Cf}\p{Cs}]/u.test(label)) continue
+      return label
+    } catch {
+      // A faulty visual policy must not break the transcript.
+    }
+  }
+  return undefined
+}
