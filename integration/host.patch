+    folder = tmp_path / 'plugins' / 'owner-demo'
+    folder.mkdir(parents=True)
+    (folder / 'plugin.yaml').write_text(yaml.safe_dump({'name': 'owner-demo', 'version': '0.1.0'}))
+    (folder / '__init__.py').write_text('''
+from dataclasses import asdict
+from hermes_cli.plugin_memory import memory_owner
+
+def inspect(params, *, session_id, **kw):
+    return asdict(memory_owner(alias=params.get('alias')))
+
+def register(ctx):
+    ctx.register_rpc('owner', inspect, memory_scope='local_read')
+''')
