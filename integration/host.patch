+"""Canonical ownership is a read-only proof, not history adoption or cwd grouping."""
+from dataclasses import FrozenInstanceError, replace
+import json
+
+import pytest
+
+from gateway.session_memory_owner import resolve_memory_owner
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway.test_local_authority_transitions import local_session
+
+
+def _dump(db):
+    with db._read_ctx() as conn:
+        return tuple(conn.iterdump())
+
+
+@pytest.mark.asyncio
+async def test_cold_owner_is_read_only_and_has_no_inferred_project(tmp_path, monkeypatch):
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    try:
+        before = _dump(owner.db)
+        live = owner.sessions.pop(ref.session_id)
+        result = resolve_memory_owner(owner, connection.actor, ref)
+        assert result.canonical_session_id == ref.session_id
+        assert result.aliases == (ref.session_id,)
+        assert result.project_id is None
+        assert _dump(owner.db) == before
+        assert ref.session_id not in owner.sessions
+        with pytest.raises(FrozenInstanceError):
+            result.project_id = 'cwd-project'
+        owner.sessions[ref.session_id] = live
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('violation', ['principal', 'profile', 'capability', 'alias', 'retired'])
+async def test_trusted_scope_and_alias_checks(tmp_path, monkeypatch, violation):
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    actor, alias = connection.actor, None
+    try:
+        if violation == 'principal':
+            actor = replace(actor, subject='foreign-user')
+        elif violation == 'profile':
+            actor = replace(actor, profile_id='foreign-profile')
+        elif violation == 'capability':
+            actor = replace(actor, capabilities=frozenset())
+        elif violation == 'alias':
+            alias = 'unrelated-session'
+        else:
+            owner.retired = True
+        before = _dump(owner.db)
+        with pytest.raises(RuntimeStoreError):
+            resolve_memory_owner(owner, actor, ref, alias)
+        assert _dump(owner.db) == before
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+async def test_reset_alias_validated_and_foreign_row_rejected(tmp_path, monkeypatch):
+    from gateway.session_mutations import mutate_session
+    from gateway.session_contract import SessionRef
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    try:
+        handle = owner._handle(ref)
+        await mutate_session(owner, connection.actor, ref, dict(session_id=ref.session_id,
+            request_id='reset', operation='reset', payload={}, expected_revision=handle.revision,
+            expected_generation=handle.execution_generation))
+        result = resolve_memory_owner(owner, connection.actor, ref)
+        child = result.physical_session_id
+        assert child != ref.session_id
+        alias = resolve_memory_owner(owner, connection.actor, SessionRef(ref.profile_id, child), child)
+        assert alias == result
+        owner.db._execute_write(lambda conn: conn.execute('UPDATE sessions SET user_id=? WHERE id=?', ('foreign', child)))
+        with pytest.raises(RuntimeStoreError):
+            resolve_memory_owner(owner, connection.actor, ref)
+    finally:
+        await connection.close()
+        owner.db.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('corruption', ['duplicate', 'foreign_member', 'bad_json', 'missing_receipt'])
+async def test_bad_lineage_never_creates_an_owner(tmp_path, monkeypatch, corruption):
+    from hermes_state_local import POLICY_PREFIX
+    owner, connection, ref = await local_session(tmp_path, monkeypatch)
+    try:
+        def corrupt(conn):
+            key = POLICY_PREFIX + ref.session_id
+            raw = conn.execute('SELECT value FROM state_meta WHERE key=?', (key,)).fetchone()[0]
+            receipt = json.loads(raw)
+            if corruption == 'missing_receipt':
+                conn.execute('DELETE FROM state_meta WHERE key=?', (key,))
+                return
+            if corruption == 'duplicate':
+                receipt['lineage'] = [ref.session_id, ref.session_id]
+            elif corruption == 'foreign_member':
+                receipt['lineage'] = [ref.session_id, 'foreign']
+            value = '{bad' if corruption == 'bad_json' else json.dumps(receipt)
+            conn.execute('UPDATE state_meta SET value=? WHERE key=?', (value, key))
+        owner.db._execute_write(corrupt)
+        before = _dump(owner.db)
+        with pytest.raises(RuntimeStoreError):
+            resolve_memory_owner(owner, connection.actor, ref)
+        assert _dump(owner.db) == before
+    finally:
