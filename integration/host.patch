new file mode 100644
index 00000000..fd2f3f4b
--- /dev/null
+++ b/hermes_cli/web_plugin_skills.py
@@ -0,0 +1,159 @@
+"""Read-only dashboard projection of current, profile-owned plugin skills.
+
+Never discovers/loads plugins, preprocesses a skill, or serves supporting files.
+Existing dashboard authentication/profile scope must enclose every call.
+"""
+from contextlib import contextmanager
+from pathlib import Path
+import re
+import hashlib
+import json
+import stat
+
+from fastapi import HTTPException
+
+_NAME = re.compile(r'[A-Za-z0-9_.-]+:[A-Za-z0-9_-]+\Z')
+_TOKEN = re.compile(r'[0-9a-f]{32}\Z')
+_MAX_BODY = 65536
+
+
+def deny_plugin_mutation(name):
+    if isinstance(name, str) and ':' in name:
+        raise HTTPException(403, 'Plugin-qualified skill names are reserved and read-only')
+
+
+@contextmanager
+def _registry():
+    from hermes_cli.plugins import get_plugin_manager
+    from hermes_constants import hermes_home_key
+    manager = get_plugin_manager()
+    if manager.scope_key != hermes_home_key():
+        raise HTTPException(409, 'Plugin skill profile is unavailable')
+    with manager._discovery_lock:
+        yield manager
+
+
+def _entry(manager, name):
+    from hermes_cli.plugins_discovery import _get_disabled_plugins, _get_enabled_plugins, gate_manifest
+    if type(name) is not str or len(name) > 256 or _NAME.fullmatch(name) is None:
+        raise HTTPException(404, 'Plugin skill is unavailable')
+    entry = manager._plugin_skills.get(name)
+    if not entry:
+        raise HTTPException(404, 'Plugin skill is unavailable')
+    loaded = manager._plugins.get(entry.get('plugin_key'))
+    disabled = _get_disabled_plugins()
+    if (loaded is None or not loaded.enabled or loaded.error
+            or {entry.get('plugin_key'), entry.get('plugin_name')} & disabled):
+        raise HTTPException(404, 'Plugin skill is unavailable')
+    if gate_manifest(loaded.manifest, disabled, _get_enabled_plugins()).action == 'placeholder':
+        raise HTTPException(404, 'Plugin skill is unavailable')
+    token = entry.get('registration_id')
+    if type(token) is not str or _TOKEN.fullmatch(token) is None:
+        raise HTTPException(404, 'Plugin skill is unavailable')
+    return entry, loaded
+
+
+def _path(entry, loaded):
+    try:
+        root = Path(loaded.manifest.path)
+        path = Path(entry['path'])
+        relative = path.relative_to(root)
+        current = root
+        for part in (None, *relative.parts):
+            if part is not None:
+                current = current / part
+            if current.is_symlink() or getattr(current, 'is_junction', lambda: False)():
+                raise ValueError('link')
+        if (path.name != 'SKILL.md' or not stat.S_ISREG(path.stat().st_mode)
+                or not path.resolve().is_relative_to(root.resolve())):
+            raise ValueError('path')
+    except (OSError, ValueError, TypeError):
+        raise HTTPException(404, 'Plugin skill is unavailable') from None
+    return path
+
+
+def _revision(entry, path):
+    try:
+        info = path.stat()
+    except OSError:
+        raise HTTPException(409, 'Plugin skill changed; refresh the catalog') from None
+    material = [entry['registration_id'], info.st_dev, info.st_ino, info.st_size,
+                info.st_mtime_ns, info.st_ctime_ns]
+    return hashlib.sha256(json.dumps(material).encode()).hexdigest()[:32]
+
+
+def _metadata(name, entry, disabled, path):
+    description = entry.get('description', '')
+    owner = entry.get('plugin_name')
+    if (type(description) is not str or len(description.encode('utf-8')) > 4096
+            or type(owner) is not str or len(owner) > 128):
+        raise HTTPException(409, 'Plugin skill metadata exceeds its bounds')
+    return dict(name=name, description=description, category='plugin',
+                enabled=name not in disabled, usage=0, locked=False,
+                provenance='plugin', read_only=True, plugin_owner=owner,
+                registration_id=_revision(entry, path))
+
+
+def plugin_skill_rows(disabled):
+    with _registry() as manager:
+        names = sorted(manager._plugin_skills)
+        if len(names) > 256:
+            raise HTTPException(409, 'Plugin skill catalog exceeds its bounds')
+        rows = []
+        for name in names:
+            try:
+                entry, loaded = _entry(manager, name)
+                path = _path(entry, loaded)
+            except HTTPException as exc:
+                if exc.status_code == 404:
+                    continue
+                raise
+            rows.append(_metadata(name, entry, disabled, path))
+        return rows
+
+
+def plugin_skill_content(name, expected_registration=None):
+    with _registry() as manager:
+        entry, loaded = _entry(manager, name)
+        path = _path(entry, loaded)
+        revision = _revision(entry, path)
+        if expected_registration != revision:
+            raise HTTPException(409, 'Plugin skill registration changed; refresh the catalog')
+        try:
+            if path.stat().st_size > _MAX_BODY:
+                raise HTTPException(413, 'Plugin skill exceeds the raw inspection limit')
+            with path.open('rb') as stream:
+                raw = stream.read(_MAX_BODY + 1)
+            if len(raw) > _MAX_BODY:
+                raise HTTPException(413, 'Plugin skill exceeds the raw inspection limit')
+            content = raw.decode('utf-8-sig')
+        except (OSError, UnicodeError):
+            raise HTTPException(409, 'Plugin skill content is unavailable') from None
+        _path(entry, loaded)
+        current, _ = _entry(manager, name)
+        if current is not entry or _revision(entry, path) != revision:
+            raise HTTPException(409, 'Plugin skill changed during reading; refresh the catalog')
+        return dict(name=name, content=content, path='', provenance='plugin', read_only=True,
+                    plugin_owner=entry['plugin_name'], registration_id=revision)
+
+
+@contextmanager
+def plugin_skill_toggle_guard(name, expected_registration=None):
+    with _registry() as manager:
+        entry, loaded = _entry(manager, name)
+        path = _path(entry, loaded)
+        if expected_registration != _revision(entry, path):
+            raise HTTPException(409, 'Plugin skill registration changed; refresh the catalog')
+        yield
+
+
+def filter_disk_skill_rows(rows):
+    """Do not advertise a plugin file's external alias as an editable disk skill."""
+    from tools.skills_tool import _skill_catalog
+    from tools.skill_manager_guards import is_plugin_managed_path
+    protected = set()
+    for item in _skill_catalog(skip_disabled=True):
+        path = item['path']
+        if is_plugin_managed_path(path) or is_plugin_managed_path(path.parent):
+            protected.add(item.get('load_name'))
+    return [row for row in rows if ':' not in row.get('name', '') and row.get('name') not in protected]
