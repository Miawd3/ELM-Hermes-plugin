+CONTEXT_RRF_K = 60
+
+
+def fuse_search_lanes(strict: list[dict], broad: list[dict], limit: int) -> list[dict]:
+    """Bounded, equal-weight RRF with exact scores and stable public-key ties.
+
+    Original row scores remain BM25 values. Fusion changes candidate order only;
+    it never changes scope predicates, body text, authority, or source identity.
+    """
+    strict_ranks = {r["section_key"]: i + 1 for i, r in enumerate(strict)}
+    broad_ranks = {r["section_key"]: i + 1 for i, r in enumerate(broad)}
+    rows = {r["section_key"]: r for r in broad}
+    rows.update({r["section_key"]: r for r in strict})
+    missing = max(len(strict), len(broad)) + 1
+
+    def ordering(key):
+        sr = strict_ranks.get(key, missing)
+        br = broad_ranks.get(key, missing)
+        score = (Fraction(1, CONTEXT_RRF_K + sr) if key in strict_ranks else 0)
+        score += Fraction(1, CONTEXT_RRF_K + br) if key in broad_ranks else 0
+        return -score, min(sr, br), sr, br, key
+
+    return [rows[key] for key in sorted(rows, key=ordering)[:limit]]
+
+
+def search_context_candidates(
+    root: Path, query: str, args, *, policy_moment: str,
+) -> tuple[list[dict], dict]:
+    """Run bounded lexical lanes on separate read-only connections.
+
+    The caller must bracket this and supplemental selection with an index
+    data_version check. Each worker owns and closes its connection. Any lane
+    failure refuses the entire read rather than silently changing admission.
+    """
+    def lane(broad):
+        con = connect_readonly(root, lock_timeout=args.lock_timeout)
+        try:
+            return search_sections(
+                con, query, args, limit=args.limit, broad=broad,
+                policy_moment=policy_moment,
+            )
+        finally:
+            con.close()
+
+    # Avoid redundant work for a single searchable term, including punctuation.
+    if safe_fts_query(query, False) == safe_fts_query(query, True):
+        strict = lane(False)
+        broad = strict
+        lane_count = 1
+    else:
+        with ThreadPoolExecutor(max_workers=2, thread_name_prefix="elm-lexical") as pool:
+            strict_future = pool.submit(lane, False)
+            broad_future = pool.submit(lane, True)
+            strict, broad = strict_future.result(), broad_future.result()
+        lane_count = 2
+    results = fuse_search_lanes(strict, broad, args.limit)
+    return results, {
+        "policy": "strict_broad_rrf",
+        "rrf_k": CONTEXT_RRF_K,
+        "lane_count": lane_count,
+        "per_lane_limit": args.limit,
+        "final_limit": args.limit,
+        "strict_count": len(strict),
+        "broad_count": len(broad),
+        "candidate_count": len(results),
+        # Retain the old field meaning, even though broad admission now always
+        # participates. Use policy/counts to distinguish union from fallback.
+        "fallback_used": not strict and bool(broad),
+    }
 
